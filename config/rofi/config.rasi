/* ============================================================
   rofi — app launcher & menus
   Theme matches waybar/hyprlock (Catppuccin Mocha colors)
   Docs: man rofi-theme
   ============================================================ */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Flat-Remix-Blue-Dark";
    display-drun: "󰀻 Apps";
    display-run: " Run";
    display-window: "󰖯 Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    /* fallback colors — overridden by wallust below */
    bg:       #1e1e2e;
    bg-alt:   #313244;
    fg:       #cdd6f4;
    fg-dim:   #a6adc8;
    accent:   #89b4fa;
    urgent:   #f38ba8;

    background-color: transparent;
    text-color: @fg;
}

/* wallpaper-matched colors (generated by wallust) */
@import "/home/santapong/.config/rofi/colors.rasi"

window {
    width: 640px;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    background-color: @bg;
    padding: 16px;
}

mainbox {
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    spacing: 8px;
    padding: 10px 14px;
    background-color: @bg-alt;
    border: 0 0 2px 0;
    border-color: @accent;
    border-radius: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    text-color: @fg;
    cursor-color: @accent;
    cursor-width: 2px;
    placeholder: "Type to search…";
    placeholder-color: rgba(255, 255, 255, 0.35);
}

message, textbox {
    background-color: @bg-alt;
    text-color: @fg;
    padding: 8px 12px;
    border-radius: 8px;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: true;
    spacing: 4px;
}

scrollbar {
    handle-color: @accent;
    handle-width: 6px;
    background-color: @bg-alt;
    border-radius: 8px;
}

element {
    padding: 8px 12px;
    border-radius: 8px;
    spacing: 10px;
    text-color: @fg;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @accent;
    text-color: @bg;
    border: 0 0 0 4px;
    border-color: @fg;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
    highlight: bold underline;
}
