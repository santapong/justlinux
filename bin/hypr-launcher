# ---------------- widgets ----------------
class Tile(Vertical):
    """One grid cell: image (or big glyph) + name (+ optional sub-line).
    Click = select, double-click = open."""

    class Chosen(Message):
        def __init__(self, tile):
            self.tile = tile
            super().__init__()

    class Activated(Message):
        def __init__(self, tile):
            self.tile = tile
            super().__init__()

    def __init__(self, obj, idx, image_path=None):
        super().__init__(id=f"tile-{idx}", classes="tile")
        self.obj = obj
        self.idx = idx
        self._image_path = image_path

    def compose(self) -> ComposeResult:
        if self._image_path and Image is not None:
            yield Image(self._image_path, classes="tile-img")
        else:
            yield Static(self.obj.get("glyph") or GLYPHS.get(self.obj["kind"], "󰘔"),
                         classes="tile-glyph")
        star = "★ " if self.obj.get("fav") else ""
        yield Label(f"{star}{self.obj['label']}"[:36], classes="tile-name")
        if self.obj.get("sub"):
            yield Label(self.obj["sub"][:36], classes="tile-sub")

    class Starred(Message):
        def __init__(self, tile):
            self.tile = tile
            super().__init__()

    def on_click(self, event):
        event.stop()
        if getattr(event, "button", 1) == 3:      # right-click = toggle favorite
            self.post_message(self.Starred(self))
        elif event.chain >= 2:
            self.post_message(self.Activated(self))
        else:
            self.post_message(self.Chosen(self))


class SectionHeader(Static):
    """Clickable category row: '▸ Internet 12' — click to expand/collapse."""

    class Toggled(Message):
        def __init__(self, title):
            self.title = title
            super().__init__()

    def __init__(self, title, count, expanded, idx):
        arrow = "▾" if expanded else "▸"
        super().__init__(
            f"{arrow} {title}  [{C['subtext']}]{count} apps — click to "
            f"{'hide' if expanded else 'show'}[/]",
            classes="section", id=f"sec-{idx}")
        self.title_key = title

    def on_click(self, event):
        event.stop()
        self.post_message(self.Toggled(self.title_key))


class FilterInput(Input):
    """Left/right navigate the grid while the filter is empty; once there is
    text they edit it as usual."""

    async def _on_key(self, event):
        if event.key in ("left", "right") and not self.value:
            event.stop()
            event.prevent_default()
            self.app.action_move(1 if event.key == "right" else -1)
            return
        await super()._on_key(event)


class Item(ListItem):
    def __init__(self, obj):
        detail = f"[{C['subtext']}]{obj['detail']}[/]" if obj.get("detail") else ""
        super().__init__(Horizontal(
            Label(f"{obj['icon']}  {obj['label']}", classes="item-label"),
            Label(detail, classes="item-detail")))
        self.obj = obj


class HyprLauncher(App):
    ENABLE_COMMAND_PALETTE = False
    BINDINGS = [
        Binding("escape", "cancel", "Cancel"),
        Binding("enter", "activate", "Open", show=False),
        Binding("down", "move_row(1)", "Down", show=False),
        Binding("up", "move_row(-1)", "Up", show=False),
        Binding("left", "move(-1)", "Left", show=False),
        Binding("right", "move(1)", "Right", show=False),
    ]
    CSS = f"""
    Screen {{ background: ansi_default; color: {C['text']}; }}
    #hdr {{ height: 1; padding: 0 2; background: transparent; margin-top: 1; }}
    Input {{
        margin: 1 2 0 2; background: transparent;
        border: round {C['surface']}; color: {C['text']};
    }}
    Input:focus {{ border: round {C['accent']}; }}
    Input .input--placeholder {{ color: {C['subtext']}; }}

    #scroll {{ margin: 1 1 0 2; background: transparent;
               scrollbar-size-vertical: 1;
               scrollbar-color: {C['surface']}; scrollbar-background: transparent; }}
    .tilegrid {{ layout: grid; grid-size: {COLS}; grid-gutter: 0 1;
             height: auto; background: transparent; }}
    #gridwrap {{ height: auto; background: transparent; }}
    .section {{ height: 1; padding: 0 1; margin: 1 0 0 0;
                color: {C['accent']}; text-style: bold; }}
    .section:hover {{ background: {C['surface']} 40%; }}
    Screen.mode-apps .tile-img {{ height: 3; }}
    .tile {{ height: auto; background: transparent;
             border: round transparent; align: center top; }}
    .tile.selected {{ border: round {C['accent']}; background: {C['surface']} 35%; }}
    .tile-img {{ height: 6; width: 100%; }}
    .tile-glyph {{ height: 6; width: 100%; content-align: center middle;
                   text-align: center; color: {C['accent']}; }}
    .tile-name {{ height: 1; width: 100%; text-align: center;
                  color: {C['text']}; }}
    .tile-sub {{ height: 1; width: 100%; text-align: center;
                 color: {C['subtext']}; }}
    Screen.mode-menu .tile-glyph {{ height: 2; }}

    ListView {{ margin: 1 2; background: transparent;
                scrollbar-size-vertical: 1;
                scrollbar-color: {C['surface']}; scrollbar-background: transparent; }}
    ListItem {{ background: transparent; padding: 0 1;
                border-left: thick transparent; height: 1; }}
    ListItem Horizontal {{ height: 1; background: transparent; }}
    ListItem Label {{ height: 1; }}
    ListItem.-highlight {{ background: {C['surface']};
                           border-left: thick {C['accent']}; }}
    .item-label {{ width: 1fr; }}
    .item-detail {{ width: auto; }}

    .hint {{ color: {C['subtext']}; padding: 0 3; height: 1; }}
    #wp-actions {{ height: 3; padding: 0 2; }}
    Button {{ background: transparent; border: round {C['surface']};
              color: {C['text']}; margin-right: 1; }}
    Button:hover, Button:focus {{ border: round {C['accent']}; color: {C['accent']};
                                  background: transparent; }}
    Footer {{ background: transparent; }}
    FooterKey {{ background: transparent; color: {C['subtext']}; }}
    FooterKey > .footer-key--key {{ color: {C['accent']}; background: transparent; }}
    FooterKey > .footer-key--description {{ color: {C['subtext']};
                                            background: transparent; }}
    """

    def __init__(self, mode):
        super().__init__(ansi_color=True)
        self.mode = mode
        self.entries = []
        self.tiles = []
        self.sel = -1
        self.cols = COLS
        self.state = load_state()
        # favorites & recent start open; other categories start collapsed
        self.expanded = {FAV_TITLE, REC_TITLE}
        self._focus_section = None
        self._filter_timer = None
        # wallpaper state
        self.wp_target = None
        self.wp_orig = current_wallpapers()
        self.wp_previewed = False
        self.cwd = wallpaper_root()

    # ---------- layout ----------
    def compose(self) -> ComposeResult:
        titles = {"apps": ("󰀻", "Apps — double-click or Enter to open"),
                  "windows": ("󰖯", "Windows — click or type to filter"),
                  "wallpaper": ("󰸉", "Wallpaper"),
                  "menu": ("󰍜", "Tools — double-click or Enter to run")}
        icon, title = titles[self.mode]
        yield Static(f"[bold {C['accent']}]{icon}  {title}[/]", id="hdr")
        if self.mode in ("apps", "menu"):
            yield FilterInput(placeholder="filter…  (Enter open · right-click a box = ★ favorite · Esc close)",
                              id="filter")
            with VerticalScroll(id="scroll") as vs:
                vs.can_focus = False  # keep focus on the filter; arrows drive the grid
                yield Vertical(id="gridwrap")
        elif self.mode == "windows":
            yield FilterInput(placeholder="filter…  (↑↓ move · Enter focus · Esc close)",
                              id="filter")
            yield ListView(id="results")
        else:
            yield Static("", id="wp-where", classes="hint")
            with VerticalScroll(id="scroll") as vs:
                vs.can_focus = False
                yield Vertical(id="gridwrap")
            with Horizontal(id="wp-actions"):
                yield Button("󰸉 Set selected", id="wp_set")
                yield Button("󰒝 Slideshow from this folder", id="wp_folder")
                yield Button("󰕌 Restore & close", id="wp_cancel")
        yield Footer()

    def on_mount(self):
        self.screen.add_class(f"mode-{self.mode}")
        if self.mode in ("apps", "menu"):
            self.entries = desktop_entries() if self.mode == "apps" else tool_entries()
            self.call_later(self.refilter, "")
            self.query_one("#filter", Input).focus()
        elif self.mode == "windows":
            self.entries = window_entries()
            self.call_later(self.refilter_list, "")
            self.query_one("#filter", Input).focus()
        else:
            self.run_worker(self.show_monitors(), exclusive=True)

    def on_resize(self, _event=None):
        """Re-flow the grid when the window is resized (ALT + right-drag)."""
        # Boxes per row: apps 8 (compact), tools 6 (two text lines),
        # wallpaper 4 (thumbs need width). HYPR_LAUNCHER_COLS overrides.
        desired = {"apps": 10, "menu": 6}.get(self.mode, 4)
        override = os.environ.get("HYPR_LAUNCHER_COLS")
        if override and override.isdigit():
            desired = max(2, min(12, int(override)))
        cols = max(2, min(desired, self.size.width // 14))
        if cols != self.cols:
            self.cols = cols
        for grid in self.query(".tilegrid"):
            grid.styles.grid_size_columns = cols

    # ---------- grid ----------
    async def fill_grid(self, objs=None, groups=None):
        wrap = self.query_one("#gridwrap", Vertical)
        await wrap.remove_children()
        if groups is None:
            groups = [(None, objs)]
        # cap total tiles across all groups
        budget = MAX_TILES
        capped = []
        for title, gobjs in groups:
            take = gobjs[:budget]
            budget -= len(take)
            if take:
                capped.append((title, take))
        flat = [o for t, gobjs in capped for o in gobjs
                if t is None or t in self.expanded]

        def img_for(o):
            if o["kind"] == "app":
                return resolve_icon(o["icon"]) or default_app_icon()
            if o["kind"] in ("img", "mon"):
                return make_thumb(o.get("path"))
            return None

        def resolve_images():
            with ThreadPoolExecutor(max_workers=8) as ex:
                return dict(zip(map(id, flat), ex.map(img_for, flat)))

        # off the event loop: at cold boot this can take a while, and the UI
        # must keep answering keys (Esc/Enter) instead of freezing
        paths = await asyncio.to_thread(resolve_images)
        self.tiles = []
        widgets = []
        for si, (title, gobjs) in enumerate(capped):
            expanded = title is None or title in self.expanded
            if title:
                widgets.append(SectionHeader(title, len(gobjs), expanded, si))
            if not expanded:
                continue
            grid = Grid(classes="tilegrid")
            grid.styles.grid_size_columns = self.cols
            tiles = [Tile(o, len(self.tiles) + i, paths.get(id(o)))
                     for i, o in enumerate(gobjs)]
            self.tiles.extend(tiles)
            grid._pending_tiles = tiles
            widgets.append(grid)
        if widgets:
            await wrap.mount_all(widgets)
            for w in widgets:
                if isinstance(w, Grid):
                    await w.mount_all(w._pending_tiles)
        self.on_resize()
        flush_resolve_cache()
        self.sel = -1
        if self.tiles:
            self.select(0)

    def select(self, i, preview=True):
        if not self.tiles:
            return
        i = max(0, min(len(self.tiles) - 1, i))
        if 0 <= self.sel < len(self.tiles):
            self.tiles[self.sel].remove_class("selected")
        self.sel = i
        tile = self.tiles[i]
        tile.add_class("selected")
        tile.scroll_visible()
        if preview and self.mode == "wallpaper" and tile.obj["kind"] == "img":
            self.preview(tile.obj["path"])

    def activate(self, i):
        if not (0 <= i < len(self.tiles)):
            return
        obj = self.tiles[i].obj
        if self.mode == "apps":
            rec = self.state["recent"]
            rec[obj["detail"]] = time.time()
            if len(rec) > 20:   # keep the 20 most recent
                for k, _ in sorted(rec.items(), key=lambda kv: kv[1])[:len(rec) - 20]:
                    del rec[k]
            save_json(STATE_FILE, self.state)
            try:
                launch_app(obj)
            finally:
                self.exit()     # the picker must never outlive a launch
        elif obj["kind"] == "tool":
            try:
                run_detached(*obj["cmd"])
            finally:
                self.exit()
        elif obj["kind"] == "mon":
            self.wp_target = obj["target"]
            self.run_worker(self.show_folder(), exclusive=True)
        elif obj["kind"] in ("dir", "up"):
            self.cwd = Path(obj["path"])
            self.run_worker(self.show_folder(), exclusive=True)
        elif obj["kind"] == "img":
            args = [WALLPAPER_SH, obj["path"]]
            if self.wp_target:
                args.append(self.wp_target)
            run_detached(*args)
            self.exit()

    # ---------- apps filtering ----------
    async def refilter(self, query):
        q = query.lower().strip()

        def rank(name):
            nl = name.lower()
            if not q:
                return 3
            if nl.startswith(q):
                return 0
            if any(w.startswith(q) for w in nl.split()):
                return 1
            if q in nl:
                return 2
            return None

        ranked = []
        for i, e in enumerate(self.entries):
            r = rank(e["label"])
            if r is None and q and q in e["detail"].lower():
                r = 2
            if r is not None:
                # apps: alphabetical; menu: keep the curated grouping order
                key2 = e["label"].lower() if self.mode == "apps" else i
                ranked.append((r, key2, e))
        ranked.sort(key=lambda t: (t[0], t[1]))
        matches = [e for _, _, e in ranked]
        if self.mode == "apps" and not q:
            fav_set = set(self.state["favorites"])
            recent = self.state["recent"]
            for e in matches:
                e["fav"] = e["detail"] in fav_set
            group_list = []
            favs = [dict(e, _grp=FAV_TITLE) for e in matches if e["fav"]]
            if favs:
                group_list.append((FAV_TITLE, favs))
            recs = [e for e in matches if e["detail"] in recent and not e["fav"]]
            recs.sort(key=lambda e: -recent.get(e["detail"], 0))
            recs = [dict(e, _grp=REC_TITLE) for e in recs[:8]]
            if recs:
                group_list.append((REC_TITLE, recs))
            groups = {}
            for e in matches:
                idx2, title = category_of(e)
                e["_grp"] = title
                groups.setdefault((idx2, title), []).append(e)
            group_list += [(t, es) for (_, t), es in sorted(groups.items())]
            await self.fill_grid(groups=group_list)
            want = self._focus_section
            self._focus_section = None
            if want:
                for i, t in enumerate(self.tiles):
                    if t.obj.get("_grp") == want:
                        self.select(i, preview=False)
                        break
        else:
            await self.fill_grid(matches)

    # ---------- windows filtering (list) ----------
    async def refilter_list(self, query):
        q = query.lower().strip()
        matches = [e for e in self.entries
                   if not q or q in e["label"].lower() or q in e["detail"].lower()]
        lv = self.query_one("#results", ListView)
        await lv.clear()
        await lv.extend(Item(e) for e in matches[:MAX_TILES])
        lv.index = 0

    def on_input_changed(self, event: Input.Changed):
        value = event.value
        # a late terminal reply can get typed into the box as garbage
        # (looks like '_Gi=1234;OK\'); scrub it instead of filtering by it
        clean = re.sub(r"_?Gi=\d+;\w+\\?", "", value)
        if clean != value:
            event.input.value = clean
            return
        if self._filter_timer is not None:
            self._filter_timer.stop()

        def apply():
            self._filter_timer = None
            coro = (self.refilter(value) if self.mode in ("apps", "menu")
                    else self.refilter_list(value))
            self.run_worker(coro, exclusive=True)

        self._filter_timer = self.set_timer(0.15, apply)

    def on_input_submitted(self, _event):
        self.action_activate()

    # ---------- navigation ----------
    def action_move(self, step: int):
        if self.mode != "windows" and self.tiles:
            self.select(self.sel + step)

    def action_move_row(self, step: int):
        if self.mode == "windows":
            try:
                lv = self.query_one("#results", ListView)
            except Exception:
                return
            if lv.children:
                lv.index = max(0, min(len(lv.children) - 1, (lv.index or 0) + step))
        elif self.tiles:
            self.select(self.sel + step * self.cols)

    def action_activate(self):
        if self.mode == "windows":
            lv = self.query_one("#results", ListView)
            item = lv.highlighted_child or (lv.children[0] if lv.children else None)
            if isinstance(item, Item):
                focus_window(item.obj)
                self.exit()
        else:
            self.activate(self.sel)

    def on_list_view_selected(self, event: ListView.Selected):
        if self.mode == "windows" and isinstance(event.item, Item):
            focus_window(event.item.obj)
            self.exit()

    def on_section_header_toggled(self, msg: SectionHeader.Toggled):
        if msg.title in self.expanded:
            self.expanded.discard(msg.title)
        else:
            self.expanded.add(msg.title)
            self._focus_section = msg.title
        query = self.query_one("#filter", Input).value
        self.run_worker(self.refilter(query), exclusive=True)

    def on_tile_starred(self, msg: Tile.Starred):
        if self.mode != "apps":
            return
        d = msg.tile.obj["detail"]
        if d in self.state["favorites"]:
            self.state["favorites"].remove(d)
            note = "removed from ★ Favorites"
        else:
            self.state["favorites"].append(d)
            note = "added to ★ Favorites"
        save_json(STATE_FILE, self.state)
        self.notify(f"{msg.tile.obj['label']} {note}")
        q = self.query_one("#filter", Input).value
        self.run_worker(self.refilter(q), exclusive=True)

    def on_tile_chosen(self, msg: Tile.Chosen):
        self.select(msg.tile.idx)

    def on_tile_activated(self, msg: Tile.Activated):
        self.select(msg.tile.idx, preview=False)
        self.activate(msg.tile.idx)

    # ---------- wallpaper ----------
    async def show_monitors(self):
        """Step 1: pick a monitor — each tile shows that monitor's CURRENT
        wallpaper plus where it sits (left/right/top/bottom)."""
        self.query_one("#wp-actions").display = False
        self.query_one("#wp-where", Static).update(
            "Which monitor? Each box shows what that monitor wears right now.")
        cur = dict(self.wp_orig)
        mons = monitor_info()
        xs = sorted({m["x"] for m in mons})
        ys = sorted({m["y"] for m in mons})
        objs = [{"kind": "mon", "label": "All monitors", "target": "",
                 "sub": "same image everywhere",
                 "path": cur.get("", next(iter(cur.values()), ""))}]
        for m in mons:
            pos = []
            if len(ys) > 1:
                pos.append("top" if m["y"] == ys[0] else "bottom")
            if len(xs) > 1:
                pos.append("left" if m["x"] == xs[0]
                           else ("right" if m["x"] == xs[-1] else "middle"))
            sub = " ".join(pos) or "only monitor"
            if m.get("focused"):
                sub += " · ★ you are here"
            objs.append({"kind": "mon", "label": m["name"], "target": m["name"],
                         "sub": sub, "path": cur.get(m["name"], cur.get("", ""))})
        await self.fill_grid(objs)

    async def show_folder(self):
        self.query_one("#wp-actions").display = True
        where = self.wp_target or "all monitors"
        pretty = str(self.cwd).replace(str(HOME), "~")
        self.query_one("#wp-where", Static).update(
            f"[{C['accent']}]{where}[/] · {pretty} — select previews live · "
            f"Enter keeps it · Esc restores")
        await self.fill_grid(folder_contents(self.cwd))

    def preview(self, path):
        self.wp_previewed = True
        targets = [self.wp_target] if self.wp_target else \
                  [m for m, _ in self.wp_orig] or [""]
        for m in targets:
            hyprctl("hyprpaper", "wallpaper", f"{m},{path}")

    def restore_original(self):
        if not self.wp_previewed:
            return
        for m, p in self.wp_orig:
            if p:
                hyprctl("hyprpaper", "wallpaper", f"{m},{p}")

    def on_button_pressed(self, event: Button.Pressed):
        if event.button.id == "wp_cancel":
            self.action_cancel()
        elif event.button.id == "wp_set":
            self.activate(self.sel)
        elif event.button.id == "wp_folder":
            args = [WALLPAPER_SH, str(self.cwd)]
            if self.wp_target:
                args.append(self.wp_target)
            run_detached(*args)
            self.exit()

    def action_cancel(self):
        if self.mode == "wallpaper":
            self.restore_original()
        self.exit()


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "apps"
    if mode not in ("apps", "windows", "wallpaper", "menu"):
        mode = "apps"
    HyprLauncher(mode).run()
