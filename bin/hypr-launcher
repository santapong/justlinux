#!/usr/bin/env python3
"""Hypr Launcher — app / window / wallpaper pickers, Hypr Settings style.

    hypr-launcher apps        launch an application   (icon grid)
    hypr-launcher windows     focus an open window    (list)
    hypr-launcher wallpaper   pick wallpaper          (thumbnail grid + LIVE preview)

Apps & wallpaper show a Windows-style icon grid: real app icons and real
wallpaper thumbnails, drawn with the kitty graphics protocol. Click to
select, double-click or Enter to open. Arrow keys move box to box.
The grid re-flows when you resize the window (ALT + right-drag).

Wallpaper mode: the monitor step shows each monitor's CURRENT wallpaper
so you can tell them apart; selecting an image previews it on the actual
desktop instantly; Enter keeps it (recolors the desktop), Esc restores.
"""

import asyncio
import hashlib
import json
import time
import os
import re
import shlex
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Grid, Horizontal, Vertical, VerticalScroll
from textual.message import Message
from textual.widgets import (Button, Footer, Input, Label, ListItem,
                             ListView, Static)

def _import_image_widget():
    """textual-image probes the terminal at import (blocking queries with a
    0.1s timeout). Under boot load the reply arrives late and leaks into the
    filter box as garbage like '_Gi=1234;OK', and the failed probe drops icon
    rendering to block-art. We already know the terminal — kitty — so import
    with stdout looking like a non-tty (no probe is ever sent) and pick the
    renderer ourselves."""
    real = sys.__stdout__

    class _Blind:
        def __getattr__(self, attr):
            return getattr(real, attr)

        def isatty(self):
            return False

    sys.__stdout__ = _Blind()
    try:
        from textual_image import _terminal
        from textual_image.widget import TGPImage, UnicodeImage
    finally:
        sys.__stdout__ = real
    # the import cached a dummy 10x20 cell size; redo it via ioctl (no probe)
    try:
        delattr(_terminal.get_cell_size, "_result")
    except AttributeError:
        pass
    if real is not None and real.isatty():
        _terminal.get_cell_size()
    on_tty = real is not None and real.isatty()
    in_kitty = os.environ.get("KITTY_WINDOW_ID") or "kitty" in os.environ.get("TERM", "")
    return TGPImage if (on_tty and in_kitty) else UnicodeImage


try:
    Image = _import_image_widget()
except Exception:
    Image = None

HOME = Path.home()
COLORS_CSS = HOME / ".config/waybar/colors.css"
HYPRPAPER = HOME / ".config/hypr/hyprpaper.conf"
WALLPAPER_SH = str(HOME / ".local/bin/wallpaper.sh")
CACHE = HOME / ".cache/hypr-launcher"
ICON_CACHE = CACHE / "icons"
THUMB_CACHE = CACHE / "thumbs"
DRY = os.environ.get("HYPRSETTINGS_DRYRUN") == "1"
ACTIONS = []  # recorded instead of executed under DRY (for tests)

IMG_EXTS = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif"}
MAX_TILES = 160
COLS = 4  # initial; re-computed from window width on resize

STATE_FILE = HOME / ".local/state/hypr-launcher/state.json"
APPS_CACHE = CACHE / "apps.json"
RESOLVE_CACHE_FILE = CACHE / "resolve.json"
FAV_TITLE = "★ Favorites"
REC_TITLE = "󰥔 Recent"


def load_json(path, default):
    try:
        return json.loads(Path(path).read_text())
    except Exception:
        return default


def save_json(path, data):
    if DRY:
        return
    try:
        p = Path(path)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(json.dumps(data))
    except OSError:
        pass


def load_state():
    st = load_json(STATE_FILE, {})
    st.setdefault("favorites", [])
    st.setdefault("recent", {})
    return st


def read_colors():
    colors = {
        "base": "#1e1e2e", "surface": "#45475a", "text": "#cdd6f4",
        "subtext": "#a6adc8", "accent": "#89b4fa", "red": "#f38ba8",
        "green": "#a6e3a1", "yellow": "#f9e2af", "cyan": "#94e2d5",
    }
    try:
        for m in re.finditer(r"@define-color\s+(\w+)\s+(#[0-9a-fA-F]{6})", COLORS_CSS.read_text()):
            colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


C = read_colors()


def run_detached(*cmd):
    if DRY:
        ACTIONS.append(cmd)
        return
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def hyprctl(*args):
    if DRY:
        ACTIONS.append(("hyprctl",) + args)
        return ""
    return subprocess.run(["hyprctl", *args], capture_output=True,
                          text=True).stdout


# ---------------- icons ----------------
FLATPAK_BASES = [Path("/var/lib/flatpak/exports/share"),
                 HOME / ".local/share/flatpak/exports/share"]


def build_icon_index():
    """icon-name -> {"svg": path, "png": path}; Flat-Remix SVG preferred."""
    idx = {}
    fr = Path("/usr/share/icons/Flat-Remix-Blue-Dark/apps/scalable")
    if fr.is_dir():
        for f in fr.iterdir():
            if f.suffix == ".svg":
                idx.setdefault(f.stem, {})["svg"] = str(f)
    png_bases = [Path("/usr/share/icons/hicolor"),
                 HOME / ".local/share/icons/hicolor"] + \
                [b / "icons/hicolor" for b in FLATPAK_BASES]
    for base in png_bases:
        if not base.is_dir():
            continue
        for f in base.rglob("*"):
            if f.suffix == ".png":
                m = re.search(r"/(\d+)x\1/", str(f))
                size = int(m.group(1)) if m else 32
                d = idx.setdefault(f.stem, {})
                if 24 <= size <= 256 and size >= d.get("png_size", 0):
                    d["png"], d["png_size"] = str(f), size
            elif f.suffix == ".svg":
                idx.setdefault(f.stem, {}).setdefault("svg", str(f))
    pm = Path("/usr/share/pixmaps")
    if pm.is_dir():
        for f in pm.glob("*.png"):
            idx.setdefault(f.stem, {}).setdefault("png", str(f))
    return idx


ICON_IDX = None
RESOLVE_CACHE = load_json(RESOLVE_CACHE_FILE, {})
_resolve_dirty = False


def rasterize_svg(svg_path):
    """SVG -> cached 72px PNG via ImageMagick (one-time per icon)."""
    if DRY:
        return None
    out = ICON_CACHE / (hashlib.md5(svg_path.encode()).hexdigest() + ".png")
    if out.exists():
        return str(out)
    ICON_CACHE.mkdir(parents=True, exist_ok=True)
    r = subprocess.run(["magick", "-background", "none", svg_path,
                        "-resize", "72x72", str(out)],
                       capture_output=True, timeout=15)
    return str(out) if r.returncode == 0 and out.exists() else None


def resolve_icon(icon_value):
    """Icon= value from a .desktop file -> path to a PNG, or None.
    Results are cached on disk so later launches never walk icon themes."""
    global ICON_IDX, _resolve_dirty
    if not icon_value:
        return None
    if icon_value in RESOLVE_CACHE:
        hit = RESOLVE_CACHE[icon_value]
        if hit is None or os.path.exists(hit):
            return hit
    result = _resolve_icon_uncached(icon_value)
    RESOLVE_CACHE[icon_value] = result
    _resolve_dirty = True
    return result


def _resolve_icon_uncached(icon_value):
    global ICON_IDX
    p = Path(icon_value)
    if p.is_absolute() and p.exists():
        return rasterize_svg(str(p)) if p.suffix == ".svg" else str(p)
    if ICON_IDX is None:
        ICON_IDX = build_icon_index()
    cand = ICON_IDX.get(icon_value) or ICON_IDX.get(icon_value.lower())
    if not cand:
        return None
    if "svg" in cand:
        png = rasterize_svg(cand["svg"])
        if png:
            return png
    return cand.get("png")


_default_icon = "unset"


def default_app_icon():
    """Theme's generic app icon, for apps whose own icon can't be found."""
    global _default_icon
    if _default_icon == "unset":
        _default_icon = None
        for name in ("application-default-icon", "application-x-executable",
                     "system-run"):
            _default_icon = resolve_icon(name)
            if _default_icon:
                break
    return _default_icon


def flush_resolve_cache():
    global _resolve_dirty
    if _resolve_dirty:
        save_json(RESOLVE_CACHE_FILE, RESOLVE_CACHE)
        _resolve_dirty = False


def make_thumb(img_path):
    """Wallpaper image -> cached 320x180-ish thumbnail PNG."""
    if DRY or not img_path:
        return None
    try:
        st = os.stat(img_path)
        key = hashlib.md5(f"{img_path}:{st.st_mtime_ns}".encode()).hexdigest()
        out = THUMB_CACHE / (key + ".png")
        if out.exists():
            return str(out)
        THUMB_CACHE.mkdir(parents=True, exist_ok=True)
        from PIL import Image as PILImage
        im = PILImage.open(img_path)
        im.draft("RGB", (640, 360))
        im.thumbnail((320, 180))
        im.convert("RGB").save(out)
        return str(out)
    except Exception:
        return None


# ---------------- apps ----------------
def app_dirs():
    """All .desktop locations: system, XDG_DATA_DIRS, flatpak, user (last wins)."""
    dirs = [Path("/usr/share/applications"),
            Path("/usr/local/share/applications")]
    for d in os.environ.get("XDG_DATA_DIRS", "").split(":"):
        if d:
            dirs.append(Path(d) / "applications")
    dirs += [b / "applications" for b in FLATPAK_BASES]
    dirs.append(HOME / ".local/share/applications")
    seen, out = set(), []
    for d in dirs:
        if d not in seen:
            seen.add(d)
            out.append(d)
    return out


def desktop_entries():
    dirs = app_dirs()
    stamp = [[str(d), d.stat().st_mtime if d.is_dir() else 0] for d in dirs]
    cached = load_json(APPS_CACHE, None)
    if cached and cached.get("stamp") == stamp:
        return cached["entries"]
    entries = {}
    for d in dirs:  # later dirs override earlier (user overrides system)
        if not d.is_dir():
            continue
        for f in sorted(d.glob("*.desktop")):
            try:
                text = f.read_text(errors="ignore")
            except OSError:
                continue
            in_main, e = False, {}
            for line in text.splitlines():
                line = line.strip()
                if line.startswith("["):
                    in_main = line == "[Desktop Entry]"
                    continue
                if in_main and "=" in line:
                    k, v = line.split("=", 1)
                    e.setdefault(k.strip(), v.strip())
            if e.get("Type") != "Application":
                continue
            if "true" in (e.get("NoDisplay", "").lower(), e.get("Hidden", "").lower()):
                continue
            name, ex = e.get("Name"), e.get("Exec")
            if not name or not ex:
                continue
            entries[f.stem] = {
                "kind": "app",
                "label": name,
                "detail": f.stem,
                "icon": e.get("Icon", ""),
                "exec": ex,
                "terminal": e.get("Terminal", "").lower() == "true",
                "cats": e.get("Categories", ""),
            }
    return sorted(entries.values(), key=lambda x: x["label"].lower())


# (match order matters: first hit wins)
CATEGORY_GROUPS = [
    ("Security",     "󰕥 Security",     ("Security", "X-Kali")),
    ("Internet",     "󰖟 Internet",     ("Network", "WebBrowser", "Email", "Chat", "InstantMessaging")),
    ("Development",  " Development",  ("Development", "IDE", "TextEditor")),
    ("Media",        "󰝚 Media",        ("AudioVideo", "Audio", "Video", "Player", "Recorder")),
    ("Graphics",     "󰋩 Graphics",     ("Graphics", "Photography")),
    ("Games",        "󰊗 Games",        ("Game",)),
    ("Office",       "󰈙 Office",       ("Office", "WordProcessor", "Spreadsheet", "Presentation")),
    ("Science",      "󰭹 Science",      ("Science", "Education", "Math")),
    ("System",       " System",       ("Settings", "System", "Monitor", "PackageManager")),
    ("Utilities",    "󰘵 Utilities",    ("Utility", "Accessibility", "FileManager", "TerminalEmulator", "Archiving")),
]


def category_of(entry):
    """(sort_index, section_title) for an app entry."""
    cats = entry.get("cats", "")
    for i, (_key, title, needles) in enumerate(CATEGORY_GROUPS):
        if any(n in cats for n in needles):
            return i, title
    return len(CATEGORY_GROUPS), "󰘔 Other"


def launch_app(entry):
    try:
        tokens = shlex.split(entry["exec"])
    except ValueError:              # unbalanced quotes in a stray .desktop file
        tokens = entry["exec"].split()
    # %u/%F… are desktop-spec field codes; @@u/@@ are flatpak URI markers —
    # neither is a real argument, and leaking @@ into Chromium opens junk tabs.
    argv = [a for a in tokens if not a.startswith("%") and not a.startswith("@@")]
    if entry["terminal"]:
        argv = ["kitty", "-e"] + argv
    run_detached(*argv)


# ---------------- windows ----------------
def window_entries():
    if DRY:
        return [{"label": "kitty — ~", "detail": "ws 1", "icon": "",
                 "addr": "0xfake1"},
                {"label": "Brave — GitHub", "detail": "ws 2", "icon": "󰖟",
                 "addr": "0xfake2"}]
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"],
                                            capture_output=True, text=True).stdout)
    except Exception:
        return []
    out = []
    for c in clients:
        ws = c.get("workspace", {}).get("name", "?")
        # the ALT+S scratchpad (special:magic) has its OWN toggle and must
        # NOT be surfaced/drained here — "restoring" it would empty the
        # scratchpad and break ALT+S. Only surface genuinely-lost windows:
        # per-window hide (special:hidden) and workspace stash (special:stashN)
        if ws == "special:magic":
            continue
        stashed = ws.startswith("special:stash")
        hidden = ws == "special:hidden" or stashed
        title = c.get("title") or c.get("class") or "?"
        detail = f"{c.get('class', '?')} · ws {ws}"
        if hidden:
            kind = "stashed" if stashed else "hidden"
            detail = f"{c.get('class', '?')} · 󰘓 {kind} — Enter to restore"
        out.append({"label": title[:60], "detail": detail,
                    "icon": "󰘓" if hidden else "󰖯",
                    "addr": c.get("address", ""),
                    "hidden": hidden})
    # hidden/stashed windows first (they're the ones you're hunting for)
    return sorted(out, key=lambda x: (not x.get("hidden"), x["detail"]))


def active_workspace_id():
    try:
        return json.loads(subprocess.run(
            ["hyprctl", "activeworkspace", "-j"],
            capture_output=True, text=True).stdout).get("id", 1)
    except Exception:
        return 1


def focus_window(entry):
    addr = f"address:{entry['addr']}"
    if entry.get("hidden"):
        # restore a stashed/hidden window: pull it onto the current
        # workspace and focus it (focuswindow alone won't unbury a
        # special-workspace window)
        hyprctl("dispatch", "movetoworkspace", f"{active_workspace_id()},{addr}")
        hyprctl("dispatch", "focuswindow", addr)
    else:
        # a normal window on another workspace: focuswindow switches there
        hyprctl("dispatch", "focuswindow", addr)


# ---------------- wallpaper ----------------
def current_wallpapers():
    """[(monitor_or_empty, full_path), ...] from hyprpaper.conf"""
    pairs, mon = [], None
    try:
        for line in HYPRPAPER.read_text().splitlines():
            line = line.strip()
            if line.startswith("monitor"):
                mon = line.split("=", 1)[1].strip()
            elif line.startswith("path") and mon is not None:
                pairs.append((mon, line.split("=", 1)[1].strip()))
                mon = None
    except OSError:
        pass
    return pairs


def monitor_info():
    """[{name, x, y, focused}, ...]"""
    if DRY:
        return [{"name": "DP-1", "x": 0, "y": 0, "focused": True},
                {"name": "HDMI-A-2", "x": 1600, "y": 0, "focused": False},
                {"name": "HDMI-A-1", "x": 0, "y": 900, "focused": False}]
    try:
        return [{"name": m["name"], "x": m["x"], "y": m["y"],
                 "focused": m.get("focused", False)}
                for m in json.loads(subprocess.run(
                    ["hyprctl", "monitors", "-j"],
                    capture_output=True, text=True).stdout)]
    except Exception:
        return []


def wallpaper_root():
    for cand in (HOME / "Pictures/wallpaper", HOME / "Pictures/Wallpapers",
                 HOME / "Pictures", HOME):
        if cand.is_dir():
            return cand
    return HOME


def folder_contents(d):
    """[.. , folders..., images...] as tile objects."""
    objs = []
    if d != Path("/") and d != d.parent:
        objs.append({"kind": "up", "label": "..", "path": str(d.parent)})
    try:
        items = sorted(d.iterdir(), key=lambda p: p.name.lower())
    except OSError:
        items = []
    for p in items:
        if p.name.startswith("."):
            continue
        if p.is_dir():
            objs.append({"kind": "dir", "label": p.name, "path": str(p)})
    for p in items:
        if not p.name.startswith(".") and p.suffix.lower() in IMG_EXTS:
            objs.append({"kind": "img", "label": p.name, "path": str(p)})
    return objs[:MAX_TILES]


GLYPHS = {"app": "󰘔", "dir": "󰉋", "up": "󰁍", "img": "󰋩", "mon": "󰍹", "tool": "󰒓"}

TOOLS_SH = str(HOME / ".local/bin/hypr-tools.sh")


def _fw_on():
    try:
        return "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text()
    except OSError:
        return False


def _autohide_on():
    if DRY:
        return False
    return subprocess.run(["pgrep", "-f", "waybar-autohide.sh"],
                          capture_output=True).returncode == 0


