def theme_list():
    """wallust (follows the wallpaper) + every palette in themes/."""
    themes = sorted(p.stem for p in
                    (HOME / ".config/conky/themes").glob("*.lua"))
    return ["wallust"] + themes


def widget_list():
    """Every card INSTANCE (widgets.conf inst_* keys, labels from the
    hyprcard templates) + the app dock — drop a .toml in
    ~/.config/hyprcard/templates/ and add instances via the picker.
    Falls back to the conky .conf glob if no instances exist yet."""
    try:
        from hyprdesk import cardspec
        from hyprdesk.theme import conf as _hconf
        c = _hconf()
        tmpls = cardspec.load_templates()
        insts = cardspec.instances(c)
        if insts:
            out = []
            for inst_id, tname in insts:
                t = tmpls.get(tname)
                label = t.label if isinstance(t, cardspec.Template) \
                    else f"{tname} (broken template)"
                if inst_id != tname:
                    label = f"{label} · {inst_id}"
                out.append((inst_id, label))
            out.append(("apps", WIDGET_LABELS["apps"]))
            return sorted(out, key=lambda kv: kv[1].lower())
    except Exception:
        pass
    names = sorted(p.stem for p in (HOME / ".config/conky/widgets").glob("*.conf")
                   if p.stem != "apps" and re.fullmatch(r"[A-Za-z][\w-]*", p.stem))
    names.append("apps")
    return [(n, WIDGET_LABELS.get(n, f"{n.title()} (custom)")) for n in names]


def widgets_conf():
    d = {"clock": "on", "stats": "on", "calendar": "on", "claude": "on",
         "apps": "on", "pet": "on", "pet_layer": "bottom", "cards": "on",
         "claude_pet": "on", "devgit": "on", "robotics": "on"}
    d["theme"] = "wallust"
    for name, (pos, x, y) in DEFAULT_POS.items():
        d[f"{name}_pos"], d[f"{name}_x"], d[f"{name}_y"] = pos, str(x), str(y)
    try:
        for line in WIDGETS_CONF.read_text().splitlines():
            m = re.match(r"^(\w+)\s*=\s*([-\w.,]+)", line)
            if m:
                d[m.group(1)] = m.group(2)
    except OSError:
        pass
    return d


def widgets_conf_set(key, val):
    # atomic + lock-guarded — no longer races hypr-arrange / the card host
    _conf_set({key: val})

GAUGE_SLOTS = 12


def read_colors():
    colors = {
        "base": "#1e1e2e", "surface": "#45475a", "text": "#cdd6f4",
        "subtext": "#a6adc8", "accent": "#89b4fa", "red": "#f38ba8",
        "green": "#a6e3a1", "yellow": "#f9e2af", "cyan": "#94e2d5",
    }
    try:
        for m in re.finditer(r"@define-color\s+(\w+)\s+(#[0-9a-fA-F]{6})", COLORS_CSS.read_text()):
            colors[m.group(1)] = m.group(2)
    except OSError:
        pass
    return colors


def hyprctl_get(option, default):
    """Read a live option value; returns int (bools are 0/1)."""
    if DRY or not shutil.which("hyprctl"):
        return default
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", option],
                             capture_output=True, text=True, timeout=1).stdout
        d = json.loads(out)
        if "int" in d:
            return int(d["int"])
        if "custom" in d:  # gaps report as "N N N N"
            return int(str(d["custom"]).split()[0])
    except Exception:
        pass
    return default


def hyprctl_custom(option):
    """Raw 'custom' string for options like gaps ('5 10 5 10'), or None."""
    if DRY or not shutil.which("hyprctl"):
        return None
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", option],
                             capture_output=True, text=True, timeout=1).stdout
        d = json.loads(out)
        return str(d["custom"]).strip() if "custom" in d else None
    except Exception:
        return None


def hyprctl_set(option, value):
    if DRY:
        return
    subprocess.run(["hyprctl", "keyword", option, str(value)],
                   capture_output=True, text=True)


def launch(*cmd):
    """Start a detached external program (rofi pickers, GUIs, pkexec…)."""
    if DRY:
        return
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def save_to_config(values):
    """Rewrite `key = value` lines in hyprland.conf, matched by block path.

    values: {("general","gaps_in"): "5", ("decoration","blur","enabled"): "true", ...}
    """
    lines = CONF.read_text().splitlines(keepends=True)
    stack, out, written = [], [], set()
    for line in lines:
        stripped = line.strip()
        if re.match(r"^[\w.-]+\s*\{", stripped):
            stack.append(stripped.split("{")[0].strip())
        elif stripped.startswith("}"):
            if stack:
                stack.pop()
        else:
            m = re.match(r"^(\s*)([\w.]+)\s*=\s*(.*?)(\s*#.*)?$", line.rstrip("\n"))
            if m and tuple(stack) + (m.group(2),) in values:
                path = tuple(stack) + (m.group(2),)
                comment = m.group(4) or ""
                line = f"{m.group(1)}{m.group(2)} = {values[path]}{comment}\n"
                written.add(path)
        out.append(line)
    CONF.write_text("".join(out))
    return written


def firewall_on():
    try:
        return "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text()
    except OSError:
        return False


def service_active(name):
    if DRY:
        return False
    return subprocess.run(["systemctl", "-q", "is-active", name],
                          capture_output=True).returncode == 0


def autohide_on():
    if DRY:
        return False
    return subprocess.run(["pgrep", "-f", "waybar-autohide.sh"],
                          capture_output=True).returncode == 0


def current_wallpapers():
    pairs, mon = [], None
    try:
        for line in HYPRPAPER.read_text().splitlines():
            line = line.strip()
            if line.startswith("monitor"):
                mon = line.split("=", 1)[1].strip() or "(all)"
            elif line.startswith("path") and mon is not None:
                pairs.append((mon, Path(line.split("=", 1)[1].strip()).name))
                mon = None
    except OSError:
        pass
    return pairs


C = read_colors()

# Destructive actions must READ as red. Wallust maps palette slots by
# wallpaper, so C["red"] can come out blue/brown — fall back to a real red.
_r, _g, _b = (int(C["red"][i:i + 2], 16) for i in (1, 3, 5))
DANGER = C["red"] if _r > _g and _r > _b else "#d9536f"


def stepper(label, bid):
    """A +/- button that registers every click, even rapid ones.

    Button ignores clicks during its 0.2 s press-flash animation, which
    swallows every second click when the user hammers +. Disable the flash.
    """
    b = Button(label, id=bid, classes="small")
    b.active_effect_duration = 0
    return b


def gauge_markup(key, val, hi=None):
    _, _, lo, default_hi, _ = INTS[key]
    hi = hi or default_hi
    filled = max(0, min(GAUGE_SLOTS, round((val - lo) / (hi - lo) * GAUGE_SLOTS)))
    return (f"[{C['accent']}]{'█' * filled}[/]"
            f"[{C['surface']}]{'░' * (GAUGE_SLOTS - filled)}[/]")


def dot(ok, text_on, text_off):
    return (f"[{C['green']}]●[/] {text_on}" if ok
            else f"[{DANGER}]●[/] {text_off}")


class Card(Vertical):
    """A titled, rounded-border group of related controls."""

    def __init__(self, title, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.border_title = f" {title} "


class Confirm(ModalScreen[bool]):
    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False),
                Binding("q", "cancel", "Cancel", show=False)]
    CSS = f"""
    Confirm {{ align: center middle; background: {C['base']} 60%; }}
    #dlg {{ width: 56; height: auto; padding: 1 2; background: {C['base']};
           border: round {DANGER}; }}
    #question {{ padding: 1; text-align: center; width: 100%; }}
    #btns {{ height: 3; align-horizontal: center; }}
    #btns Button {{ margin: 0 2; }}
    """

    def __init__(self, question):
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical(id="dlg"):
            yield Label(self.question, id="question")
            with Horizontal(id="btns"):
                yield Button("No — stay", id="no", variant="primary")
                yield Button("Yes", id="yes", variant="error")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_cancel(self) -> None:
        self.dismiss(False)


class HyprSettings(App):
    TITLE = "Hypr Settings"
    ENABLE_COMMAND_PALETTE = False
    BINDINGS = [Binding("q", "quit", "Quit")] + [
        Binding(str(i + 1), f"nav({i})", NAV[i][2], show=False) for i in range(len(NAV))
    ]
    CSS = f"""
    Screen {{ background: ansi_default; color: {C['text']}; }}
    #hdr {{ height: 1; padding: 0 2; background: transparent; }}
    #body {{ background: transparent; }}

    #sidebar {{ width: 22; background: transparent; margin: 1 0 0 1; }}
    #sidebar ListItem {{
        background: transparent; padding: 0 1; margin-bottom: 1;
        border-left: thick transparent;
    }}
    #sidebar ListItem Label {{ width: 100%; color: {C['subtext']}; }}
    #sidebar ListItem.-highlight {{
        background: {C['surface']}; border-left: thick {C['accent']};
    }}
    #sidebar ListItem.-highlight Label {{ color: {C['text']}; text-style: bold; }}

    #content {{ background: transparent; padding: 1 2 0 1; }}
    #content VerticalScroll {{
        scrollbar-size-vertical: 1;
        scrollbar-color: {C['surface']}; scrollbar-color-hover: {C['accent']};
        scrollbar-color-active: {C['accent']}; scrollbar-background: transparent;
        scrollbar-background-hover: transparent; scrollbar-background-active: transparent;
    }}
    #content > * {{ background: transparent; }}
    Card {{
        border: round {C['surface']};
        border-title-color: {C['accent']}; border-title-style: bold;
        padding: 1 2; margin-bottom: 1; height: auto; background: transparent;
    }}
    Card.danger {{ border: round {DANGER}; border-title-color: {DANGER}; }}

    .row {{ height: 3; background: transparent; }}
    .row Label {{ width: 30; padding: 1 0; }}
    .posbtn {{ min-width: 16; }}
    .gauge {{ width: {GAUGE_SLOTS + 2}; padding: 1 1 1 0; }}
    .multival {{ width: 36; padding: 1 0; }}
    .val {{ width: 4; text-align: right; padding: 1 1 1 0;
            color: {C['accent']}; text-style: bold; }}
    .hint {{ color: {C['subtext']}; }}
    .status {{ padding: 0 0 1 0; }}

    Button {{ background: transparent; border: round {C['surface']};
              color: {C['text']}; margin-right: 1; }}
    Button:hover {{ border: round {C['accent']}; color: {C['accent']};
                    background: transparent; }}
    Button:focus {{ border: round {C['accent']}; text-style: bold; }}
    Button.small {{ min-width: 5; }}
    Button.-primary {{ background: {C['accent']}; color: {C['base']};
                             border: round {C['accent']}; text-style: bold; }}
    Button.-primary:hover {{ background: {C['text']};
                                   border: round {C['text']}; color: {C['base']}; }}
    Button.-error {{ color: {DANGER}; border: round {DANGER};
                           background: transparent; }}
    Button.-error:hover {{ background: {DANGER}; color: {C['base']}; }}
    Button.-warning {{ color: {C['yellow']}; border: round {C['yellow']};
                             background: transparent; }}
    Button.-warning:hover {{ background: {C['yellow']}; color: {C['base']}; }}

    Switch {{ background: transparent; border: round {C['surface']}; }}
    Switch:focus {{ border: round {C['accent']}; background: transparent; }}
    Switch:hover {{ border: round {C['accent']}; background: transparent; }}
    Switch > .switch--slider {{ color: {C['surface']}; background: transparent; }}
    Switch.-on > .switch--slider {{ color: {C['green']}; }}

    #pane-power Button {{ width: 36; margin-bottom: 1; }}

    Footer {{ background: transparent; }}
    FooterKey {{ background: transparent; color: {C['subtext']}; }}
    FooterKey > .footer-key--key {{ color: {C['accent']}; background: transparent; }}
    FooterKey > .footer-key--description {{ color: {C['subtext']};
                                            background: transparent; }}
    """

    def __init__(self, initial_page=None):
        super().__init__(ansi_color=True)
        self._initial_page = initial_page
        self.ints = {k: hyprctl_get(v[0], {"gaps_in": 5, "gaps_out": 10,
                                           "border_size": 3, "rounding": 8}[k])
                     for k, v in INTS.items()}
        self.bools = {k: bool(hyprctl_get(v[0], 1)) for k, v in BOOLS.items()}
        # fix 2: if the live value exceeds the panel's range, stretch the range
        self.limits = {k: max(INTS[k][3], self.ints[k]) for k in INTS}
        # fix 3: per-side gaps ("5 10 5 10") are shown read-only, never saved
        self.multi = {}
        for k in ("gaps_in", "gaps_out"):
            raw = hyprctl_custom(INTS[k][0])
            if raw and len(set(raw.split())) > 1:
                self.multi[k] = raw
        # fix 10: Save only writes settings actually touched in this session
        self.dirty = set()
        self._refreshing = False
        self.widgets = widgets_conf()

    # ---------- layout ----------
    def compose(self) -> ComposeResult:
        yield Static(
            f"[bold {C['accent']}]󰒓  Hypr Settings[/]"
            f"[{C['subtext']}]   click, or ↑↓ Tab Enter — no typing needed[/]",
            id="hdr")
        with Horizontal(id="body"):
            yield ListView(
                *[ListItem(Label(f"{icon}  {name}"), id=f"nav-{pane}")
                  for pane, icon, name in NAV],
                id="sidebar")
            with ContentSwitcher(initial="pane-appearance", id="content"):
                with VerticalScroll(id="pane-appearance"):
                    with Card("Layout · applies live as you click"):
                        for key, (_, _, _, _, label) in INTS.items():
                            with Horizontal(classes="row"):
                                yield Label(label)
                                if key in self.multi:
                                    yield Static(
                                        f"[{C['subtext']}]{self.multi[key]} · "
                                        f"per-side — edit in config[/]",
                                        classes="multival")
                                else:
                                    yield stepper("-", f"dec_{key}")
                                    yield Static(gauge_markup(key, self.ints[key],
                                                              self.limits[key]),
                                                 id=f"gauge_{key}", classes="gauge")
                                    yield Static(str(self.ints[key]),
                                                 id=f"val_{key}", classes="val")
                                    yield stepper("+", f"inc_{key}")
                    with Card("Effects"):
                        for key, (_, _, label) in BOOLS.items():
                            with Horizontal(classes="row"):
                                yield Label(label)
                                yield Switch(value=self.bools[key], id=f"sw_{key}")
                    with Card("Keep your changes"):
                        with Horizontal(classes="row"):
                            yield Button("󰆓 Save (survives reboot)", id="save",
                                         variant="primary")
                            yield Button("󰑓 Revert to saved", id="revert")
                        yield Static("Live tweaks are lost at logout unless saved.",
                                     classes="hint")
                with VerticalScroll(id="pane-bar"):
                    with Card("Top bar (waybar)"):
                        with Horizontal(classes="row"):
                            yield Label("Auto-hide (reveal at top edge)")
                            yield Switch(value=autohide_on(), id="sw_autohide")
                        with Horizontal(classes="row"):
                            yield Button("󰊠 Hide / show now", id="bar_toggle")
                            yield Button("󰑓 Restart bar", id="bar_restart")
                    with Card("Layout"):
                        with Horizontal(classes="row"):
                            yield Button("󰜬 Reorder bar buttons…", id="bar_reorder")
                        yield Static("Opens the pick-and-place chooser.", classes="hint")
                with VerticalScroll(id="pane-wallpaper"):
                    with Card("Current wallpapers"):
                        yield Static("", id="wp_list", classes="status")
                    with Card("Change"):
                        with Horizontal(classes="row"):
                            yield Button("󰒝 Random wallpaper", id="wp_random")
                            yield Button("󰋩 Pick image / folder…", id="wp_pick")
                        yield Static("Every change recolors the whole desktop.\n"
                                     "This panel wears the new colors next time it opens.",
                                     classes="hint")
                with VerticalScroll(id="pane-widgets"):
                    with Card("Desktop widgets · changes apply right away"):
                        for key, label in widget_list():
                            with Horizontal(classes="row"):
                                yield Label(label)
                                yield Switch(
                                    value=self.widgets.get(key, "on") == "on",
                                    id=f"sw_w_{key}")
                        with Horizontal(classes="row"):
                            yield Button("󰀻 Choose dock apps…", id="dock_pick")
                            yield Button("＋ Add widget…", id="wg_add")
                        yield Static("Pick which apps sit on this monitor + "
                                     "workspace's dock (each monitor has its "
                                     "own sets; slide to the screen-bottom "
                                     "edge to reveal a dock).",
                                     classes="hint")
                    with Card("Layout · where each widget sits"):
                        for key, label in widget_list():
                            pos = self.widgets.get(
                                f"{key}_pos", DEFAULT_POS.get(key, ("top_left",))[0])
                            with Horizontal(classes="row"):
                                yield Label(label)
                                b = Button(pos.replace("_", " "),
                                           id=f"pos_{key}", classes="posbtn")
                                b.active_effect_duration = 0
                                yield b
                                yield stepper("-", f"xm_{key}")
                                yield Static(self.widgets.get(f"{key}_x", "0"),
                                             id=f"xv_{key}", classes="val")
                                yield stepper("+", f"xp_{key}")
                                yield stepper("-", f"ym_{key}")
                                yield Static(self.widgets.get(f"{key}_y", "0"),
                                             id=f"yv_{key}", classes="val")
                                yield stepper("+", f"yp_{key}")
                        yield Static("Click the position name to cycle corners; "
                                     "-/+ pairs nudge X then Y by 12 px. "
                                     "Widgets restart a moment after you stop.",
                                     classes="hint")
                    with Card("Style"):
                        with Horizontal(classes="row"):
                            yield Label("Card look (border + background)")
                            yield Switch(value=self.widgets["cards"] == "on",
                                         id="sw_w_cards")
                        with Horizontal(classes="row"):
                            yield Label("Color theme")
                            tb = Button(self.widgets.get("theme", "wallust"),
                                        id="theme_btn", classes="posbtn")
                            tb.active_effect_duration = 0
                            yield tb
                        yield Static("wallust follows the wallpaper; drop more "
                                     "palettes in ~/.config/conky/themes/.",
                                     classes="hint")
                    with Card("Pet 󰄛"):
                        with Horizontal(classes="row"):
                            yield Label("Show the pixel cat")
                            yield Switch(value=self.widgets["pet"] == "on",
                                         id="sw_w_pet")
                        with Horizontal(classes="row"):
                            yield Label("Clawd (Claude mascot)")
                            yield Switch(value=self.widgets["claude_pet"] == "on",
                                         id="sw_w_claude_pet")
                        with Horizontal(classes="row"):
                            yield Label("Walk above windows too")
                            yield Switch(value=self.widgets["pet_layer"] == "top",
                                         id="sw_w_petlayer")
                        yield Static("Off = the cat stays on the desktop layer, "
                                     "under your windows.", classes="hint")
                    with Card("Maintenance"):
                        with Horizontal(classes="row"):
                            yield Button("󰆾 Arrange on screen…", id="wg_arrange",
                                         variant="primary")
                            yield Button("󰑓 Restart widgets", id="wg_restart")
                        yield Static("Widgets recolor with every wallpaper change.\n"
                                     "Files live in ~/.config/conky/widgets/.",
                                     classes="hint")
                with VerticalScroll(id="pane-security"):
                    with Card("Firewall · ufw"):
                        yield Static("", id="fw_status", classes="status")
                        with Horizontal(classes="row"):
                            yield Button("󰕥 Enable / disable", id="fw_toggle")
                            yield Button("󰈙 View rules", id="fw_rules")
                    with Card("Antivirus · ClamAV"):
                        yield Static("", id="av_status", classes="status")
                        with Horizontal(classes="row"):
                            yield Button("󰃤 Scan Downloads", id="av_scan")
                            yield Button("󰖟 Open ClamTk", id="av_gui")
                            yield Button("󰚰 Update definitions", id="av_update")
                with VerticalScroll(id="pane-power"):
                    with Card("Session"):
                        yield Button("󰌾 Lock screen", id="p_lock")
                        yield Button("󰤄 Suspend (sleep)", id="p_suspend")
                    with Card("Danger zone · asks before acting", classes="danger"):
                        yield Button("󰍃 Logout", id="p_logout", variant="warning")
                        yield Button("󰜉 Reboot", id="p_reboot", variant="warning")
                        yield Button("⏻ Shutdown", id="p_shutdown", variant="error")
        yield Footer()

    def on_mount(self):
        # fix 4: a leftover page-note from a previous run must not hijack us
        if not self._initial_page:
            PAGE_FILE.unlink(missing_ok=True)
        self.refresh_security()
        self.refresh_wallpapers()
        if self._initial_page:
            self.goto_page(self._initial_page)
        self._poll_tick = 0
        self.set_interval(0.5, self._poll_page_file)

    def goto_page(self, page):
        names = [pane for pane, _, _ in NAV]
        if page in names:
            self.query_one("#sidebar", ListView).index = names.index(page)

    def _poll_page_file(self):
        try:
            if PAGE_FILE.exists():
                page = PAGE_FILE.read_text().strip()
                PAGE_FILE.unlink()
                self.goto_page(page)
        except OSError:
            pass
        # fix 6: re-check auto-hide state every 2s while the Bar page shows
        self._poll_tick += 1
        if self._poll_tick % 4 == 0 and                 self.query_one("#content", ContentSwitcher).current == "pane-bar":
            self._refreshing = True
            try:
                self.query_one("#sw_autohide", Switch).value = autohide_on()
            finally:
                self._refreshing = False

    # ---------- navigation ----------
    def action_nav(self, idx: int):
        self.query_one("#sidebar", ListView).index = idx

    def on_list_view_highlighted(self, event: ListView.Highlighted):
        if event.item is None:
            return
        pane = "pane-" + (event.item.id or "").removeprefix("nav-")
        self.query_one("#content", ContentSwitcher).current = pane
        self.refresh_security()
        self.refresh_wallpapers()
        self._refreshing = True
        try:
            self.query_one("#sw_autohide", Switch).value = autohide_on()
        finally:
            self._refreshing = False

    # ---------- dynamic labels ----------
    def refresh_security(self):
        fw = firewall_on()
        self.query_one("#fw_status", Static).update(dot(
            fw,
            "Firewall is ON — incoming connections blocked",
            "Firewall is OFF — click Enable to protect this machine"))
        self.query_one("#fw_toggle", Button).label = \
            "󰕥 Disable firewall" if fw else "󰕥 Enable firewall"
        av = service_active("clamav-daemon")
        self.query_one("#av_status", Static).update(dot(
            av,
            "Scanner daemon running — scans are fast",
            "Scanner daemon not running — scans still work, just slower"))

    def refresh_wallpapers(self):
        pairs = current_wallpapers()
        text = "\n".join(f"[{C['accent']}]{m}[/]  →  {p}" for m, p in pairs) \
               or "(none set)"
        self.query_one("#wp_list", Static).update(text)

    # ---------- events ----------
    def on_switch_changed(self, event: Switch.Changed):
        if self._refreshing:
            return
        sid = event.switch.id or ""
        if sid == "sw_autohide":
            if event.value and not autohide_on():
                launch(str(HOME / ".local/bin/waybar-autohide.sh"))
            elif not event.value and autohide_on():
                subprocess.run(["pkill", "-f", "waybar-autohide.sh"], capture_output=True)
            self.notify("Auto-hide " + ("ON — move mouse to top edge to reveal"
                                        if event.value else "OFF — bar always visible"))
            return
        if sid.startswith("sw_w_"):
            wkey = sid.removeprefix("sw_w_")
            if wkey == "petlayer":
                widgets_conf_set("pet_layer", "top" if event.value else "bottom")
            else:
                widgets_conf_set(wkey, "on" if event.value else "off")
            self.widgets = widgets_conf()
            self.schedule_widget_restart()
            self.notify("Widgets updated")
            return
        key = sid.removeprefix("sw_")
        if key in BOOLS:
            self.bools[key] = event.value
            self.dirty.add(key)
            hyprctl_set(BOOLS[key][0], 1 if event.value else 0)

    def schedule_widget_restart(self):
        if getattr(self, "_wg_timer", None):
            self._wg_timer.stop()
        self._wg_timer = self.set_timer(
            1.2, lambda: launch(str(HOME / ".local/bin/desktop-widgets.sh"),
                                "restart"))

    def on_button_pressed(self, event: Button.Pressed):
        bid = event.button.id or ""
        if bid == "theme_btn":
            themes = theme_list()
            cur = self.widgets.get("theme", "wallust")
            nxt = themes[(themes.index(cur) + 1) % len(themes)] \
                if cur in themes else themes[0]
            widgets_conf_set("theme", nxt)
            self.widgets = widgets_conf()
            event.button.label = nxt
            self.schedule_widget_restart()
            return
        if bid.startswith("pos_"):
            key = bid.removeprefix("pos_")
            # re-read before computing: hypr-arrange may have saved since
            # this page was built — stepping from a stale cache would revert it
            self.widgets = widgets_conf()
            cur = self.widgets.get(f"{key}_pos",
                                   DEFAULT_POS.get(key, ("top_left",))[0])
            nxt = POS_CYCLE[(POS_CYCLE.index(cur) + 1) % len(POS_CYCLE)] \
                if cur in POS_CYCLE else POS_CYCLE[0]
            if f"{key}_col" in self.widgets:
                # cycling the anchor un-grids the card — the saved cell
                # would otherwise shadow the new pos into a silent no-op
                _conf_set({f"{key}_pos": nxt},
                          delete=[f"{key}_col", f"{key}_row"])
                self.widgets = widgets_conf()
            else:
                self.widgets_layout_set(key, "pos", nxt)
            event.button.label = nxt.replace("_", " ")
            self.schedule_widget_restart()
            return
        if bid.startswith(("xm_", "xp_", "ym_", "yp_")):
            axis, sign = bid[0], (1 if bid[1] == "p" else -1)
            key = bid[3:]
            self.widgets = widgets_conf()      # fresh read (see pos_ above)
            if f"{key}_col" in self.widgets:
                # grid-placed card: legacy _x/_y is SHADOWED by the cell —
                # nudge the cell instead of writing a silent no-op
                gk = f"{key}_col" if axis == "x" else f"{key}_row"
                val = max(0, int(self.widgets.get(gk, "0") or 0) + sign)
                _conf_set({gk: str(val)})
                self.widgets = widgets_conf()
                self.query_one(f"#{axis}v_{key}", Static).update(
                    f"cell {val}")
            else:
                ck = f"{key}_{axis}"
                val = max(0, int(self.widgets.get(ck, "0") or 0) + sign * 12)
                self.widgets_layout_set(key, axis, str(val))
                self.query_one(f"#{axis}v_{key}", Static).update(str(val))
            self.schedule_widget_restart()
            return
        if bid.startswith(("inc_", "dec_")):
            key = bid[4:]
            opt, _, lo, _, _ = INTS[key]
            hi = self.limits[key]
            step = 1 if bid.startswith("inc_") else -1
            self.ints[key] = max(lo, min(hi, self.ints[key] + step))
            self.dirty.add(key)
            self.query_one(f"#val_{key}", Static).update(str(self.ints[key]))
            self.query_one(f"#gauge_{key}", Static).update(
                gauge_markup(key, self.ints[key], hi))
            hyprctl_set(opt, self.ints[key])
            return
        actions = {
            "save": self.do_save, "revert": self.do_revert,
            "bar_toggle": lambda: launch(str(HOME / ".local/bin/bar-toggle.sh")),
            "bar_restart": lambda: launch(TOOLS, "restart-bar"),
            "bar_reorder": lambda: launch(TOOLS, "reorder"),
            "wp_random": lambda: launch(str(HOME / ".local/bin/wallpaper.sh")),
            "wp_pick": lambda: launch(TOOLS, "wallpaper"),
            "fw_toggle": self.do_fw_toggle,
            "fw_rules": lambda: launch("kitty", "--class", "floatterm", "--title",
                                       "Firewall rules", "bash", "-c",
                                       "pkexec ufw status verbose; echo; read -rp 'Enter to close…'"),
            "av_scan": lambda: launch(TOOLS, "clamav"),
            "av_gui": self.do_open_clamtk,
            "av_update": lambda: launch("kitty", "--class", "floatterm", "--title",
                                        "Update virus definitions", "bash", "-c",
                                        "pkexec bash -c 'systemctl stop clamav-freshclam; freshclam; systemctl start clamav-freshclam'; echo; read -rp 'Enter to close…'"),
            "p_lock": lambda: launch("hyprlock"),
            "p_suspend": lambda: launch("systemctl", "suspend"),
            "wg_restart": lambda: launch(
                str(HOME / ".local/bin/desktop-widgets.sh"), "restart"),
            "wg_add": lambda: launch(
                str(HOME / ".local/bin/hypr-widgetpicker")),
            "dock_pick": lambda: launch(
                str(HOME / ".local/bin/hypr-appdock"), "--picker"),
            "wg_arrange": lambda: launch(
                str(HOME / ".local/bin/hypr-arrange")),
        }
        if bid in actions:
            actions[bid]()
            if bid in ("wp_random", "wp_pick"):
                self.set_timer(4, self.refresh_wallpapers)
            return
        power = {"p_logout": ("log out", ["hyprctl", "dispatch", "exit"]),
                 "p_reboot": ("reboot", ["systemctl", "reboot"]),
                 "p_shutdown": ("shut down", ["systemctl", "poweroff"])}
        if bid in power:
            name, cmd = power[bid]
            self.push_screen(Confirm(f"Really {name}?"),
                             lambda ok, c=cmd: launch(*c) if ok else None)

    # ---------- actions ----------
    def widgets_layout_set(self, key, suffix, val):
        """Write a layout key; for 'apps' also write through to any existing
        per-monitor dock_<MON>_* keys so the control keeps moving every dock
        once monitors have their own placement (they shadow the legacy key)."""
        changes = {f"{key}_{suffix}": val}
        if key == "apps":
            for k in widgets_conf():
                if re.fullmatch(rf"dock_\w+_{suffix}", k):
                    changes[k] = val
        _conf_set(changes)
        self.widgets = widgets_conf()

    def do_save(self):
        values, names = {}, {}
        for key in self.dirty:
            if key in INTS and key not in self.multi:
                _, path, _, _, label = INTS[key]
                values[path] = str(self.ints[key])
                names[path] = label
            elif key in BOOLS:
                opt, path, label = BOOLS[key]
                values[path] = "true" if self.bools[key] else "false"
                names[path] = label
        self.last_save_report = None
        if not values:
            self.notify("Nothing changed since opening — nothing to save")
            return
        try:
            written = save_to_config(values)
        except Exception as e:
            self.notify(f"Save failed: {e}", severity="error")
            return
        missing = set(values) - written
        self.last_save_report = {"written": written, "missing": missing}
        if missing:
            miss = ", ".join(names[p] for p in missing)
            self.notify(f"⚠ NOT saved: {miss} — its line is missing from "
                        f"hyprland.conf", severity="warning", timeout=10)
        if written:
            self.dirty = {k for k in self.dirty
                          if (INTS[k][1] if k in INTS else BOOLS[k][1])
                          not in written}
            self.notify(f"Saved {len(written)} setting(s) — they survive reboot")

    def do_revert(self):
        if not DRY:
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        self.dirty.clear()
        for key, spec in INTS.items():
            if key in self.multi:
                continue
            self.ints[key] = hyprctl_get(spec[0], self.ints[key])
            self.limits[key] = max(INTS[key][3], self.ints[key])
            self.query_one(f"#val_{key}", Static).update(str(self.ints[key]))
            self.query_one(f"#gauge_{key}", Static).update(
                gauge_markup(key, self.ints[key], self.limits[key]))
        self._refreshing = True
        try:
            for key, spec in BOOLS.items():
                self.bools[key] = bool(hyprctl_get(spec[0], self.bools[key]))
                self.query_one(f"#sw_{key}", Switch).value = self.bools[key]
        finally:
            self._refreshing = False
        self.notify("Reverted to the saved config")

    def do_open_clamtk(self):
        if shutil.which("clamtk"):
            launch("clamtk")
        else:
            self.notify("ClamTk is not installed — use the Tools menu to "
                        "install it, or: sudo apt install clamtk",
                        severity="error")

    def do_fw_toggle(self):
        if not shutil.which("ufw"):
            self.notify("ufw is not installed — run: sudo apt install ufw",
                        severity="error")
            return
        verb = "disable" if firewall_on() else "enable"
        if DRY:
            launch("pkexec", "ufw", verb)
            return

        def work():
            r = subprocess.run(["pkexec", "ufw", verb],
                               capture_output=True, text=True)
            if r.returncode in (126, 127):   # password prompt dismissed
                self.call_from_thread(self.notify,
                                      "Cancelled — no password given",
                                      severity="warning")
            elif r.returncode != 0:
                err = (r.stderr or r.stdout).strip()[:120] or "unknown error"
                self.call_from_thread(self.notify, f"ufw {verb} failed: {err}",
                                      severity="error")
            self.call_from_thread(self.refresh_security)

        self.run_worker(work, thread=True)
        self.set_timer(10, self.refresh_security)


if __name__ == "__main__":
    HyprSettings(sys.argv[1] if len(sys.argv) > 1 else None).run()
