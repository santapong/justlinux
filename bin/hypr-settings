# 'office' and 'viz' predate the picker: office's on/off toggle already lives
# in widgets.conf as claude_office= (not office=), and viz defaults OFF —
# it's a hotkey-only toy, never autostarted just by appearing in this list.
ONOFF_KEY = {"office": "claude_office"}

# surfaces whose LAYER (what they sit in front of) is user-settable. A
# layer is fixed when the surface maps, so changing it restarts that one
# widget — unlike a move, which SIGUSR1 does live.
LAYER_KEYS = ("office", "viz")
LAYER_DEFAULT = {"office": "bottom", "viz": "bottom"}
LAYER_CYCLE = ["bottom", "top", "overlay"]
ONOFF_DEFAULT = {"viz": "off"}

# office / viz are hyprdesk widget-kind surfaces, not conky — SIGUSR1 makes
# them re-read widgets.conf and reposition IN PLACE, same live-reload path
# hypr-arrange uses, so a drag-free position cycle doesn't drop viz's audio
# capture or the office's worker scan. -xf (exact, full cmdline) is
# mandatory — a loose pattern has killed the invoking shell in this fleet.
LIVE_SIGNAL_PROC = {"office": "hypr-claude-office", "viz": "hypr-viz"}


def signal_widget(name):
    proc = LIVE_SIGNAL_PROC.get(name)
    if not proc:
        return False
    try:
        # the widget may be the python script or the rust binary — try both
        # exact cmdline forms (-xf stays mandatory, see comment above)
        for cmdline in (f"python3 {HOME}/.local/bin/{proc}",
                        f"{HOME}/.local/bin/{proc}"):
            r = subprocess.run(["pkill", "-USR1", "-xf", cmdline],
                               capture_output=True, timeout=3)
            if r.returncode == 0:
                return True
        return False
    except Exception:
        return False


def theme_list():
    """wallust (follows the wallpaper) + every palette in themes/."""
    themes = sorted(p.stem for p in
                    (HOME / ".config/conky/themes").glob("*.lua"))
    return ["wallust"] + themes


def widget_list():
    """Every card INSTANCE (widgets.conf inst_* keys, labels from the
    hyprcard templates) + the app dock — drop a .toml in
    ~/.config/hyprcard/templates/ and add instances via the picker.
    Falls back to the conky .conf glob if no instances exist yet."""
    try:
        from hyprdesk import cardspec
        from hyprdesk.theme import conf as _hconf
        c = _hconf()
        tmpls = cardspec.load_templates()
        insts = cardspec.instances(c)
        if insts:
            out = []
            for inst_id, tname in insts:
                t = tmpls.get(tname)
                label = t.label if isinstance(t, cardspec.Template) \
                    else f"{tname} (broken template)"
                if inst_id != tname:
                    label = f"{label} · {inst_id}"
                out.append((inst_id, label))
            out.append(("apps", WIDGET_LABELS["apps"]))
            out.append(("office", WIDGET_LABELS["office"]))
            out.append(("viz", WIDGET_LABELS["viz"]))
            return sorted(out, key=lambda kv: kv[1].lower())
    except Exception:
        pass
    names = sorted(p.stem for p in (HOME / ".config/conky/widgets").glob("*.conf")
                   if p.stem != "apps" and re.fullmatch(r"[A-Za-z][\w-]*", p.stem))
    names.append("apps")
    names.append("office")
    names.append("viz")
    return [(n, WIDGET_LABELS.get(n, f"{n.title()} (custom)")) for n in names]


def widgets_conf():
    d = {"clock": "on", "stats": "on", "calendar": "on", "claude": "on",
         "apps": "on", "pet": "on", "pet_layer": "bottom", "cards": "on",
         "claude_pet": "on", "devgit": "on", "robotics": "on",
         "claude_office": "on", "viz": "off"}
    d["theme"] = "wallust"
    for name, (pos, x, y) in DEFAULT_POS.items():
        d[f"{name}_pos"], d[f"{name}_x"], d[f"{name}_y"] = pos, str(x), str(y)
    try:
        for line in WIDGETS_CONF.read_text().splitlines():
            m = re.match(r"^(\w+)\s*=\s*([-\w.,]+)", line)
            if m:
                d[m.group(1)] = m.group(2)
    except OSError:
        pass
    return d


def widgets_conf_set(key, val):
    # atomic + lock-guarded — no longer races hypr-arrange / the card host
    _conf_set({key: val})

GAUGE_SLOTS = 12


def read_colors():
    """The CARD palette, not waybar's raw wallust slots.

    Parsing ~/.config/waybar/colors.css is the obvious move and it is wrong:
    those are wallust's UNPINNED ansi slots whose names lie. On the current
    wallpaper @red is #494949 (grey) and @yellow #8D8D8D — a danger button
    inked in them reads as "disabled", not "destructive". hyprdesk.colors()
    is the same wallpaper-driven palette the cards use, with good/bad/warn
    PINNED to readable constants, so status stays legible whatever the
    wallpaper does.
    """
    fallback = {"base": "#1e1e2e", "surface": "#45475a", "text": "#cdd6f4",
                "subtext": "#a6adc8", "accent": "#89b4fa", "title": "#b4befe",
                "red": "#f38ba8", "green": "#a6e3a1", "yellow": "#f9e2af"}
    try:
        from hyprdesk import colors
        p = colors()
        # accent = interactive (focus, hover, selection); title = accent2.
        # muted is a SURFACE colour — borders and troughs only, never text.
        return {"base": p["bg"], "surface": p["muted"], "text": p["fg"],
                "subtext": p["sub"], "accent": p["accent"],
                "title": p["accent2"], "red": p["bad"], "green": p["good"],
                "yellow": p["warn"]}
    except Exception:
        return fallback


# ---------------- MCP (Claude Code) ----------------
# `claude mcp list` health-checks every configured server over the network,
# so it can take ~20s — callers run it in a worker thread, never on the UI
# loop. Servers named "claude.ai …" are managed by the account at claude.ai
# and can only be SHOWN here; only locally-added ones can be removed.
MCP_LINE = re.compile(
    r"^(?P<name>.+?):\s+(?P<target>.+?)\s+-\s+"
    r"(?P<glyph>[✔✘✗!⏸])\s*(?P<note>.*)$")


def _esc(s):
    """Rich-markup-escape a string that came from the outside world."""
    return str(s).replace("[", r"\[")


def _col(text, w):
    """Fixed-width column. Server names and URLs vary wildly in length —
    left ragged they wrap and orphan the status note on its own line."""
    t = str(text)
    return (t[:w - 1] + "…") if len(t) > w else t.ljust(w)


def mcp_list():
    """[(name, target, state, note, managed)] from `claude mcp list`.
    state: good | warn | bad. Raises RuntimeError with a human message."""
    if DRY:
        return [("claude.ai Figma", "https://mcp.figma.com/mcp",
                 "good", "Connected", True),
                ("local-probe", "npx probe-mcp", "bad", "Failed", False)]
    try:
        r = subprocess.run(["claude", "mcp", "list"], capture_output=True,
                           text=True, timeout=90)
    except FileNotFoundError:
        raise RuntimeError("claude CLI not found on PATH")
    except subprocess.TimeoutExpired:
        raise RuntimeError("claude mcp list timed out (network?)")
    if r.returncode != 0:
        msg = (r.stderr or r.stdout or "claude mcp list failed").strip()
        raise RuntimeError(msg.splitlines()[-1][:120] if msg else "failed")
    out = []
    for line in r.stdout.splitlines():
        m = MCP_LINE.match(line.strip())
        if not m:
            continue                    # banner / blank / progress lines
        glyph = m.group("glyph")
        state = "good" if glyph == "✔" else \
            ("warn" if glyph in "!⏸" else "bad")
        name = m.group("name").strip()
        out.append((name, m.group("target").strip(), state,
                    m.group("note").strip(), name.startswith("claude.ai")))
    return out



# ---------- Claude Code: skills, env, sessions ----------
CLAUDE_HOME = HOME / ".claude"
CLAUDE_SETTINGS = CLAUDE_HOME / "settings.json"
# (label, dir) — personal skills, then the ones this repo ships
SKILL_SOURCES = [("personal", CLAUDE_HOME / "skills"),
                 ("repo", HOME / "hyprland-dots/claude/skills"),
                 ("hermes", HOME / ".hermes/skills")]   # agentskills.io format
SECRET_KEY_RE = re.compile(r"KEY|TOKEN|SECRET|PASS|CREDENTIAL", re.I)
DISABLED = ".disabled"


def skill_proposals():
    """[(name, source, proposed_path, target_dir)] — files the lesson-proposer wrote."""
    out = []
    for src, base in SKILL_SOURCES:
        if not base.is_dir():
            continue
        for d in base.iterdir():
            p = d / "proposed/SKILL.md"
            if d.is_dir() and p.is_file():
                out.append((d.name, src, p, d))
        newdir = base / "_proposed"
        if newdir.is_dir():
            for d in newdir.iterdir():
                p = d / "SKILL.md"
                if d.is_dir() and p.is_file():
                    out.append((d.name, src, p, base / d.name))
    return out


def skill_accept(prop, target):
    """Replace/create the live SKILL.md; the old one stays as SKILL.md.bak."""
    target.mkdir(parents=True, exist_ok=True)
    live = target / "SKILL.md"
    if live.exists():
        shutil.copy2(live, target / "SKILL.md.bak")
    shutil.move(str(prop), str(live))
    _prune_proposal_dir(prop.parent)


def skill_reject(prop):
    prop.unlink(missing_ok=True)
    _prune_proposal_dir(prop.parent)


def _prune_proposal_dir(d):
    try:
        if d.is_dir() and not any(d.iterdir()):
            d.rmdir()
            if d.name != "proposed" and d.parent.name == "_proposed" and not any(d.parent.iterdir()):
                d.parent.rmdir()
    except OSError:
        pass


def skill_list():
    """[(name, source, description, enabled, path)] — one row per skill dir.

    Only the first 1 KB of each SKILL.md is read (frontmatter lives there);
    27 personal skills must not cost 27 full file reads on every page show.
    A dir renamed to ``<name>.disabled`` is invisible to Claude Code, which
    only loads dirs whose SKILL.md sits at ``skills/<name>/SKILL.md``.
    """
    rows = []
    for src, base in SKILL_SOURCES:
        if not base.is_dir():
            continue
        for d in sorted(base.iterdir()):
            if not d.is_dir():
                continue
            md = d / "SKILL.md"
            if not md.is_file():
                continue
            enabled = not d.name.endswith(DISABLED)
            name = d.name.removesuffix(DISABLED)
            desc = ""
            try:
                with open(md, encoding="utf-8", errors="replace") as fh:
                    head = fh.read(1024)
                m = re.search(r"^description:\s*(.+)$", head, re.M)
                if m:
                    desc = m.group(1).strip().strip("\"'")
            except OSError:
                desc = "(unreadable)"
            rows.append((name, src, desc, enabled, d))
    return rows


def skill_toggle(path):
    """Enable/disable by renaming the dir; returns the new path."""
    p = Path(path)
    new = p.with_name(p.name.removesuffix(DISABLED)) if p.name.endswith(DISABLED) \
        else p.with_name(p.name + DISABLED)
    if new.exists():
        raise FileExistsError(new.name)
    p.rename(new)
    return new


SKILL_TEMPLATE = """---
name: {name}
description: TODO one line — what it does and WHEN to use it (this line is the trigger).
---

# {name}

## When to use

## Steps

## Traps
"""


def skill_new(name):
    d = SKILL_SOURCES[0][1] / name
    if d.exists():
        raise FileExistsError(name)
    d.mkdir(parents=True)
    (d / "SKILL.md").write_text(SKILL_TEMPLATE.format(name=name))
    return d / "SKILL.md"


def claude_settings():
    try:
        return json.loads(CLAUDE_SETTINGS.read_text())
    except (OSError, ValueError):
        return {}


def claude_env_set(key, value=None, delete=False):
    def mutate(obj):
        env = obj.setdefault("env", {})
        if delete:
            env.pop(key, None)
        else:
            env[key] = value
        if not env:
            obj.pop("env", None)
    _json_set(CLAUDE_SETTINGS, mutate)


def session_stats():
    """(projects, transcripts, total bytes, oldest mtime) of ~/.claude/projects."""
    base = CLAUDE_HOME / "projects"
    n_proj = n_tr = size = 0
    oldest = None
    if base.is_dir():
        for proj in base.iterdir():
            if not proj.is_dir():
                continue
            n_proj += 1
            for f in proj.glob("*.jsonl"):
                try:
                    st = f.stat()
                except OSError:
                    continue
                n_tr += 1
                size += st.st_size
                oldest = st.st_mtime if oldest is None else min(oldest, st.st_mtime)
    return n_proj, n_tr, size, oldest


VOICE_MODEL = HOME / ".local/share/hyprdesk/voice/hey_draven.onnx"
VOICE_UNIT = "hypr-voice.service"


def voice_sources():
    """[(id, name)] microphones from `wpctl status` (Sources block)."""
    try:
        out = subprocess.run(["wpctl", "status"], capture_output=True, text=True,
                             timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    rows, in_src = [], False
    for line in out.splitlines():
        if "Sources:" in line:
            in_src = True
            continue
        if in_src:
            m = re.search(r"(\d+)\.\s+(.+?)\s+\[vol", line)
            if m:
                rows.append((m.group(1), m.group(2).strip()))
            elif line.strip(" │├└─") == "" or "Filters" in line or "Streams" in line:
                if rows:
                    break
    return rows


def voice_unit_active():
    return subprocess.run(["systemctl", "--user", "is-active", "--quiet", VOICE_UNIT],
                          capture_output=True).returncode == 0


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.0f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


def hyprctl_get(option, default):
    """Read a live option value; returns int (bools are 0/1)."""
    if DRY or not shutil.which("hyprctl"):
        return default
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", option],
                             capture_output=True, text=True, timeout=1).stdout
        d = json.loads(out)
        if "int" in d:
            return int(d["int"])
        if "custom" in d:  # gaps report as "N N N N"
            return int(str(d["custom"]).split()[0])
    except Exception:
        pass
    return default


def hyprctl_custom(option):
    """Raw 'custom' string for options like gaps ('5 10 5 10'), or None."""
    if DRY or not shutil.which("hyprctl"):
        return None
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", option],
                             capture_output=True, text=True, timeout=1).stdout
        d = json.loads(out)
        return str(d["custom"]).strip() if "custom" in d else None
    except Exception:
        return None


def hyprctl_set(option, value):
    if DRY:
        return
    subprocess.run(["hyprctl", "keyword", option, str(value)],
                   capture_output=True, text=True)


def launch(*cmd):
    """Start a detached external program (rofi pickers, GUIs, pkexec…)."""
    if DRY:
        return
    subprocess.Popen(cmd, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def save_to_config(values):
    """Rewrite `key = value` lines in hyprland.conf, matched by block path.

    values: {("general","gaps_in"): "5", ("decoration","blur","enabled"): "true", ...}
    """
    lines = CONF.read_text().splitlines(keepends=True)
    stack, out, written = [], [], set()
    for line in lines:
        stripped = line.strip()
        if re.match(r"^[\w.-]+\s*\{", stripped):
            stack.append(stripped.split("{")[0].strip())
        elif stripped.startswith("}"):
            if stack:
                stack.pop()
        else:
            m = re.match(r"^(\s*)([\w.]+)\s*=\s*(.*?)(\s*#.*)?$", line.rstrip("\n"))
            if m and tuple(stack) + (m.group(2),) in values:
                path = tuple(stack) + (m.group(2),)
                comment = m.group(4) or ""
                line = f"{m.group(1)}{m.group(2)} = {values[path]}{comment}\n"
                written.add(path)
        out.append(line)
    CONF.write_text("".join(out))
    return written


def firewall_on():
    try:
        return "ENABLED=yes" in Path("/etc/ufw/ufw.conf").read_text()
    except OSError:
        return False


def service_active(name):
    if DRY:
        return False
    return subprocess.run(["systemctl", "-q", "is-active", name],
                          capture_output=True).returncode == 0


def autohide_on():
    if DRY:
        return False
    return subprocess.run(["pgrep", "-xf",
                           f"python3 {HOME}/.local/bin/waybar-autohide.sh"],
                          capture_output=True).returncode == 0


def current_wallpapers():
    pairs, mon = [], None
    try:
        for line in HYPRPAPER.read_text().splitlines():
            line = line.strip()
            if line.startswith("monitor"):
                mon = line.split("=", 1)[1].strip() or "(all)"
            elif line.startswith("path") and mon is not None:
                pairs.append((mon, Path(line.split("=", 1)[1].strip()).name))
                mon = None
    except OSError:
        pass
    return pairs


C = read_colors()

# Destructive actions must READ as red. C["red"] is now the PINNED bad ink,
# so no luminance guessing is needed — kept as a name because the danger
# zone reads better spelled out at the ~10 call sites below.
DANGER = C["red"]


def stepper(label, bid):
    """A +/- button that registers every click, even rapid ones.

    Button ignores clicks during its 0.2 s press-flash animation, which
    swallows every second click when the user hammers +. Disable the flash.
    """
    b = Button(label, id=bid, classes="small")
    b.active_effect_duration = 0
    return b


def gauge_markup(key, val, hi=None):
    _, _, lo, default_hi, _ = INTS[key]
    hi = hi or default_hi
    filled = max(0, min(GAUGE_SLOTS, round((val - lo) / (hi - lo) * GAUGE_SLOTS)))
    return (f"[{C['accent']}]{'█' * filled}[/]"
            f"[{C['surface']}]{'░' * (GAUGE_SLOTS - filled)}[/]")


def dot(ok, text_on, text_off):
    return (f"[{C['green']}]●[/] {text_on}" if ok
            else f"[{DANGER}]●[/] {text_off}")


class Card(Vertical):
    """A titled, rounded-border group of related controls."""

    def __init__(self, title, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.border_title = f" {title} "


class Confirm(ModalScreen[bool]):
    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False),
                Binding("q", "cancel", "Cancel", show=False)]
    CSS = f"""
    Confirm {{ align: center middle; background: {C['base']} 60%; }}
    #dlg {{ width: 56; height: auto; padding: 1 2; background: {C['base']};
           border: round {DANGER}; }}
    #question {{ padding: 1; text-align: center; width: 100%; }}
    #btns {{ height: 3; align-horizontal: center; }}
    #btns Button {{ margin: 0 2; }}
    """

    def __init__(self, question):
        super().__init__()
        self.question = question

    def compose(self) -> ComposeResult:
        with Vertical(id="dlg"):
            yield Label(self.question, id="question")
            with Horizontal(id="btns"):
                yield Button("No — stay", id="no", variant="primary")
                yield Button("Yes", id="yes", variant="error")

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.dismiss(event.button.id == "yes")

    def action_cancel(self) -> None:
        self.dismiss(False)


class WifiJoin(ModalScreen):
    """Password prompt for joining a secured network, as a POPUP.

    It floated as a row at the bottom of the card first, which had two
    problems the modal solves: on a page grown tall with VPN and Bluetooth
    cards the row could appear off-screen (a prompt you have to scroll to
    find is a prompt you miss), and it competed with the list instead of
    focusing the one decision. The dialog names the network, shows what
    kind of lock it wears and how strong it is — the facts you compare
    against the router's sticker before committing a password.

    Dismisses with the password string, or None on cancel. Enter joins,
    Escape cancels, and the 󰅌 pastes — passwords live in managers, and
    Ctrl+V is the terminal's key, not the app's.
    """

    BINDINGS = [Binding("escape", "cancel", "Cancel", show=False)]
    CSS = f"""
    WifiJoin {{ align: center middle; background: {C['base']} 60%; }}
    #wj-box {{ width: 62; height: auto; padding: 1 2;
               background: {C['base']}; border: round {C['surface']}; }}
    #wj-title {{ text-style: bold; }}
    #wj-info {{ color: {C['subtext']}; padding: 0 0 1 0; }}
    #wj-row {{ height: 3; }}
    #wj-row Label {{ padding: 1 2 0 0; }}
    /* the Input defaults to full width and shoved the paste button clean
       off the dialog's right edge — seen in a screenshot, not a review */
    #wj-row Input {{ width: 1fr; }}
    #wj-row Button {{ margin-left: 1; }}
    #wj-btns {{ height: 3; align-horizontal: right; }}
    #wj-btns Button {{ margin-left: 2; }}
    """

    def __init__(self, ssid, sig, sec):
        super().__init__()
        self._ssid, self._sig, self._sec = ssid, sig, sec

    def compose(self) -> ComposeResult:
        from rich.markup import escape
        bars = ("▂▄▆█" if self._sig >= 75 else "▂▄▆" if self._sig >= 50
                else "▂▄" if self._sig >= 25 else "▂")
        with Vertical(id="wj-box"):
            yield Static(f"󰤨 Join [{C['accent']}]{escape(self._ssid)}[/]",
                         id="wj-title")
            yield Static(f"󰌾 {escape(self._sec or 'secured')} · "
                         f"[{C['accent']}]{bars}[/] {self._sig}% signal",
                         id="wj-info")
            with Horizontal(id="wj-row"):
                yield Label("Password")
                yield Input(password=True, placeholder="from the router "
                            "sticker, or whoever runs the network",
                            id="wj_pw")
                yield Button("󰅌", id="wj_paste", classes="small")
            with Horizontal(id="wj-btns"):
                yield Button("Cancel", id="wj_cancel")
                yield Button("Join", id="wj_join", variant="primary")

    def on_mount(self):
        self.query_one("#wj_pw", Input).focus()

    def _submit(self):
        pw = self.query_one("#wj_pw", Input).value
        self.dismiss(pw if pw else None)

    def on_button_pressed(self, event: Button.Pressed) -> None:
        bid = event.button.id or ""
        if bid == "wj_join":
            self._submit()
        elif bid == "wj_cancel":
            self.dismiss(None)
        elif bid == "wj_paste":
            try:
                r = subprocess.run(["wl-paste", "-n"], capture_output=True,
                                   text=True, timeout=5)
                self.query_one("#wj_pw", Input).value = r.stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                pass
        event.stop()

    def on_input_submitted(self, event) -> None:
        self._submit()
        event.stop()

    def action_cancel(self) -> None:
        self.dismiss(None)


class LazyPane(VerticalScroll):
    """A settings pane whose contents are built when it is mounted.

    Textual's `with Card(...)` blocks only work inside a compose() call —
    they push onto the app's compose stack — so a pane body cannot simply
    be called later and mounted. Wrapping it in a widget whose compose()
    yields it puts the body back inside that machinery, and mounting the
    pane itself late is what makes it lazy.

    Subclassing VerticalScroll rather than wrapping one keeps the DOM
    identical: Textual matches a CSS type selector against the whole MRO,
    so `#content VerticalScroll` still applies, and no extra level appears
    between the pane and its cards.
    """

    def __init__(self, build, **kwargs):
        super().__init__(**kwargs)
        self._build = build

    def compose(self) -> ComposeResult:
        yield from self._build()


