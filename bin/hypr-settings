    def _build_network(self):
        """Body of the network pane, built on first show. Every nmcli call
        runs in a thread worker — a scan blocks for seconds and this app's
        rule is that the UI never does."""
        with Card("Connection"):
            yield Static("looking…", id="net_status", classes="status")
            with Horizontal(classes="row"):
                yield Label("Wi-Fi radio")
                yield Switch(value=True, id="sw_wifi")
            with Horizontal(classes="row"):
                yield Button("󰑓 Rescan", id="net_rescan")
                yield Button("󰒓 Advanced editor…", id="net_editor")
        with Card("Wi-Fi networks · click one to connect"):
            yield Static("", id="net_hint2", classes="status")
            yield Vertical(id="net_rows")
            yield Static(
                "Known networks join on one click. A new secured one opens "
                "a dialog naming it — the password is checked by the "
                "router, so a typo fails visibly instead of silently. "
                "Hidden SSIDs and the full profile list live in the "
                "Advanced editor.",
                classes="hint")
        with Card("VPN"):
            yield Static("", id="vpn_status", classes="status")
            yield Vertical(id="vpn_rows")
            with Horizontal(classes="row"):
                yield Label("Config file")
                yield Input(placeholder="path to a .ovpn or WireGuard .conf",
                            id="vpn_path")
                yield Button("󰅌", id="vpn_paste", classes="small")
            with Horizontal(classes="row"):
                yield Button("󰩍 Import", id="vpn_import", variant="primary")
            yield Static(
                "Joining a VPN means importing the file its provider gave "
                "you — .ovpn for OpenVPN, .conf for WireGuard. It appears "
                "above with a connect button. Building one from scratch "
                "(keys, routes) is the Advanced editor's job.",
                classes="hint")
        with Card("Bluetooth"):
            yield Static("looking…", id="bt_status", classes="status")
            with Horizontal(classes="row", id="bt_btns"):
                yield Button("󰂯 Open Blueman", id="bt_gui")

    def _build_power(self):
        """Body of the power pane, moved verbatim out of
        compose() so it is built on first show."""
        with Card("Session"):
            yield Button("󰌾 Lock screen", id="p_lock")
            yield Button("󰤄 Suspend (sleep)", id="p_suspend")
        with Card("Danger zone · asks before acting", classes="danger"):
            yield Button("󰍃 Logout", id="p_logout", variant="warning")
            yield Button("󰜉 Reboot", id="p_reboot", variant="warning")
            yield Button("⏻ Shutdown", id="p_shutdown", variant="error")

    def on_mount(self):
        # fix 4: a leftover page-note from a previous run must not hijack us
        if not self._initial_page:
            PAGE_FILE.unlink(missing_ok=True)
        # only the page you actually land on — see _enter_pane
        if self._initial_page:
            self.goto_page(self._initial_page)
        else:
            self._enter_pane(
                self.query_one("#content", ContentSwitcher).current)
        self._poll_tick = 0
        self.set_interval(0.5, self._poll_page_file)

    def goto_page(self, page):
        names = [pane for pane, _, _ in NAV]
        if page in names:
            self.query_one("#sidebar", ListView).index = names.index(page)

    def _poll_page_file(self):
        try:
            if PAGE_FILE.exists():
                page = PAGE_FILE.read_text().strip()
                PAGE_FILE.unlink()
                self.goto_page(page)
        except OSError:
            pass
        # fix 6: re-check auto-hide state every 2s while the Bar page shows
        self._poll_tick += 1
        if self._poll_tick % 4 == 0 and                 self.query_one("#content", ContentSwitcher).current == "pane-bar":
            self._refreshing = True
            try:
                self.query_one("#sw_autohide", Switch).value = autohide_on()
            finally:
                self._refreshing = False

    # ---------- navigation ----------
    def action_nav(self, idx: int):
        self.query_one("#sidebar", ListView).index = idx

    def on_list_view_highlighted(self, event: ListView.Highlighted):
        if event.item is None:
            return
        pane = "pane-" + (event.item.id or "").removeprefix("nav-")
        # _show_pane calls _enter_pane once the pane exists
        self._show_pane(pane)

    # ------------------------------------------------------------------
    # Lazy panes: startup built all seven (374 widgets, ~730 ms of CPU)
    # when six of them were off screen. Only the pane you land on is built
    # now; the others are mounted the first time they are shown.
    # ------------------------------------------------------------------
    def _show_pane(self, pane):
        """Make `pane` the visible one, building it if this is its first
        showing. ContentSwitcher.add_content mounts it hidden inside a
        batch_update and switches in the same pass, so no frame renders a
        pane that is not finished."""
        switcher = self.query_one("#content", ContentSwitcher)
        built = getattr(self, "_built", None)
        if built is None:
            # here rather than __init__ so this does not depend on the
            # App's constructor signature
            built = self._built = {"appearance"}
        name = pane.removeprefix("pane-")
        build = getattr(self, f"_build_{name}", None)
        if name in built or build is None:
            switcher.current = pane
            self._enter_pane(pane)
            return
        built.add(name)
        # add_content mounts asynchronously, so the page's own refresh has
        # to wait for it — running it now would query widgets that do not
        # exist yet
        self.run_worker(self._mount_pane(switcher, pane, build))

    async def _mount_pane(self, switcher, pane, build):
        await switcher.add_content(LazyPane(build, id=pane), set_current=True)
        self._enter_pane(pane)

    def _enter_pane(self, pane):
        """Refresh what THIS page shows, and nothing else.

        Every one of these used to run on every page switch. Three of them
        are sub-millisecond so nobody noticed — but the fourth spawns
        `claude mcp list`, which is Node, health-checks every server over
        the network for ~12 s, and peaks at 282 MB. Arrowing down the
        seven-item sidebar once left SEVEN of them running at 1.5 GB.
        """
        if pane == "pane-security":
            self.refresh_security()
        elif pane == "pane-wallpaper":
            self.refresh_wallpapers()
        elif pane == "pane-bar":
            self._refreshing = True
            try:
                self.query_one("#sw_autohide", Switch).value = autohide_on()
            finally:
                self._refreshing = False
        elif pane == "pane-network":
            self.refresh_network()                   # cached scan, threaded
        elif pane == "pane-integrations":
            self._hb_refresh()                       # local file, instant
        elif pane == "pane-claude":
            self._sk_refresh()                       # 1 KB per skill
            self._env_refresh()                      # one json read
            self._cs_refresh()                       # stat() walk, threaded
            self._vc_refresh()                       # one systemctl + stat
            # NOT the MCP health check: `claude mcp list` is a Node process
            # that pegs a core for seconds — it pinned the CPU at 100 % on
            # every visit to this page. Button-only; last result stays.
            if not self._mcp_at:
                self._mcp_msg("health not checked yet — 󰑓 Re-check health "
                              "runs `claude mcp list` (~5 s of CPU)")

    # ---------- dynamic labels ----------
    def refresh_security(self):
        fw = firewall_on()
        self.query_one("#fw_status", Static).update(dot(
            fw,
            "Firewall is ON — incoming connections blocked",
            "Firewall is OFF — click Enable to protect this machine"))
        self.query_one("#fw_toggle", Button).label = \
            "󰕥 Disable firewall" if fw else "󰕥 Enable firewall"
        av = service_active("clamav-daemon")
        self.query_one("#av_status", Static).update(dot(
            av,
            "Scanner daemon running — scans are fast",
            "Scanner daemon not running — scans still work, just slower"))

    def refresh_network(self, rescan=False):
        """Gather everything nmcli knows in a THREAD, then paint. `rescan`
        forces a fresh AP sweep (seconds); a plain page-open reads the
        cache so the pane is never the thing that made you wait."""
        try:
            self.query_one("#net_hint2", Static).update(
                "scanning…" if rescan else "reading…")
        except Exception:
            return                        # pane not built yet

        def work():
            def nm(*args, t=25):
                try:
                    r = subprocess.run(["nmcli", "-t", *args],
                                       capture_output=True, text=True,
                                       timeout=t)
                    return r.stdout if r.returncode == 0 else ""
                except (OSError, subprocess.TimeoutExpired):
                    return ""
            radio = "enabled" in nm("radio", "wifi")
            # active wifi connection + its device and IP
            active = ""
            dev = ""
            for line in nm("-f", "NAME,TYPE,DEVICE",
                           "connection", "show", "--active").splitlines():
                p = line.split(":")
                if len(p) >= 3 and p[1] == "802-11-wireless":
                    active, dev = p[0], p[2]
                    break
            ip = ""
            if dev:
                for line in nm("-f", "IP4.ADDRESS", "dev", "show",
                               dev).splitlines():
                    if ":" in line:
                        ip = line.split(":", 1)[1].split("/")[0]
                        break
            known = {p.split(":")[0] for p in
                     nm("-f", "NAME,TYPE", "connection", "show").splitlines()
                     if ":802-11-wireless" in p}
            # one row per SSID, strongest band wins; hidden SSIDs are the
            # Advanced editor's job (join-by-name needs typing a name)
            aps = {}
            for line in nm("-f", "IN-USE,SSID,SIGNAL,SECURITY",
                           # `auto`, never `no`: NM AGES results out of its
                           # scan cache within ~30s, so `no` on a freshly
                           # opened page returned ONLY the associated AP —
                           # which read as "only one network exists". auto
                           # reuses a fresh cache and sweeps when stale.
                           "dev", "wifi", "list", "--rescan",
                           "yes" if rescan else "auto").splitlines():
                p = line.split(":")
                if len(p) < 4 or not p[1]:
                    continue
                inuse, ssid, sec = p[0] == "*", p[1], p[3]
                try:
                    sig = int(p[2])
                except ValueError:
                    sig = 0
                cur = aps.get(ssid)
                was_used = bool(cur and cur[2])
                if cur is None or sig > cur[0]:
                    aps[ssid] = (sig, sec, was_used or inuse)
                elif inuse:
                    aps[ssid] = (cur[0], cur[1], True)
            rows = sorted(
                ((ssid, sig, sec, used)
                 for ssid, (sig, sec, used) in aps.items()),
                key=lambda r: (not r[3], -r[1]))[:12]
            # VPNs: name, kind, up? — wireguard is its own type, the rest
            # ride the vpn plugin type
            up_now = {p.split(":")[0] for p in
                      nm("-f", "NAME", "connection", "show",
                         "--active").splitlines()}
            vpns = [(p.split(":")[0], p.split(":")[1],
                     p.split(":")[0] in up_now)
                    for p in nm("-f", "NAME,TYPE",
                                "connection", "show").splitlines()
                    if ":vpn" in p or ":wireguard" in p]
            # bluetooth: /sys is the honest check — bluetoothctl HANGS with
            # no adapter (measured 2m timeout earlier), so never call it to
            # answer "is there one"
            bt = os.path.exists("/sys/class/bluetooth") and \
                bool(os.listdir("/sys/class/bluetooth"))
            self.call_from_thread(self._net_paint, radio, active, ip, rows,
                                  known, vpns, bt)
        self.run_worker(work, thread=True, group="net", exclusive=True)

    def _net_paint(self, radio, active, ip, rows, known, vpns=(), bt=False):
        from rich.markup import escape
        try:
            st = self.query_one("#net_status", Static)
        except Exception:
            return                        # user left the pane mid-scan
        if active:
            st.update(dot(True,
                          "connected to [bold]" + escape(active) + "[/]"
                          + (f" · {ip}" if ip else ""), ""))
        elif radio:
            st.update(dot(False, "", "Wi-Fi on — not connected"))
        else:
            st.update(dot(False, "", "Wi-Fi radio is OFF"))
        self._refreshing = True
        try:
            self.query_one("#sw_wifi", Switch).value = radio
        finally:
            self._refreshing = False
        self._net_aps = rows
        box = self.query_one("#net_rows", Vertical)
        box.remove_children()
        for i, (ssid, sig, sec, used) in enumerate(rows):
            bars = ("▂▄▆█" if sig >= 75 else "▂▄▆" if sig >= 50
                    else "▂▄" if sig >= 25 else "▂")
            lock = "󰌾" if sec and sec != "--" else "open"
            mark = (f"[{C['green']}]● [/]" if used else "  ")
            box.mount(Horizontal(
                Static(f"{mark}[{C['text']}]{escape(ssid)}[/]  "
                       f"[{C['accent']}]{bars}[/] "
                       f"[{C['subtext']}]{sig}% · {lock}[/]",
                       classes="netname"),
                Button("connected" if used
                       else ("join" if ssid in known else "join…"),
                       id=f"net_ap_{i}", classes="small",
                       disabled=used),
                classes="row"))
        self.query_one("#net_hint2", Static).update(
            "" if rows else ("no networks found — try Rescan" if radio
                             else "turn the radio on to scan"))
        # ----- VPN rows -----
        self._net_vpns = list(vpns)
        vbox = self.query_one("#vpn_rows", Vertical)
        vbox.remove_children()
        for i, (name, kind, up) in enumerate(self._net_vpns):
            vbox.mount(Horizontal(
                Static(f"[{C['text']}]{escape(name)}[/]  "
                       f"[{C['subtext']}]{escape(kind)}[/]",
                       classes="netname"),
                Button("disconnect" if up else "connect",
                       id=f"vpn_up_{i}", classes="small",
                       variant="warning" if up else "default"),
                classes="row"))
        self.query_one("#vpn_status", Static).update(
            dot(True, "VPN up: " + escape(", ".join(
                n for n, _k, u in self._net_vpns if u)), "")
            if any(u for _n, _k, u in self._net_vpns)
            else (f"[{C['subtext']}]no VPN connected[/]"
                  if self._net_vpns else
                  f"[{C['subtext']}]none set up yet — import a config "
                  "below[/]"))
        # ----- bluetooth -----
        # the skill's rule: what can fail renders a fallback, never a blank.
        # This box has NO adapter today, so the fallback IS the usual view —
        # but the card checks live, so plugging a dongle upgrades it on the
        # next page-open with no code change.
        self.query_one("#bt_status", Static).update(
            dot(True, "adapter present — pair and manage in Blueman", "")
            if bt else
            f"[{C['subtext']}]no Bluetooth adapter on this machine — "
            "systemd skips the service on that exact condition. A USB "
            "dongle makes this card come alive.[/]")
        self.query_one("#bt_gui", Button).disabled = not bt

    def _net_join(self, ssid, password=None):
        """Connect in a worker; paint the outcome. A wrong password leaves
        a broken profile behind that would make every retry fail the same
        way, so a failed fresh join deletes it before reporting."""
        self.query_one("#net_hint2", Static).update(
            f"joining {ssid}…")

        def work():
            def run(*a, t=45):
                try:
                    return subprocess.run(["nmcli", *a], capture_output=True,
                                          text=True, timeout=t)
                except (OSError, subprocess.TimeoutExpired) as e:
                    class R:                       # shaped like a result
                        returncode, stderr = 1, str(e)
                    return R()
            known = ssid in {p.split(":")[0] for p in subprocess.run(
                ["nmcli", "-t", "-f", "NAME", "connection", "show"],
                capture_output=True, text=True).stdout.splitlines()}
            if known and password is None:
                r = run("connection", "up", ssid)
            elif password is None:
                r = run("device", "wifi", "connect", ssid)
            else:
                r = run("device", "wifi", "connect", ssid,
                        "password", password)
                if r.returncode != 0:
                    run("connection", "delete", ssid, t=10)
            err = (r.stderr or "").strip().splitlines()
            msg = err[-1] if err else "failed"
            self.call_from_thread(self._net_joined, ssid,
                                  r.returncode == 0, msg)
        self.run_worker(work, thread=True, group="net", exclusive=True)

    def _vpn_import(self, path):
        """Import a VPN config in a worker. The type comes from the file:
        .ovpn (or .conf that smells of OpenVPN) → the openvpn plugin,
        [Interface]+[Peer] → native wireguard. Import does NOT connect —
        the new row's connect button does, so a bad import cannot strand
        half a tunnel up."""
        from rich.markup import escape
        p = Path(path).expanduser()
        st = self.query_one("#vpn_status", Static)
        if not path:
            st.update(f"[{DANGER}]paste or type the config file's path "
                      "first[/]")
            return
        if not p.is_file():
            st.update(f"[{DANGER}]no such file: {escape(str(p))}[/]")
            return
        try:
            head = p.read_text(errors="replace")[:4000]
        except OSError as e:
            st.update(f"[{DANGER}]cannot read it: {escape(str(e))}[/]")
            return
        if "[Interface]" in head and "[Peer]" in head:
            kind = "wireguard"
        elif p.suffix == ".ovpn" or "remote " in head or "client" in head:
            kind = "openvpn"
        else:
            st.update(f"[{DANGER}]cannot tell what this is — expected a "
                      "WireGuard .conf ([Interface]/[Peer]) or an "
                      ".ovpn[/]")
            return
        st.update(f"importing {escape(p.name)} as {kind}…")

        def work():
            try:
                r = subprocess.run(
                    ["nmcli", "connection", "import", "type", kind,
                     "file", str(p)],
                    capture_output=True, text=True, timeout=30)
                ok, msg = r.returncode == 0, \
                    (r.stderr or r.stdout or "").strip().splitlines()
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, msg = False, [str(e)]
            self.call_from_thread(self._vpn_imported, ok,
                                  msg[-1] if msg else "")
        self.run_worker(work, thread=True, group="net", exclusive=True)

    def _vpn_imported(self, ok, msg):
        from rich.markup import escape
        if ok:
            self.notify("VPN imported — connect it below")
            self.query_one("#vpn_path", Input).value = ""
            self.refresh_network()
        else:
            self.query_one("#vpn_status", Static).update(
                f"[{DANGER}]import failed: {escape(msg)}[/]")

    def _vpn_toggle(self, name, up):
        self.query_one("#vpn_status", Static).update(
            f"{'closing' if up else 'opening'} {name}…")

        def work():
            try:
                r = subprocess.run(
                    ["nmcli", "connection", "down" if up else "up", name],
                    capture_output=True, text=True, timeout=60)
                ok = r.returncode == 0
                msg = (r.stderr or "").strip().splitlines()
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, msg = False, [str(e)]
            def done():
                if not ok:
                    from rich.markup import escape
                    self.query_one("#vpn_status", Static).update(
                        f"[{DANGER}]{escape(msg[-1] if msg else 'failed')}"
                        "[/]")
                self.refresh_network()
            self.call_from_thread(done)
        self.run_worker(work, thread=True, group="net", exclusive=True)

    def _net_joined(self, ssid, ok, msg):
        from rich.markup import escape
        if ok:
            self.notify(f"Connected to {ssid}")
            self.refresh_network()
        else:
            self.query_one("#net_hint2", Static).update(
                f"[{DANGER}]could not join {escape(ssid)}: "
                f"{escape(msg)}[/]")

    def refresh_wallpapers(self):
        pairs = current_wallpapers()
        text = "\n".join(f"[{C['accent']}]{m}[/]  →  {p}" for m, p in pairs) \
               or "(none set)"
        self.query_one("#wp_list", Static).update(text)

    # ---------- events ----------
    def on_switch_changed(self, event: Switch.Changed):
        if self._refreshing:
            return
        sid = event.switch.id or ""
        if sid == "sw_voice":
            verb = "enable" if event.value else "disable"
            if not DRY:
                subprocess.run(["systemctl", "--user", verb, "--now", VOICE_UNIT],
                               capture_output=True)
                widgets_conf_set("voice_enabled", "1" if event.value else "0")
                self.widgets = widgets_conf()
            self.notify("Voice " + ("ON — say the wake word" if event.value else "OFF"))
            self.set_timer(1.5, self._vc_refresh)
            return
        if sid == "sw_plan_auto":
            widgets_conf_set("studio_plan_auto", "1" if event.value else "0")
            self.widgets = widgets_conf()
            self.notify("Studio will " + ("open the plan pane by itself (P still works)"
                                          if event.value else "wait for P"))
            return
        if sid == "sw_autohide":
            if event.value and not autohide_on():
                launch(str(HOME / ".local/bin/waybar-autohide.sh"))
            elif not event.value and autohide_on():
                subprocess.run(["pkill", "-xf",
                               f"python3 {HOME}/.local/bin/waybar-autohide.sh"],
                               capture_output=True)
            self.notify("Auto-hide " + ("ON — move mouse to top edge to reveal"
                                        if event.value else "OFF — bar always visible"))
            return
        if sid == "sw_wifi":
            def work(on=event.value):
                try:
                    subprocess.run(["nmcli", "radio", "wifi",
                                    "on" if on else "off"],
                                   capture_output=True, timeout=15)
                except (OSError, subprocess.TimeoutExpired):
                    pass
                self.call_from_thread(self.refresh_network)
            self.run_worker(work, thread=True, group="net", exclusive=True)
            return
        if sid.startswith("sw_w_"):
            wkey = sid.removeprefix("sw_w_")
            if wkey == "petlayer":
                widgets_conf_set("pet_layer", "top" if event.value else "bottom")
            else:
                widgets_conf_set(ONOFF_KEY.get(wkey, wkey),
                                 "on" if event.value else "off")
            self.widgets = widgets_conf()
            # office/viz are single hyprdesk surfaces — restart just that one
            # instead of bouncing the whole fleet (conky, pet, dock, cardhost)
            if wkey == "office":
                launch(str(HOME / ".local/bin/desktop-widgets.sh"), "restart-office")
            elif wkey == "viz":
                launch(str(HOME / ".local/bin/desktop-widgets.sh"), "restart-viz")
            else:
                self.schedule_widget_restart()
            self.notify("Widgets updated")
            return
        key = sid.removeprefix("sw_")
        if key in BOOLS:
            self.bools[key] = event.value
            self.dirty.add(key)
            hyprctl_set(BOOLS[key][0], 1 if event.value else 0)

    def schedule_widget_restart(self):
        if getattr(self, "_wg_timer", None):
            self._wg_timer.stop()
        self._wg_timer = self.set_timer(
            1.2, lambda: launch(str(HOME / ".local/bin/desktop-widgets.sh"),
                                "restart"))

    # ---------- integrations ----------
    def _hb_msg(self, text, bad=False, good=False):
        # C["red"]/["green"] are the pinned status inks now, so this no
        # longer needs its own private palette lookup
        col = C["red"] if bad else (C["green"] if good else C["subtext"])
        try:
            self.query_one("#hb_status", Static).update(f"[{col}]{text}[/]")
        except Exception:
            pass

    def _hb_refresh(self):
        """Show what is stored WITHOUT ever showing the token itself."""
        try:
            from hyprdesk import secrets
            svc = secrets.get("habitica") or {}
        except Exception:
            svc = {}
        uid = str(svc.get("user_id", ""))
        if uid and svc.get("api_token"):
            self.query_one("#hb_user", Input).value = uid
            # the token is deliberately NOT put back in the box — the store
            # is write-only from this panel's point of view
            self.query_one("#hb_token", Input).placeholder = \
                "saved — type a new one to replace it"
            self._hb_msg(f"connected as {svc.get('name') or uid[:8] + '…'}",
                         good=True)
        else:
            self._hb_msg("not set up — paste your keys and press Test & save")

    async def _hb_save(self, uid, tok):
        import asyncio
        if not uid or not tok:
            self._hb_msg("both the User ID and the API token are needed",
                         bad=True)
            return
        self._hb_msg("checking with Habitica…")
        try:
            from hyprdesk import habitica as H, secrets
            name = await asyncio.to_thread(H.check, uid, tok)
        except Exception as e:
            # NOT saved: a key that Habitica refuses is worse than no key,
            # because the board would fail later instead of here
            self._hb_msg(f"{e}", bad=True)
            return
        try:
            secrets.put("habitica", {"user_id": uid, "api_token": tok,
                                     "name": name})
        except Exception as e:
            self._hb_msg(f"verified, but could not save: {e}", bad=True)
            return
        self.query_one("#hb_token", Input).value = ""
        self.query_one("#hb_token", Input).placeholder = \
            "saved — type a new one to replace it"
        self._hb_msg(f"saved — connected as {name}", good=True)

    # ---------- Claude: skills ----------
    _sk_filter = ""

    def _sk_refresh(self):
        try:
            box = self.query_one("#sk_rows", Vertical)
        except Exception:
            return
        rows = skill_list()
        props = skill_proposals()
        self._sk_props = {}
        for j, (name, src, prop, target) in enumerate(props):
            self._sk_props[j] = (prop, target)
            line = (f"[{C['yellow']}]◆[/] [{C['text']}]{_esc(_col(name, 20))}[/] "
                    f"[{C['subtext']}]{_col('proposed', 9)}{_esc(_col(f'{src} · from lesson-proposer', 42))}[/]")
            box.mount(Horizontal(
                Static(line, classes="skrow"),
                Button("󰄬", id=f"sk_acc_{j}", classes="small", variant="primary"),
                Button("✕", id=f"sk_rej_{j}", classes="small"),
                classes="row"))
        q = self._sk_filter.lower()
        shown = [r for r in rows if not q or q in r[0].lower() or q in r[2].lower()]
        self._sk_paths = {}
        box.remove_children()
        for i, (name, src, desc, enabled, path) in enumerate(shown):
            self._sk_paths[i] = path
            ink = C["green"] if enabled else C["subtext"]
            line = (f"[{ink}]{'●' if enabled else '○'}[/] "
                    f"[{C['text'] if enabled else C['subtext']}]{_esc(_col(name, 20))}[/] "
                    f"[{C['subtext']}]{_col(src, 9)}{_esc(_col(desc, 42))}[/]")
            box.mount(Horizontal(
                Static(line, classes="skrow"),
                Button("󰏫", id=f"sk_edit_{i}", classes="small"),
                Button("⏻", id=f"sk_tog_{i}", classes="small"),
                classes="row"))
        on = sum(1 for r in rows if r[3])
        msg = f"{len(rows)} skills — {on} enabled, {len(rows) - on} disabled"
        if props:
            msg += f" · {len(props)} proposed (◆ accept 󰄬 or reject ✕)"
        if q:
            msg += f" · {len(shown)} match"
        self.query_one("#sk_status", Static).update(f"[{C['subtext']}]{msg}[/]")

    _sk_timer = None

    def on_input_changed(self, event: Input.Changed):
        if (event.input.id or "") == "sk_filter":
            self._sk_filter = event.value.strip()
            # rebuilding ~30 rows costs ~0.25 s CPU: once per pause, not per key
            if self._sk_timer:
                self._sk_timer.stop()
            self._sk_timer = self.set_timer(0.3, self._sk_refresh)

    # ---------- Claude: env ----------
    def _env_msg(self, text, bad=False, good=False):
        col = C["red"] if bad else (C["green"] if good else C["subtext"])
        try:
            self.query_one("#env_status", Static).update(f"[{col}]{text}[/]")
        except Exception:
            pass

    def _env_refresh(self):
        try:
            box = self.query_one("#env_rows", Vertical)
        except Exception:
            return
        cfg = claude_settings()
        env = cfg.get("env", {}) or {}
        self._env_keys = {}
        box.remove_children()
        for i, key in enumerate(sorted(env)):
            self._env_keys[i] = key
            val = str(env[key])
            shown = ("•" * min(len(val), 12)) if SECRET_KEY_RE.search(key) else val
            line = (f"[{C['text']}]{_esc(_col(key, 30))}[/] "
                    f"[{C['subtext']}]{_esc(_col(shown, 50))}[/]")
            box.mount(Horizontal(Static(line, classes="envrow"),
                                 Button("✕", id=f"env_rm_{i}", classes="small"),
                                 classes="row"))
        self._env_msg(f"{len(env)} variable(s) passed to every Claude Code "
                      "process — new sessions only")
        hooks = sum(len(v) for v in (cfg.get("hooks") or {}).values())
        plugins = [p.split("@")[0] for p, on in
                   (cfg.get("enabledPlugins") or {}).items() if on]
        self.query_one("#env_info", Static).update(
            f"model {_esc(str(cfg.get('model', 'default')))} · "
            f"effort {_esc(str(cfg.get('effortLevel', 'default')))} · "
            f"{hooks} hook(s) · plugins: {_esc(', '.join(plugins) or 'none')} · "
            f"{len(cfg.get('permissions', {}).get('allow', []))} allow rules")

    # ---------- Claude: sessions ----------
    def _cs_refresh(self):
        def work():
            n_proj, n_tr, size, oldest = session_stats()
            age = ""
            if oldest:
                days = int((time.time() - oldest) / 86400)
                age = f" · oldest {days} d"
            self.call_from_thread(
                self.query_one("#cs_status", Static).update,
                f"[{C['subtext']}]{n_proj} projects · {n_tr} transcripts · "
                f"{human(size)}{age}[/]")
        try:
            self.query_one("#cs_status", Static).update(
                f"[{C['subtext']}]counting…[/]")
        except Exception:
            return
        self.run_worker(work, thread=True, group="cs", exclusive=True)

    # ---------- Claude: voice ----------
    def _vc_refresh(self):
        try:
            st = self.query_one("#vc_status", Static)
        except Exception:
            return
        on = voice_unit_active()
        model = "custom “hey draven” model" if VOICE_MODEL.exists() \
            else "pretrained “hey jarvis” (drop hey_draven.onnx to change)"
        st.update(dot(on, f"listening — {model}", f"off — {model}"))
        self._refreshing = True
        try:
            self.query_one("#sw_voice", Switch).value = on
        finally:
            self._refreshing = False

    def _vc_set(self, key, val):
        widgets_conf_set(key, val)
        self.widgets = widgets_conf()
        if voice_unit_active() and not DRY:
            subprocess.run(["systemctl", "--user", "restart", VOICE_UNIT],
                           capture_output=True)

    # ---------- MCP ----------
    def _mcp_msg(self, text, bad=False, good=False):
        col = C["red"] if bad else (C["green"] if good else C["subtext"])
        try:
            self.query_one("#mcp_status", Static).update(f"[{col}]{text}[/]")
        except Exception:
            pass

    async def _mcp_refresh(self):
        import asyncio
        # exclusive=True cancels the previous WORKER, but that worker is
        # parked in to_thread around subprocess.run and the Node process
        # it already started runs to completion regardless. Only a flag
        # actually stops them stacking up.
        if self._mcp_busy:
            return
        self._mcp_busy = True
        self._mcp_at = time.time()
        self._mcp_msg("checking server health… (network, can take ~20 s)")
        try:
            servers = await asyncio.to_thread(mcp_list)
        except RuntimeError as e:
            self._mcp_msg(str(e), bad=True)
            return
        except Exception as e:
            self._mcp_msg(f"could not list servers: {e}", bad=True)
            return
        finally:
            self._mcp_busy = False
        try:
            box = self.query_one("#mcp_rows", Vertical)
        except Exception:
            return                       # pane gone mid-refresh
        await box.remove_children()
        self._mcp_rm = {}
        ink = {"good": C["green"], "warn": C["yellow"], "bad": C["red"]}
        # ◐ was tried for warn and rendered blank — these three are all
        # plain Geometric Shapes and differ in FORM, not only in colour
        mark = {"good": "●", "warn": "◆", "bad": "○"}
        for i, (name, target, state, note, managed) in enumerate(servers):
            line = (f"[{ink[state]}]{mark[state]}[/] "
                    f"[{C['text']}]{_esc(_col(name, 26))}[/] "
                    f"[{C['subtext']}]{_esc(_col(target, 34))} "
                    f"{_esc(_col(note, 20))}[/]")
            if managed:
                await box.mount(Static(line, classes="mcprow"))
            else:
                bid = f"mcprm_{i}"
                self._mcp_rm[bid] = name
                await box.mount(Horizontal(
                    Static(line, classes="mcprow"),
                    Button("✕", id=bid, classes="small"),
                    classes="row"))
        n, n_local = len(servers), len(self._mcp_rm)
        if n:
            self._mcp_msg(f"{n} server(s) — {n - n_local} account-managed, "
                          f"{n_local} local", good=True)
        else:
            self._mcp_msg("no MCP servers configured — add one below")

    async def _mcp_add(self, name, cmd):
        import asyncio
        import shlex
        self._mcp_msg(f"adding “{name}”…")
        if cmd.startswith(("http://", "https://")):
            argv = ["claude", "mcp", "add", "-s", "user",
                    "--transport", "http", name, cmd]
        else:
            try:
                parts = shlex.split(cmd)
            except ValueError as e:
                self._mcp_msg(f"bad command line: {e}", bad=True)
                return
            argv = ["claude", "mcp", "add", "-s", "user", name, "--"] + parts
        if DRY:
            self._mcp_msg("(dry) would run: " + " ".join(argv))
            return
        try:
            r = await asyncio.to_thread(
                subprocess.run, argv, capture_output=True, text=True,
                timeout=60)
        except Exception as e:
            self._mcp_msg(f"add failed: {e}", bad=True)
            return
        if r.returncode != 0:
            err = (r.stderr or r.stdout or "add failed").strip()
            self._mcp_msg(_esc(err.splitlines()[-1][:120]), bad=True)
            return
        self.query_one("#mcp_name", Input).value = ""
        self.query_one("#mcp_cmd", Input).value = ""
        await self._mcp_refresh()

    async def _mcp_remove(self, name):
        import asyncio
        self._mcp_msg(f"removing “{name}”…")
        if DRY:
            self._mcp_msg(f"(dry) would remove {name}")
            return
        try:
            # no -s: the CLI removes from whichever scope holds it, which
            # is what a "✕ next to the row" should mean
            r = await asyncio.to_thread(
                subprocess.run, ["claude", "mcp", "remove", name],
                capture_output=True, text=True, timeout=30)
        except Exception as e:
            self._mcp_msg(f"remove failed: {e}", bad=True)
            return
        if r.returncode != 0:
            err = (r.stderr or r.stdout or "remove failed").strip()
            self._mcp_msg(_esc(err.splitlines()[-1][:120]), bad=True)
            return
        await self._mcp_refresh()

    def on_button_pressed(self, event: Button.Pressed):
        bid = event.button.id or ""
        if bid == "net_rescan":
            self.refresh_network(rescan=True)
            return
        if bid == "net_editor":
            launch("nm-connection-editor")
            return
        if bid.startswith("net_ap_"):
            try:
                ssid, _sig, sec, used = \
                    self._net_aps[int(bid.removeprefix("net_ap_"))]
            except (AttributeError, ValueError, IndexError):
                return
            if used:
                return
            secured = bool(sec and sec != "--")
            known = False
            try:
                known = ssid in {p.split(":")[0] for p in subprocess.run(
                    ["nmcli", "-t", "-f", "NAME", "connection", "show"],
                    capture_output=True, text=True,
                    timeout=10).stdout.splitlines()}
            except (OSError, subprocess.TimeoutExpired):
                pass
            if known or not secured:
                self._net_join(ssid)
            else:
                # new secured network: a POPUP that names it and shows its
                # lock and signal, so the password lands on the right net
                def got(pw, ssid=ssid):
                    if pw:
                        self._net_join(ssid, pw)
                self.push_screen(WifiJoin(ssid, _sig, sec), got)
            return
        if bid == "vpn_paste":
            try:
                r = subprocess.run(["wl-paste", "-n"], capture_output=True,
                                   text=True, timeout=5)
                self.query_one("#vpn_path", Input).value = r.stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                self.notify("clipboard unavailable", severity="warning")
            return
        if bid == "vpn_import":
            self._vpn_import(self.query_one("#vpn_path", Input).value.strip())
            return
        if bid.startswith("vpn_up_"):
            try:
                name, _kind, up = \
                    self._net_vpns[int(bid.removeprefix("vpn_up_"))]
            except (AttributeError, ValueError, IndexError):
                return
            self._vpn_toggle(name, up)
            return
        if bid == "bt_gui":
            launch("blueman-manager")
            return
        if bid == "theme_btn":
            themes = theme_list()
            cur = self.widgets.get("theme", "wallust")
            nxt = themes[(themes.index(cur) + 1) % len(themes)] \
                if cur in themes else themes[0]
            widgets_conf_set("theme", nxt)
            self.widgets = widgets_conf()
            event.button.label = nxt
            self.schedule_widget_restart()
            return
        if bid.startswith("sk_acc_") or bid.startswith("sk_rej_"):
            prop, target = getattr(self, "_sk_props", {}).get(int(bid[7:]), (None, None))
            if prop:
                try:
                    if not DRY:
                        (skill_accept(prop, target) if bid.startswith("sk_acc_") else skill_reject(prop))
                except OSError as e:
                    self.notify(f"proposal: {e}", severity="error")
                self.notify("accepted — live in the next session" if bid.startswith("sk_acc_") else "rejected")
                self._sk_refresh()
            return
        if bid.startswith("sk_edit_"):
            path = getattr(self, "_sk_paths", {}).get(int(bid[8:]))
            if path:
                launch("kitty", "--class", "floatterm", "--title", "SKILL.md",
                       "nvim", str(path / "SKILL.md"))
            return
        if bid.startswith("sk_tog_"):
            path = getattr(self, "_sk_paths", {}).get(int(bid[7:]))
            if path:
                try:
                    if not DRY:
                        skill_toggle(path)
                except OSError as e:
                    self.notify(f"could not rename: {e}", severity="error")
                self._sk_refresh()
            return
        if bid == "sk_new":
            name = self.query_one("#sk_new_name", Input).value.strip()
            if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
                self.notify("name: lowercase letters, digits, dashes",
                            severity="warning")
                return
            try:
                md = skill_new(name) if not DRY else None
            except FileExistsError:
                self.notify(f"{name} already exists", severity="warning")
                return
            self.query_one("#sk_new_name", Input).value = ""
            self._sk_refresh()
            if md:
                launch("kitty", "--class", "floatterm", "--title", "SKILL.md",
                       "nvim", str(md))
            return
        if bid == "env_paste":
            try:
                r = subprocess.run(["wl-paste", "-n"], capture_output=True,
                                   text=True, timeout=5)
                self.query_one("#env_val", Input).value = r.stdout.strip()
            except (OSError, subprocess.TimeoutExpired):
                self.notify("clipboard unavailable", severity="warning")
            return
        if bid == "env_add":
            key = self.query_one("#env_key", Input).value.strip()
            val = self.query_one("#env_val", Input).value
            if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
                self._env_msg("key must be an identifier (A-Z, 0-9, _)", bad=True)
                return
            try:
                if not DRY:
                    claude_env_set(key, val)
            except (OSError, ValueError) as e:
                self._env_msg(f"write failed: {e}", bad=True)
                return
            self.query_one("#env_key", Input).value = ""
            self.query_one("#env_val", Input).value = ""
            self._env_refresh()
            self._env_msg(f"{key} set — applies to new Claude sessions", good=True)
            return
        if bid.startswith("env_rm_"):
            key = getattr(self, "_env_keys", {}).get(int(bid[7:]))
            if key:
                try:
                    if not DRY:
                        claude_env_set(key, delete=True)
                except (OSError, ValueError) as e:
                    self._env_msg(f"write failed: {e}", bad=True)
                    return
                self._env_refresh()
                self._env_msg(f"{key} removed", good=True)
            return
        if bid == "env_open":
            launch("kitty", "--class", "floatterm", "--title", "settings.json",
                   "nvim", str(CLAUDE_SETTINGS))
            return
        if bid == "vc_source":
            srcs = voice_sources()
            cur = self.widgets.get("voice_source", "")
            ids = [""] + [i for i, _ in srcs]
            nxt = ids[(ids.index(cur) + 1) % len(ids)] if cur in ids else ""
            if nxt:
                widgets_conf_set("voice_source", nxt)
            else:
                _conf_set({}, delete=["voice_source"])
            self.widgets = widgets_conf()
            name = dict(srcs).get(nxt, "default")
            event.button.label = f"{nxt} {name}".strip() if nxt else "default"
            self._vc_set("voice_source", nxt) if nxt else None
            return
        if bid in ("vc_thr_up", "vc_thr_down"):
            cur = float(self.widgets.get("voice_threshold", "0.6"))
            cur = round(min(0.95, max(0.2, cur + (0.05 if bid == "vc_thr_up" else -0.05))), 2)
            self._vc_set("voice_threshold", str(cur))
            self.query_one("#vc_thr", Static).update(str(cur))
            return
        if bid == "vc_lang":
            nxt = "th" if self.widgets.get("voice_lang", "en") == "en" else "en"
            self._vc_set("voice_lang", nxt)
            event.button.label = nxt
            return
        if bid == "vc_test":
            launch("kitty", "--class", "floatterm", "--title", "hypr-voice test",
                   "sh", "-c", f"{HOME}/.local/bin/hypr-voice --test 10; echo; echo 'press Enter to close'; read x")
            return
        if bid == "vc_docs":
            launch("kitty", "--class", "floatterm", "--title", "voice.md",
                   "nvim", str(HOME / "hyprland-dots/docs/voice.md"))
            return
        if bid == "cs_studio":
            launch(str(HOME / ".local/bin/draveniq"))
            return
        if bid == "cs_refresh":
            self._cs_refresh()
            return
        if bid == "mcp_refresh":
            self._mcp_at = 0.0                       # an explicit ask wins
            self.run_worker(self._mcp_refresh(), group="mcp", exclusive=True)
            return

        if bid == "mcp_paste":
            try:
                r = subprocess.run(["wl-paste", "-n"], capture_output=True,
                                   text=True, timeout=4)
                val = (r.stdout or "").strip()
            except Exception as e:
                self._mcp_msg(f"clipboard unavailable: {e}", bad=True)
                return
            if not val:
                self._mcp_msg("clipboard is empty", bad=True)
                return
            self.query_one("#mcp_cmd", Input).value = val
            self._mcp_msg(f"pasted {len(val)} characters")
            return

        if bid == "mcp_add":
            name = self.query_one("#mcp_name", Input).value.strip()
            cmd = self.query_one("#mcp_cmd", Input).value.strip()
            if not name or not cmd:
                self._mcp_msg("both a name and a command/URL are needed",
                              bad=True)
                return
            if not re.fullmatch(r"[\w.-]+", name):
                self._mcp_msg("name: letters, digits, dot, dash, underscore "
                              "only", bad=True)
                return
            self.run_worker(self._mcp_add(name, cmd), group="mcp",
                            exclusive=True)
            return

        if bid.startswith("mcprm_"):
            name = getattr(self, "_mcp_rm", {}).get(bid)
            if name:
                self.run_worker(self._mcp_remove(name), group="mcp",
                                exclusive=True)
            return

        if bid in ("hb_paste_user", "hb_paste_token"):
            # A terminal never delivers ctrl+v to the app — it is the
            # emulator's own paste key. For a field whose whole purpose is
            # receiving a pasted secret, a button beats knowing that.
            target = "#hb_user" if bid.endswith("user") else "#hb_token"
            try:
                r = subprocess.run(["wl-paste", "-n"], capture_output=True,
                                   text=True, timeout=4)
                val = (r.stdout or "").strip()
            except Exception as e:
                self._hb_msg(f"clipboard unavailable: {e}", bad=True)
                return
            if not val:
                self._hb_msg("clipboard is empty", bad=True)
                return
            self.query_one(target, Input).value = val
            # never echo a secret back: say the shape, not the value
            self._hb_msg(f"pasted {len(val)} characters into "
                         f"{'User ID' if bid.endswith('user') else 'API token'}")
            return

        if bid == "hb_save":
            uid = self.query_one("#hb_user", Input).value.strip()
            tok = self.query_one("#hb_token", Input).value.strip()
            self.run_worker(self._hb_save(uid, tok), exclusive=True)
            return

        if bid == "hb_forget":
            try:
                from hyprdesk import secrets
                secrets.forget("habitica")
            except Exception as e:
                self._hb_msg(f"could not clear: {e}", bad=True)
                return
            self.query_one("#hb_user", Input).value = ""
            self.query_one("#hb_token", Input).value = ""
            self._hb_msg("keys cleared")
            return

        if bid.startswith("layer_"):
            key = bid.removeprefix("layer_")
            self.widgets = widgets_conf()
            cur = self.widgets.get(f"{key}_layer", LAYER_DEFAULT.get(key,
                                                                     "bottom"))
            nxt = (LAYER_CYCLE[(LAYER_CYCLE.index(cur) + 1) % len(LAYER_CYCLE)]
                   if cur in LAYER_CYCLE else LAYER_CYCLE[0])
            _conf_set({f"{key}_layer": nxt})
            self.widgets = widgets_conf()
            event.button.label = nxt
            # a layer is chosen when the surface MAPS, so SIGUSR1 cannot
            # change it — this is the one widget edit that must respawn
            launch(str(HOME / ".local/bin/desktop-widgets.sh"),
                   f"restart-{key}")
            return

        if bid.startswith("pos_"):
            key = bid.removeprefix("pos_")
            # re-read before computing: hypr-arrange may have saved since
            # this page was built — stepping from a stale cache would revert it
            self.widgets = widgets_conf()
            cur = self.widgets.get(f"{key}_pos",
                                   DEFAULT_POS.get(key, ("top_left",))[0])
            nxt = POS_CYCLE[(POS_CYCLE.index(cur) + 1) % len(POS_CYCLE)] \
                if cur in POS_CYCLE else POS_CYCLE[0]
            if f"{key}_col" in self.widgets:
                # cycling the anchor un-grids the card — the saved cell
                # would otherwise shadow the new pos into a silent no-op
                _conf_set({f"{key}_pos": nxt},
                          delete=[f"{key}_col", f"{key}_row"])
                self.widgets = widgets_conf()
            else:
                self.widgets_layout_set(key, "pos", nxt)
            event.button.label = nxt.replace("_", " ")
            if key in LIVE_SIGNAL_PROC:
                if not signal_widget(key):
                    self.schedule_widget_restart()
            else:
                self.schedule_widget_restart()
            return
        if bid.startswith(("xm_", "xp_", "ym_", "yp_")):
            axis, sign = bid[0], (1 if bid[1] == "p" else -1)
            key = bid[3:]
            self.widgets = widgets_conf()      # fresh read (see pos_ above)
            if f"{key}_col" in self.widgets:
                # grid-placed card: legacy _x/_y is SHADOWED by the cell —
                # nudge the cell instead of writing a silent no-op, clamped
                # to the grid so col/row can't grow past the last column
                gk = f"{key}_col" if axis == "x" else f"{key}_row"
                hi = self.grid_extent(key, axis)
                val = max(0, min(hi, int(self.widgets.get(gk, "0") or 0)
                                 + sign))
                _conf_set({gk: str(val)})
                self.widgets = widgets_conf()
                self.query_one(f"#{axis}v_{key}", Static).update(
                    f"cell {val}")
            else:
                ck = f"{key}_{axis}"
                val = max(0, int(self.widgets.get(ck, "0") or 0) + sign * 12)
                self.widgets_layout_set(key, axis, str(val))
                self.query_one(f"#{axis}v_{key}", Static).update(str(val))
            if key in LIVE_SIGNAL_PROC:
                if not signal_widget(key):
                    self.schedule_widget_restart()
            else:
                self.schedule_widget_restart()
            return
        if bid.startswith(("inc_", "dec_")):
            key = bid[4:]
            opt, _, lo, _, _ = INTS[key]
            hi = self.limits[key]
            step = 1 if bid.startswith("inc_") else -1
            self.ints[key] = max(lo, min(hi, self.ints[key] + step))
            self.dirty.add(key)
            self.query_one(f"#val_{key}", Static).update(str(self.ints[key]))
            self.query_one(f"#gauge_{key}", Static).update(
                gauge_markup(key, self.ints[key], hi))
            hyprctl_set(opt, self.ints[key])
            return
        actions = {
            "save": self.do_save, "revert": self.do_revert,
            "bar_toggle": lambda: launch(str(HOME / ".local/bin/bar-toggle.sh")),
            "bar_restart": lambda: launch(TOOLS, "restart-bar"),
            "bar_reorder": lambda: launch(TOOLS, "reorder"),
            "wp_random": lambda: launch(str(HOME / ".local/bin/wallpaper.sh")),
            "wp_pick": lambda: launch(TOOLS, "wallpaper"),
            "fw_toggle": self.do_fw_toggle,
            "fw_rules": lambda: launch("kitty", "--class", "floatterm", "--title",
                                       "Firewall rules", "bash", "-c",
                                       "pkexec ufw status verbose; echo; read -rp 'Enter to close…'"),
            "av_scan": lambda: launch(TOOLS, "clamav"),
            "av_gui": self.do_open_clamtk,
            "av_update": lambda: launch("kitty", "--class", "floatterm", "--title",
                                        "Update virus definitions", "bash", "-c",
                                        "pkexec bash -c 'systemctl stop clamav-freshclam; freshclam; systemctl start clamav-freshclam'; echo; read -rp 'Enter to close…'"),
            "p_lock": lambda: launch("hyprlock"),
            "p_suspend": lambda: launch("systemctl", "suspend"),
            "wg_restart": lambda: launch(
                str(HOME / ".local/bin/desktop-widgets.sh"), "restart"),
            "wg_add": lambda: launch(
                str(HOME / ".local/bin/hypr-widgetpicker")),
            "dock_pick": lambda: launch(
                str(HOME / ".local/bin/hypr-appdock"), "--picker"),
            "wg_arrange": lambda: launch(
                str(HOME / ".local/bin/hypr-arrange")),
        }
        if bid in actions:
            actions[bid]()
            if bid in ("wp_random", "wp_pick"):
                self.set_timer(4, self.refresh_wallpapers)
            return
        power = {"p_logout": ("log out", ["hyprctl", "dispatch", "exit"]),
                 "p_reboot": ("reboot", ["systemctl", "reboot"]),
                 "p_shutdown": ("shut down", ["systemctl", "poweroff"])}
        if bid in power:
            name, cmd = power[bid]
            self.push_screen(Confirm(f"Really {name}?"),
                             lambda ok, c=cmd: launch(*c) if ok else None)

    # ---------- actions ----------
    def grid_extent(self, key, axis):
        """Max cell index (cols-1 / rows-1) for a card's monitor, so the
        steppers can't push a cell past the grid."""
        try:
            import sys as _sys
            _sys.path.insert(0, str(HOME / ".local/lib"))
            from hyprdesk import grid
            from hyprdesk.monitors import hypr_monitors
            mon = self.widgets.get(f"{key}_mon")
            g = next((m for m in hypr_monitors() if m.get("name") == mon),
                     None)
            if not g:
                return 11 if axis == "x" else 5
            r = g.get("reserved") or (0, 0, 0, 0)
            ww = g["width"] - r[0] - r[2]
            wh = g["height"] - r[1] - r[3]
            cols, rows_n, _, _ = grid.geometry(ww, wh, self.widgets)
            return (cols - 1) if axis == "x" else (rows_n - 1)
        except Exception:
            return 11 if axis == "x" else 5

    def widgets_layout_set(self, key, suffix, val):
        """Write a layout key; for 'apps' also write through to any existing
        per-monitor dock_<MON>_* keys so the control keeps moving every dock
        once monitors have their own placement (they shadow the legacy key)."""
        changes = {f"{key}_{suffix}": val}
        if key == "apps":
            for k in widgets_conf():
                if re.fullmatch(rf"dock_\w+_{suffix}", k):
                    changes[k] = val
        _conf_set(changes)
        self.widgets = widgets_conf()

    def do_save(self):
        values, names = {}, {}
        for key in self.dirty:
            if key in INTS and key not in self.multi:
                _, path, _, _, label = INTS[key]
                values[path] = str(self.ints[key])
                names[path] = label
            elif key in BOOLS:
                opt, path, label = BOOLS[key]
                values[path] = "true" if self.bools[key] else "false"
                names[path] = label
        self.last_save_report = None
        if not values:
            self.notify("Nothing changed since opening — nothing to save")
            return
        try:
            written = save_to_config(values)
        except Exception as e:
            self.notify(f"Save failed: {e}", severity="error")
            return
        missing = set(values) - written
        self.last_save_report = {"written": written, "missing": missing}
        if missing:
            miss = ", ".join(names[p] for p in missing)
            self.notify(f"⚠ NOT saved: {miss} — its line is missing from "
                        f"hyprland.conf", severity="warning", timeout=10)
        if written:
            self.dirty = {k for k in self.dirty
                          if (INTS[k][1] if k in INTS else BOOLS[k][1])
                          not in written}
            self.notify(f"Saved {len(written)} setting(s) — they survive reboot")

    def do_revert(self):
        if not DRY:
            subprocess.run(["hyprctl", "reload"], capture_output=True)
        self.dirty.clear()
        for key, spec in INTS.items():
            if key in self.multi:
                continue
            self.ints[key] = hyprctl_get(spec[0], self.ints[key])
            self.limits[key] = max(INTS[key][3], self.ints[key])
            self.query_one(f"#val_{key}", Static).update(str(self.ints[key]))
            self.query_one(f"#gauge_{key}", Static).update(
                gauge_markup(key, self.ints[key], self.limits[key]))
        self._refreshing = True
        try:
            for key, spec in BOOLS.items():
                self.bools[key] = bool(hyprctl_get(spec[0], self.bools[key]))
                self.query_one(f"#sw_{key}", Switch).value = self.bools[key]
        finally:
            self._refreshing = False
        self.notify("Reverted to the saved config")

    def do_open_clamtk(self):
        if shutil.which("clamtk"):
            launch("clamtk")
        else:
            self.notify("ClamTk is not installed — use the Tools menu to "
                        "install it, or: sudo apt install clamtk",
                        severity="error")

    def do_fw_toggle(self):
        if not shutil.which("ufw"):
            self.notify("ufw is not installed — run: sudo apt install ufw",
                        severity="error")
            return
        verb = "disable" if firewall_on() else "enable"
        if DRY:
            launch("pkexec", "ufw", verb)
            return

        def work():
            r = subprocess.run(["pkexec", "ufw", verb],
                               capture_output=True, text=True)
            if r.returncode in (126, 127):   # password prompt dismissed
                self.call_from_thread(self.notify,
                                      "Cancelled — no password given",
                                      severity="warning")
            elif r.returncode != 0:
                err = (r.stderr or r.stdout).strip()[:120] or "unknown error"
                self.call_from_thread(self.notify, f"ufw {verb} failed: {err}",
                                      severity="error")
            self.call_from_thread(self.refresh_security)

        self.run_worker(work, thread=True)
        self.set_timer(10, self.refresh_security)


if __name__ == "__main__":
    HyprSettings(sys.argv[1] if len(sys.argv) > 1 else None).run()
