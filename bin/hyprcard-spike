#!/usr/bin/env python3
"""hyprcard-spike — GO/NO-GO probe for the ALT+drag bonus gesture.

The question: with `bindm = ALT, mouse:272, movewindow` active, does an
ALT+left-click get DELIVERED to a bottom-layer card surface at all — or
does the compositor consume it? (That's the whole gate: the real nudge
implementation learns ALT-is-held from a non-consuming keybind, NOT from
pointer-event modifier bits, which never reach keyboard_mode=none
surfaces — so delivery is the only thing this probe must measure.)

Protocol (the card walks you through it):
  step 1 — plain left-click the amber card once   (baseline: clicks work)
  step 2 — HOLD ALT and left-click it 3 times     (the actual question)

Verdicts, printed and saved to $XDG_RUNTIME_DIR/hyprcard-spike.result:
  GO       — clicks arrived during step 2: ALT+click reaches the surface
  NO-GO    — step 1 clicks arrived but step 2 clicks never did: the
             movewindow bindm consumes the combo (edit mode stays the
             only path, per decision D2 — no compromise gesture)
  BROKEN   — not even the plain click arrived
  UNTESTED — 90s passed without the protocol being completed
"""
import os
import signal
import sys
import time
from pathlib import Path

import cairo
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

sys.path.insert(0, str(Path.home() / ".local/lib"))
from hyprdesk import colors
from hyprdesk.layer import LayerWindow
from hyprdesk.theme import rgb

RESULT = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / \
    "hyprcard-spike.result"
state = {"step": 1, "plain": 0, "alt": 0, "mod1_seen": 0}


class Probe(LayerWindow):
    def __init__(self):
        super().__init__("spike", default_pos="top_middle", default_x=0,
                         default_y=300, layer="bottom",
                         namespace="hyprcard-spike")
        self.pal = colors()
        self.set_app_paintable(True)
        self.area = Gtk.DrawingArea()
        masks = (Gdk.EventMask.BUTTON_PRESS_MASK |
                 Gdk.EventMask.BUTTON_RELEASE_MASK)
        self.add_events(masks)
        self.area.add_events(masks)
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_press)
        self.add(self.area)
        self.set_size_request(360, 130)
        self.show_all()

    def on_press(self, _w, ev):
        if ev.button != 1:
            return True
        if ev.state & Gdk.ModifierType.MOD1_MASK:
            state["mod1_seen"] += 1     # bonus data; never expected
        if state["step"] == 1:
            state["plain"] += 1
            state["step"] = 2
            print("step 1 ok — now HOLD ALT and click 3×", flush=True)
        else:
            state["alt"] += 1
            print(f"step 2 click {state['alt']}/3 delivered", flush=True)
            if state["alt"] >= 3:
                finish()
        self.area.queue_draw()
        return True

    def on_draw(self, _w, cr):
        pal = self.pal
        cr.set_source_rgba(*rgb(pal["accent2"]), 0.92)
        r, w, h = 12, 360, 130
        cr.new_path()
        cr.arc(w - r, r, r, -1.5708, 0)
        cr.arc(w - r, h - r, r, 0, 1.5708)
        cr.arc(r, h - r, r, 1.5708, 3.1416)
        cr.arc(r, r, r, 3.1416, 4.7124)
        cr.close_path()
        cr.fill()
        cr.set_source_rgba(*rgb(pal["bg"]), 1)
        cr.select_font_face("JetBrainsMono Nerd Font",
                            cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(14)
        cr.move_to(16, 32)
        cr.show_text("ALT+DRAG SPIKE")
        cr.set_font_size(12)
        cr.move_to(16, 60)
        if state["step"] == 1:
            cr.show_text("STEP 1: plain left-click me once")
        else:
            cr.show_text("STEP 2: HOLD ALT and click me 3×")
        cr.set_font_size(10)
        cr.move_to(16, 88)
        cr.show_text(f"plain: {state['plain']}   with-ALT delivered: "
                     f"{state['alt']}/3")
        cr.move_to(16, 108)
        cr.show_text("(if ALT-clicks do nothing here, the compositor "
                     "eats them)")
        return True


def finish(*_):
    if state["alt"]:
        verdict, msg = "GO", (
            "GO — ALT+left-click is DELIVERED to bottom-layer surfaces "
            "despite the movewindow bindm; the quick-nudge gesture can "
            "ship (arming via non-consuming binds, as designed).")
        if state["mod1_seen"]:
            msg += " (bonus: MOD1 even appears in pointer state)"
    elif state["plain"]:
        verdict, msg = "NO-GO", (
            "NO-GO — plain clicks arrive but ALT+clicks never do: the "
            "compositor consumes the combo. Edit mode (ALT+SHIFT+E) "
            "remains the way; no compromise gesture per decision D2.")
    elif state["step"] == 1:
        verdict, msg = "UNTESTED", (
            "UNTESTED — the protocol wasn't completed in 90s. "
            "Re-run hyprcard-spike when ready; no verdict recorded "
            "as authoritative.")
    else:
        verdict, msg = "BROKEN", \
            "BROKEN — not even a plain click reached the probe."
    RESULT.write_text(f"{verdict}\n{msg}\n{time.strftime('%F %T')}\n")
    print(f"\n{msg}\nresult saved: {RESULT}", flush=True)
    os._exit(0)


def main():
    try:
        RESULT.unlink()        # a stale verdict must never masquerade
    except OSError:
        pass
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGINT, finish)
    GLib.unix_signal_add(GLib.PRIORITY_HIGH, signal.SIGTERM, finish)
    GLib.timeout_add_seconds(90, finish)
    Probe()
    print("probe up (90s) — STEP 1: plain-click the amber card once",
          flush=True)
    Gtk.main()


if __name__ == "__main__":
    main()
