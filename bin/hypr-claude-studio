#!/usr/bin/env python3
"""hypr-claude-studio — a VS-Code-style workspace for Claude Code sessions.

One kitty window running a tmux session:
  · TOP: a two-row bar. Row 0 brands the studio, says where you are and how
    many tabs there really are, and holds the / and split buttons. Row 1 is
    the tab strip: click to switch, ✕ or middle-click to close, ● for a
    bell (your turn) and ○ for output you have not read yet.
  · TAB 0 "sessions": an expandable tree of conversations — ● running,
    󰑮 background (with what the job is actually doing), then projects →
    their resumable transcripts
  · Enter opens a session as its own tab (`claude --resume`); if it is
    already open its tab is focused instead; s opens it BESIDE the one
    you are reading (two conversations, one screen); n = new session in
    the highlighted project; t = plain terminal there; m = the settings
    panel (MCP servers) as a tab; r = refresh
  · JUMP: C-b g (or C-b C-Space, or the / button) opens a fuzzy popup over
    every open tab and every resumable transcript. Row 1 has no scrollport
    on purpose, so this is the only way to reach a tab past the right edge.
  · SPLITS: any tab holds several panes — C-b | side by side, C-b - stacked
    (C-b arrows to move between them, C-b z to zoom one full-screen), or
    click the │ and ─ buttons at the right of row 0

Modes: (default) focus-or-spawn the studio · --sidebar (inside tmux)
       --split h|v (from the tab bar's split buttons)
       --palette (from C-b g / the / button; runs inside a display-popup)
Every mode needs a branch in __main__: an unknown flag falls through to
launch(), which spawns a SECOND studio rather than failing quietly.
"""
import json
import os
import signal
import subprocess
import sys
import uuid
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/lib"))

ME = os.path.realpath(__file__)
TMUX_SESSION = "claude-studio"
KITTY_CLASS = "hyprclaudestudio"
# per-tab close button. Window 0 is the session tree — it has no ✕,
# closing it would take the sidebar with it. The range tag names the
# window so the click handler knows WHICH tab the ✕ belonged to.
#
# The padding lives INSIDE the range on purpose: tmux has no per-glyph hit
# testing, so the hit region is exactly the cells between range and norange.
# Wrapping " ✕ " measured 3-4 clickable columns against 1-2 for the bare
# glyph, and the spaces double as the gap that stops a mis-aimed click from
# landing on the neighbouring tab's label.
CLOSE_X = ("#{?#{!=:#{window_index},0},"
           "#[range=user|x#{window_index}] ✕ #[norange],}")
# what else is in this tab. A tab's NAME is its identity pane, so a second
# conversation opened beside it had nothing to say for itself but "·2".
# @beside (a per-window user option, re-derived every rename pass) carries
# that conversation's real name; the bare count is the fallback for when the
# other pane is just a shell.
# ⊞ was tried and sat next to the ✕ looking like a second button
#
# A TEMPLATE, not a constant: this is interpolated into an f-string, so a
# bare {ink} would reach tmux as the literal text "#[fg={ink}]" — which tmux
# accepts with rc=0 and then renders as garbage in every tab. The current
# tab passes empty strings and keeps its accent fill.
PANE_N = ("#{{?#{{@beside}},{ink}+#{{=/10/…:@beside}} {restore},"
          "#{{?#{{>:#{{window_panes}},1}},{ink}·#{{window_panes}} {restore},}}}}")
# per-tab attention state, straight from tmux's own alert flags — no forks,
# no polling, and nothing coupled to Claude's spinner glyphs. tmux CLEARS
# both flags when a window is selected, which is exactly the semantics
# wanted: the mark means "you have not looked at this yet".
#   ● good  a bell — Claude finished its turn and wants you
#   ○ sub   new output you have not seen. Deliberately NOT a status colour:
#           "unread" is not a state, and status ink never decorates
#           non-status content.
# Window 0 is the sidebar and is suppressed — it is furniture, not a job.
# {restore} re-asserts the caller's style, since a mark's #[fg=] would
# otherwise bleed into the rest of the tab (and #[default] would blow away
# the current tab's accent fill).
ATTN = ("#{{?#{{==:#{{window_index}},0}},,"
        "#{{?window_bell_flag,{good}● {restore},"
        "#{{?window_activity_flag,{sub}○ {restore},}}}}}}")
# the two split buttons live in status-right, so they are not part of any
# window's range and act on whatever tab is currently selected
# the labels ARE the prefix keys that do the same thing, so the tab bar
# teaches the binding. Bare │ and ─ were tried first and read as
# separators — nothing about them said "click me".
#
# They are fg-on-muted BLOCKS, not accent glyphs: accent means exactly one
# thing in this bar — "you are here". (It matters more than it sounds:
# hyprdesk.colors() collapses accent2 onto accent when accent2 fails its
# contrast test, so on many wallpapers the brand, these buttons and the
# current-tab fill were literally the same colour.) Padding sits inside the
# range here too, for the same hit-region reason as CLOSE_X.
SPLIT_BUTTONS = ("#[range=user|sh]{ctl} │ {off}#[norange] "
                 "#[range=user|sv]{ctl} ─ {off}#[norange]")
# jump-anywhere button, same block treatment as the split pair.
# NOT ⌕ (U+2315): exactly one font on this machine has that codepoint and it
# is not JetBrainsMono Nerd Font, so it would have rendered as a box in the
# only terminal this bar ever appears in. `/` is the search affordance vim,
# less and fzf all already teach, and every font has it.
PALETTE_BUTTON = "#[range=user|pal]{ctl} / {off}#[norange]"


def tmux(*args, out=False):
    # own socket + no user config: the studio must never inherit or
    # restyle the user's real tmux server (plugins, resurrect, theme)
    r = subprocess.run(["tmux", "-L", TMUX_SESSION, *args],
                       capture_output=True, text=True)
    return r.stdout if out else r.returncode == 0


# ---------------- default mode: focus or spawn ----------------

def launch():
    try:
        clients = json.loads(subprocess.run(
            ["hyprctl", "clients", "-j"], capture_output=True,
            text=True).stdout)
    except Exception:
        clients = []
    for c in clients:
        if isinstance(c, dict) and c.get("class") == KITTY_CLASS:
            # SUMMON the studio to the current workspace (drop-term UX)
            # instead of yanking the user to wherever it was left
            addr = f"address:{c['address']}"
            try:
                ws = json.loads(subprocess.run(
                    ["hyprctl", "-j", "activeworkspace"], capture_output=True,
                    text=True).stdout).get("id", 1)
                subprocess.run(["hyprctl", "dispatch", "movetoworkspace",
                                f"{ws},{addr}"])
            except Exception:
                pass
            subprocess.run(["hyprctl", "dispatch", "focuswindow", addr])
            subprocess.run(["hyprctl", "dispatch", "centerwindow"])
            return
    subprocess.Popen(
        ["kitty", "--class", KITTY_CLASS, "-o", "background_opacity=0.93",
         "--title", "Claude Studio", "-e", "tmux", "-f", "/dev/null",
         "-L", TMUX_SESSION, "new-session", "-A",
         "-s", TMUX_SESSION, "-n", "sessions",
         f"python3 {ME} --sidebar"],
        start_new_session=True,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------- sidebar (tab 0, inside tmux) ----------------

def style_tmux():
    """Idempotent: dress the studio's tab bar in the fleet theme."""
    from hyprdesk import colors
    pal = colors()
    bg, fg = pal["bg"], pal["fg"]
    acc, sub = pal["accent"], pal["sub"]
    muted, good, warn = pal["muted"], pal["good"], pal["warn"]
    # ink hierarchy: accent2 titles the bar, accent stays on the selected
    # tab so "what this is" never wears the same colour as "where you are".
    # NOTE: colors() collapses accent2 onto accent whenever accent2 fails
    # its contrast check, so on many wallpapers these two are equal — which
    # is exactly why nothing else in this bar is allowed to wear accent.
    acc2 = pal["accent2"]
    # the mark restores the style of whatever it sits inside: plain sub ink
    # on an ordinary tab, the accent fill on the selected one
    attn_plain = ATTN.format(good=f"#[fg={good}]", sub=f"#[fg={sub}]",
                             restore=f"#[fg={sub}]")
    attn_cur = ATTN.format(good=f"#[fg={good}]", sub=f"#[fg={sub}]",
                           restore=f"#[bg={acc},fg={bg},bold]")
    # the selected tab already reads as selected — recolouring inside the
    # accent fill only lowers contrast, so it passes no ink at all
    pane_n_plain = PANE_N.format(ink=f"#[fg={sub}]", restore=f"#[fg={sub}]")
    pane_n_cur = PANE_N.format(ink="", restore="")
    # Built by concatenation, not f-strings: these are tmux format strings
    # made of #{...}, and doubling every brace to escape them is how a
    # subtle mismatch gets in.
    #
    # The popup command is STATIC — there is no format in it to expand — so
    # it is the if-branch directly rather than being wrapped in run-shell.
    # (The ✕ branch needs run-shell because its target IS a format; see
    # below.) Brace blocks carry the nesting so nothing has to survive three
    # levels of quoting.
    popup_cmd = 'display-popup -E -w 70% -h 60% "python3 ' + ME + ' --palette"'
    kill_cmd = ("run-shell 'tmux -L " + TMUX_SESSION +
                " kill-window -t #{s/^x//:mouse_status_range}'")
    split_cmd = "run-shell 'python3 " + ME + " --split #{mouse_status_range}'"
    mouse_else = ("if -F '#{m/r:^s[hv]$,#{mouse_status_range}}' "
                  "{ " + split_cmd + " } "
                  "{ if -F '#{==:#{mouse_status_range},pal}' "
                  "{ " + popup_cmd + " } "
                  "{ select-window -t= } }")
    for args in (
        ("set", "-g", "status-position", "top"),
        ("set", "-g", "mouse", "on"),
        ("set", "-g", "status-interval", "5"),
        # the ONLY monitor option that needs setting: tmux already ships
        # monitor-bell on and both visual-* off, so setting those would be
        # redundant (verified against a -f /dev/null server).
        ("set", "-g", "monitor-activity", "on"),
        # a TALLER bar, two rows: row 0 brands the studio and carries the
        # split buttons, row 1 belongs entirely to the tabs. One shared row
        # left every tab — and its ✕ — a cramped click target that also
        # truncated once three conversations were open.
        ("set", "-g", "status", "2"),
        ("set", "-g", "status-style", f"bg={bg},fg={sub}"),
        ("set", "-g", "status-left",
         f"#[fg={acc2},bold] 󰚩 Claude Studio #[default] "),
        # the row is no longer shared with the tabs, so these can breathe
        ("set", "-g", "status-left-length", "40"),
        ("set", "-g", "status-right",
         "{}  {}  #[fg={}]#S ".format(
             PALETTE_BUTTON.format(ctl=f"#[bg={muted},fg={fg}]",
                                   off="#[default]"),
             SPLIT_BUTTONS.format(ctl=f"#[bg={muted},fg={fg}]",
                                  off="#[default]"),
             sub)),
        # three buttons plus the session name now; 40 truncated the row
        ("set", "-g", "status-right-length", "60"),
        # built from status-left/right above so those stay the single
        # source of truth for what the top row says. The centre slot states
        # the TRUE tab count — row 1 is cut off at the right edge once the
        # tabs outgrow the terminal, and without this the strip gives no
        # hint that anything is missing (see the note on list=on below for
        # why there is no scrollport to show it instead).
        # the centre slot: where you are, how many tabs there really are,
        # and the two pane states that change what your keys do. Held in a
        # user option so status-format[0] stays readable and one place owns
        # what the middle says. (`status-centre` is NOT a tmux option — a
        # format reading it expands to empty and the whole segment silently
        # renders blank; only the @-prefixed user option exists.)
        #
        # #{b:...} is basename(3), no fork. The path is capped so a deep
        # directory cannot crowd out the tab count next to it. No prefix-key
        # cue: client_prefix is only 1 while C-b is held and tmux has no
        # reason to redraw the status inside that window, so it would be an
        # indicator that never appears. Git branch is out for the same
        # reason the diff-stat idea was — it needs a #() fork per tick.
        ("set", "-g", "@status-centre",
         f"#[fg={sub}]#{{=/20/…:#{{b:pane_current_path}}}}"
         " · #{session_windows} tabs"
         f"#{{?window_zoomed_flag,#[fg={warn}] [zoom],}}"
         f"#{{?pane_in_mode,#[fg={acc2}] #{{pane_mode}},}}"),
        ("set", "-g", "status-format[0]",
         "#[align=left]#{E:status-left}"
         "#[align=centre]#{E:@status-centre}"
         "#[align=right]#{E:status-right}"),
        # range=window| is NOT decoration — it is the per-tab mouse hit
        # region tmux's stock status-format supplies for free. Writing this
        # row by hand without it broke `select-window -t=` AND
        # `kill-window -t=`: both resolve "the window under the mouse" from
        # this tag, so left-click stopped selecting and middle-click killed
        # the CURRENT tab instead of the clicked one. The ✕ kept working
        # only because it carries its own range=user tag.
        #
        # Deliberately NO list=on / list=focus here. They would add the
        # ‹ › scrollport for overflow, but on tmux 3.7b trimming desyncs the
        # mouse hit table from what was drawn — measured: with the strip
        # showing tabs 9-13 a left-click on tab 4's label killed window 5.
        # Untrimmed, every column maps to the tab drawn there. So: correct
        # clicks, and overflow tabs are reached by keyboard (C-b w) instead.
        ("set", "-g", "status-format[1]",
         "#[align=left]#{W:"
         "#[range=window|#{window_index}]#{E:window-status-format}#[norange],"
         "#[range=window|#{window_index}]"
         "#{E:window-status-current-format}#[norange]}"),
        # panes: the active one wears the accent, the rest recede. The
        # title line only appears once a window actually has two panes —
        # see the hooks below — so a single-pane tab loses no rows.
        ("set", "-g", "pane-border-style", f"fg={sub}"),
        ("set", "-g", "pane-active-border-style", f"fg={acc}"),
        ("set", "-g", "pane-border-format",
         f" #[fg={acc2},bold]#{{pane_index}}#[default] "
         f"#[fg={sub}]#{{pane_current_command}} "),
        # one hook, both directions: pane-exited does not fire for
        # kill-pane, and after-split-window only ever turns it on
        # back to one pane: drop the border title AND the +beside name, or a
        # tab keeps advertising a conversation that is no longer open. The
        # rename pass re-derives @beside anyway, but that is up to 30s away
        # and this costs nothing.
        ("set-hook", "-g", "window-layout-changed",
         "if -F '#{==:#{window_panes},1}' "
         "'setw pane-border-status off ; set -uw @beside' "
         "'setw pane-border-status top'"),
        # mnemonic splits: the key looks like the split it makes
        ("bind-key", "|", "split-window", "-h", "-c", "#{pane_current_path}"),
        ("bind-key", "-", "split-window", "-v", "-c", "#{pane_current_path}"),
        ("bind-key", "Left", "select-pane", "-L"),
        ("bind-key", "Right", "select-pane", "-R"),
        ("bind-key", "Up", "select-pane", "-U"),
        ("bind-key", "Down", "select-pane", "-D"),
        # padding either side: with the tabs on their own row this is free,
        # and it separates one tab's ✕ from the next tab's label so a
        # mis-aimed click selects rather than closes. CLOSE_X now carries
        # its own inner padding, so the trailing run is one space here.
        ("set", "-g", "window-status-format",
         f"  #I #W {pane_n_plain}{attn_plain}{CLOSE_X} "),
        ("set", "-g", "window-status-current-format",
         f"#[bg={acc},fg={bg},bold]  #I #W {pane_n_cur}{attn_cur}{CLOSE_X}"
         f"#[bg={acc},fg={bg}] #[default]"),
        ("set", "-g", "window-status-separator", ""),
        # browser-style tabs: click the ✕ to close one, middle-click
        # anywhere on the tab for the same thing. Left-click elsewhere
        # still just selects, so the ✕ needs its own hit region — hence
        # the range tag (tmux has no per-glyph hit testing otherwise).
        # left-click: ✕ closes that tab, the split buttons split the
        # current one (via --split, which knows the sidebar must not be
        # cut in half), anything else just selects.
        # the ✕ branch MUST go through run-shell: `kill-window -t` does not
        # format-expand its target, so `-t #{s/^x//:...}` reached tmux as a
        # literal and errored ("can't find session: #{s/^x//") — the button
        # looked dead. run-shell expands, which is why the split buttons
        # below always worked. Middle-click survives on `-t=` (a real mouse
        # target, not a format), which masked the bug.
        ("bind-key", "-n", "MouseUp1Status", "if", "-F",
         "#{m/r:^x[0-9]+$,#{mouse_status_range}}", kill_cmd, mouse_else),
        ("bind-key", "-n", "MouseUp2Status", "kill-window", "-t="),
        # jump anywhere. C-Space because the correction's other suggestion,
        # C-b p, is NOT free — it is previous-window in tmux's built-in
        # table, which -f /dev/null does not remove. C-b g is a free
        # mnemonic alias ("go"). Space itself is next-layout, and this
        # studio makes real use of multi-pane tabs, so it stays put.
        ("bind-key", "C-Space", "display-popup", "-E", "-w", "70%",
         "-h", "60%", f"python3 {ME} --palette"),
        ("bind-key", "g", "display-popup", "-E", "-w", "70%",
         "-h", "60%", f"python3 {ME} --palette"),
    ):
        tmux(*args)


def _tab_name(entry, width=18):
    """A tab you can tell apart. Every session in $HOME used to open a tab
    called "santapong", which made the close buttons a guessing game — so
    prefer Claude's own name for the conversation."""
    from hyprdesk.claudesessions import session_title
    title = ""
    sid = entry.get("sid")
    if sid:
        for proj in (Path.home() / ".claude/projects").glob(f"*/{sid}.jsonl"):
            title = session_title(proj)
            break
    name = title or os.path.basename(
        (entry.get("cwd") or "").rstrip("/")) or "~"
    # tmux renames on '#' and whitespace oddities; keep it plain
    name = " ".join(str(name).split()).replace("#", "")
    return name[:width] or "~"


def rename_open_tabs():
    """Re-derive what every tab claims to be, from what it actually holds.

    A window is identified by the session id in its start command — which
    every tab now has from birth, `--resume` and new sessions alike (see
    new_session_tab). A tab whose transcript is not named yet keeps the
    directory and gets upgraded on a later pass.

    This RE-DERIVES rather than remembers, which is the whole point: writing
    @beside once at split time goes stale the moment the pane layout changes
    under it. Kill the identity pane and keep the second conversation, and a
    write-once tab is named after something that is no longer running while
    +beside names the thing that is.
    """
    import re
    # NOT `uuid`: that name is the stdlib module at import scope, and
    # shadowing it here would break any later edit that generates an id.
    uuid_re = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
                         r"[0-9a-f]{4}-[0-9a-f]{12}")
    windows = {}
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_index}|#{pane_current_path}|"
                     "#{pane_start_command}", out=True).splitlines():
        idx, _, rest = line.partition("|")
        pane, _, rest = rest.partition("|")
        cwd, _, cmd = rest.partition("|")
        if idx == "0":          # the sidebar owns its window; never renamed
            continue
        windows.setdefault(idx, []).append((pane, cwd, cmd))

    for idx, panes in windows.items():
        # LOWEST surviving pane index is the tab's identity, not literally
        # pane 0: after the first pane is killed there is no pane 0, and
        # anchoring on it would freeze the tab's name forever.
        panes.sort(key=lambda p: int(p[0]) if p[0].isdigit() else 0)
        ident, rest = panes[0], panes[1:]
        m = uuid_re.search(ident[2] or "")
        if m:
            tmux("rename-window", "-t", idx,
                 _tab_name({"sid": m.group(0), "cwd": ident[1]}))
        # the first OTHER pane that is a conversation, if any. A shell or a
        # build beside you is left to the bare pane count.
        beside = ""
        for pane, cwd, cmd in rest:
            m2 = uuid_re.search(cmd or "")
            if m2:
                beside = _tab_name({"sid": m2.group(0), "cwd": cwd}, width=10)
                break
        # SESSION-QUALIFIED, and it matters: set-option's -t is a
        # target-PANE, not a target-window, so a bare index is read as a
        # pane of the CURRENT window and the option lands on the wrong tab
        # entirely (measured: `-t 1` while window 2 was current wrote to
        # window 2, and reported success). rename-window above takes a real
        # target-window, which is why a bare index is fine there.
        target = f"{TMUX_SESSION}:{idx}"
        if beside:
            tmux("set-option", "-w", "-t", target, "@beside", beside)
        else:
            # unconditional: `set -uw` on an option that was never set
            # returns 0, so this needs no show-options probe first (checked)
            tmux("set-option", "-uw", "-t", target, "@beside")


def open_session_tab(entry):
    """Open (or focus) a tab running this transcript's conversation."""
    sid, cwd = entry["sid"], entry["cwd"]
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if sid in cmd:
            tmux("select-window", "-t", idx)
            return
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", _tab_name(entry),
         "-c", cwd, f"claude --resume {sid}")


_SESSION_ID_FLAG = None


def _claude_takes_session_id():
    """Whether this CLI accepts --session-id. Cached: it costs one `claude
    --help` and only the first new session in a studio's lifetime pays."""
    global _SESSION_ID_FLAG
    if _SESSION_ID_FLAG is None:
        try:
            r = subprocess.run(["claude", "--help"], capture_output=True,
                               text=True, timeout=15)
            _SESSION_ID_FLAG = "--session-id" in (r.stdout + r.stderr)
        except (OSError, subprocess.SubprocessError):
            _SESSION_ID_FLAG = False
    return _SESSION_ID_FLAG


def new_session_tab(cwd):
    """A new conversation, with its identity fixed UP FRONT.

    Every session in one project used to open a tab called the directory —
    three 'n' presses in ~/hyprland-dots gave three tabs reading
    "hyprland-dots", and the close buttons became a guessing game FOREVER:
    a bare `claude` has no id anywhere in its start command, so no later
    pass could ever tell those tabs apart. Assigning the id ourselves puts
    it in pane_start_command from birth, which is the one thing
    rename_open_tabs reads — so the tab upgrades itself to Claude's own
    conversation title on the next pass, exactly like a --resume tab.
    """
    name = os.path.basename(cwd.rstrip("/")) or "~"
    if _claude_takes_session_id():
        cmd = f"claude --session-id {uuid.uuid4()}"
    else:
        # older CLI: no id to pin, so this tab keeps the directory name.
        # Degraded, not broken — the old behaviour.
        cmd = "claude"
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", name, "-c", cwd, cmd)


def _work_window():
    """The tab a split should land in: the selected one, or the last one
    you looked at. Never window 0 — the sidebar is a Textual app that owns
    its whole window. None when the studio holds nothing but the tree."""
    idx = tmux("display-message", "-p", "#{window_index}", out=True).strip()
    if idx and idx != "0":
        return idx
    prev = tmux("display-message", "-p", "-t", "!", "#{window_index}",
                out=True).strip()
    if prev and prev != "0":
        return prev
    others = [l for l in tmux("list-windows", "-F", "#{window_index}",
                              out=True).split() if l != "0"]
    return others[-1] if others else None


def open_session_beside(entry):
    """Two conversations on screen at once — the reason splits exist here.
    Returns what it did so the sidebar can say so."""
    sid, cwd = entry["sid"], entry["cwd"]
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if sid in cmd:
            # a second `claude --resume` on one conversation is the
            # duplicate the tab path already refuses
            tmux("select-window", "-t", idx)
            return "focused"
    target = _work_window()
    if target is None:
        open_session_tab(entry)          # nothing to sit beside yet
        return "tab"
    tmux("split-window", "-h", "-t", f"{TMUX_SESSION}:{target}",
         "-c", cwd, f"claude --resume {sid}")
    # say what landed beside you NOW; the rename pass re-derives this (and
    # corrects it if the layout changes), but that is up to 30s away and the
    # tab would read "·2" until then.
    # session-qualified: set-option's -t is a target-PANE, so a bare index
    # silently writes the option onto whichever tab is current instead.
    tmux("set-option", "-w", "-t", f"{TMUX_SESSION}:{target}", "@beside",
         _tab_name(entry, width=10))
    tmux("select-window", "-t", target)
    return "split"


def open_settings_tab(page="integrations"):
    """Settings is a Textual app like the sidebar, so it runs happily as a
    tab. This is how MCP reaches the studio without the studio growing a
    second settings framework of its own."""
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if "hypr-settings" in cmd:
            tmux("select-window", "-t", idx)
            return
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", "󰌘 settings",
         "-c", str(Path.home()),
         f"python3 {Path.home()}/.local/bin/hypr-settings {page}")


def studio_stake():
    """What pressing q would actually destroy: (tabs, conversations, names).

    `tabs` excludes window 0 — the tree is the studio's own furniture and
    losing it costs nothing. `conversations` counts panes whose start command
    carries a session id, which is what makes the difference between closing
    a couple of shells and closing live work.
    """
    import re
    uuid_re = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
                         r"[0-9a-f]{4}-[0-9a-f]{12}")
    names, convos = [], 0
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_index}|#{window_name}|"
                     "#{pane_start_command}", out=True).splitlines():
        idx, _, rest = line.partition("|")
        pane, _, rest = rest.partition("|")
        name, _, cmd = rest.partition("|")
        if idx == "0":
            continue
        if pane == "0":
            names.append(name)
        if uuid_re.search(cmd or ""):
            convos += 1
    return len(names), convos, names


def palette():
    """Jump anywhere: every open tab and every resumable transcript in one
    fuzzy list, floating over whatever you were reading.

    This is also the keyboard answer to the one thing the tab strip gives up.
    There is no scrollport on row 1 (see status-format[1] — a trimmed list
    desyncs tmux's mouse hit table), so a tab past the right edge has no
    mouse path at all. This is how you reach it.

    Runs INSIDE a display-popup, so it owns a real terminal and talks to the
    studio's server over its own socket like every other mode here.
    """
    import shutil
    if not shutil.which("fzf"):
        # degrade to tmux's own picker rather than flashing an empty popup
        tmux("choose-tree", "-Z")
        return
    import re
    from hyprdesk.claudesessions import session_rows
    uuid_re = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
                         r"[0-9a-f]{4}-[0-9a-f]{12}")
    # conversations that are already tabs — they are offered as tabs below,
    # so the transcript half skips them instead of listing them twice
    open_sids = set()
    for line in tmux("list-panes", "-s", "-F", "#{pane_start_command}",
                     out=True).splitlines():
        m = uuid_re.search(line)
        if m:
            open_sids.add(m.group(0))

    items = []          # (action, display) — action is what the pick does
    for line in tmux("list-windows", "-F", "#{window_index}|#{window_name}",
                     out=True).splitlines():
        idx, _, name = line.partition("|")
        if idx == "0":          # the tree is where you already are
            continue
        items.append((("tab", idx, ""), f"tab   {idx:>2}  {name}"))
    for row in session_rows():
        # PAST only. A 'run' row is a live session — handing it to
        # `claude --resume` would open a second client onto a conversation
        # that is already running, which is the duplicate the tab path
        # refuses. The sidebar is where you go to those.
        if row.get("kind") != "past":
            continue
        sid = row.get("sid")
        if not sid or sid in open_sids:
            continue
        label = row.get("detail") or row.get("label") or sid[:8]
        where = row.get("dir") or ""
        items.append((("sid", sid, row.get("cwd") or ""),
                      f"past      {label}  {where}".rstrip()))
    if not items:
        return

    # field 1 is the index we act on, hidden from the view with --with-nth
    menu = "".join(f"{i}\t{d}\n" for i, (_, d) in enumerate(items))
    try:
        picked = subprocess.run(
            ["fzf", "--delimiter", "\t", "--with-nth", "2..", "--no-multi",
             "--reverse", "--height", "100%", "--prompt", "jump "],
            input=menu, capture_output=True, text=True)
    except OSError:
        return
    out = picked.stdout.strip()
    if picked.returncode != 0 or not out:
        return                      # Esc, or nothing matched: do nothing
    try:
        action = items[int(out.split("\t", 1)[0])][0]
    except (ValueError, IndexError):
        return
    kind, first, second = action
    if kind == "tab":
        # session-qualified: inside a popup the "current" window is not the
        # one the user was looking at
        tmux("select-window", "-t", f"{TMUX_SESSION}:{first}")
    else:
        open_session_tab({"sid": first, "cwd": second})


def new_term_tab(cwd):
    """A plain shell tab — for the git/build/log half of the work that
    otherwise means leaving the studio."""
    name = " " + (os.path.basename(cwd.rstrip("/")) or "~")
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", name, "-c", cwd)


def split_here(where):
    """Split the selected tab. `where` is the clicked range name (sh|sv).
    The sidebar is a Textual app that owns its whole window, so a split
    there opens a terminal TAB instead of squeezing the tree."""
    idx = tmux("display-message", "-p", "#{window_index}", out=True).strip()
    cwd = tmux("display-message", "-p", "#{pane_current_path}",
               out=True).strip() or str(Path.home())
    if idx == "0":
        new_term_tab(str(Path.home()))
        return
    tmux("split-window", "-h" if where.endswith("h") else "-v", "-c", cwd)


def sidebar():
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.screen import ModalScreen
    from textual.widgets import Button, Footer, Static, Tree
    # every tree label is Rich markup, and the text going into it is a
    # conversation title or a job's own detail string — neither of which is
    # ours. One '[' in either raises MarkupError and takes the row with it,
    # and the GUI rules count a blank row as a bug. Nothing on this box
    # contains a bracket today; that is data, not a guarantee.
    from rich.markup import escape
    from hyprdesk import colors
    from hyprdesk.claudesessions import session_rows

    pal = colors()
    style_tmux()
    rename_open_tabs()

    class ConfirmQuit(ModalScreen):
        """q used to take the whole studio — every tab, every running
        conversation — on one keypress, with nothing between the key and the
        kill. It sits next to n/s/t/m/r/x in the same single-letter row, so
        it was one slip away at all times.

        This names what will actually close rather than asking abstractly,
        and says the one thing that makes the decision easy: the
        conversations are not lost, only their terminals. Cancel holds focus
        so Enter and Escape are both safe; the destructive path needs a
        deliberate move.
        """

        BINDINGS = [
            Binding("escape", "cancel", "Cancel", show=True),
            Binding("q", "cancel", "Cancel", show=False),
        ]

        def __init__(self, tabs, convos, names):
            super().__init__()
            self._tabs, self._convos, self._names = tabs, convos, names

        def compose(self) -> ComposeResult:
            shown = ", ".join(self._names[:3])
            if len(self._names) > 3:
                shown += f", +{len(self._names) - 3} more"
            if self._tabs == 1:
                what = "1 tab"
                if self._convos:
                    what += ", a live conversation"
            else:
                what = f"{self._tabs} tabs"
                if self._convos == 1:
                    what += ", one of them a live conversation"
                elif self._convos:
                    what += f", {self._convos} of them live conversations"
            with Vertical(id="confirm-box"):
                yield Static("Close the studio?", id="confirm-title")
                yield Static(f"This closes {what}.", id="confirm-what")
                yield Static(f"[dim]{shown}[/]", id="confirm-names")
                # only say this when there is a conversation to reassure
                # about — otherwise it is comfort about nothing
                if self._convos:
                    yield Static(
                        f"[{pal['sub']}]Every conversation stays resumable —"
                        " only its terminal goes away.[/]", id="confirm-note")
                with Horizontal(id="confirm-buttons"):
                    yield Button("Cancel", variant="primary", id="cancel")
                    yield Button("Close studio", variant="error", id="quit")

        def on_mount(self):
            self.query_one("#cancel", Button).focus()

        def on_button_pressed(self, event):
            self.dismiss(event.button.id == "quit")

        def action_cancel(self):
            self.dismiss(False)

    class Studio(App):
        ENABLE_COMMAND_PALETTE = False
        BINDINGS = [
            Binding("enter", "open", "Open tab", show=True),
            Binding("n", "new", "New session here", show=True),
            Binding("s", "beside", "Open beside", show=True),
            Binding("t", "term", "Terminal here", show=True),
            Binding("m", "mcp", "MCP / settings", show=True),
            Binding("x", "kill_bg", "Stop bg job", show=True),
            Binding("r", "refresh", "Refresh", show=True),
            Binding("q", "quit_studio", "Close studio", show=True),
        ]
        CSS = f"""
        Screen {{ background: ansi_default; color: {pal['fg']}; }}
        #hint {{ color: {pal['sub']}; padding: 0 2; height: 1; }}
        Tree {{ background: transparent; padding: 0 1; }}
        Tree > .tree--cursor {{ background: {pal['accent']} 30%; }}
        Tree > .tree--guides {{ color: {pal['sub']}; }}
        ConfirmQuit {{ align: center middle; background: {pal['bg']} 60%; }}
        /* muted is a SURFACE tone in the ink table, never text — this is
           the one place it belongs. bad ink stays on the button only, so
           the dialog does not read as an error that already happened. */
        #confirm-box {{
            width: 58; height: auto; padding: 1 2;
            background: {pal['bg']}; border: round {pal['muted']};
        }}
        #confirm-title {{ color: {pal['fg']}; text-style: bold; }}
        #confirm-what {{ color: {pal['fg']}; padding-top: 1; }}
        #confirm-names {{ padding-bottom: 1; }}
        #confirm-note {{ padding-bottom: 1; }}
        #confirm-buttons {{ height: auto; align-horizontal: right; }}
        #confirm-buttons Button {{ margin-left: 2; }}
        """

        def compose(self) -> ComposeResult:
            # The Footer below already renders every key this line used to
            # repeat (Enter/s/t/m are all show=True), so the one free row is
            # spent on the MOUSE contract instead — the only thing in this
            # app nothing else can teach.
            #
            # Every gesture named here is one that actually works, which was
            # not true until this week: middle-click closed the WRONG tab
            # until the window hit regions came back, and there was no jump
            # key at all until the palette landed. Naming C-b g rather than
            # C-b Space matters for the same reason — Space is next-layout.
            # A hint line that promises what the app does not honour is
            # worse than no hint line.
            #
            # Kept to one short row: the sidebar is narrow and Textual clips
            # silently, so a long line would simply disappear.
            yield Static(
                f"[bold {pal['accent']}]󰚩 Sessions[/]  "
                f"[{pal['sub']}]click a tab · ✕ closes it · C-b g jumps[/]",
                id="hint")
            yield Tree("sessions", id="tree")
            yield Footer()

        def on_mount(self):
            self._sig = None
            self.reload_tree()
            self.query_one(Tree).focus()
            # the tree goes stale the moment a tab is closed or a session
            # starts elsewhere; r still forces it, this just keeps up
            self.set_interval(6.0, self.reload_tree)  # cheap: see _sig
            # Claude names a conversation a little after it starts, so a
            # tab opened from the tree gets its real name on a later pass
            self.set_interval(30.0, rename_open_tabs)

        def reload_tree(self, force=False):
            rows = session_rows()
            # rebuilding collapsed whatever the user had opened and threw
            # the cursor back to the top — every 6 seconds. Almost every
            # poll finds nothing new, so almost every poll must do nothing.
            sig = [(r.get("kind"), r.get("label"), r.get("sid"),
                    r.get("pid"), r.get("detail")) for r in rows]
            if not force and sig == self._sig:
                return
            self._sig = sig
            tree = self.query_one(Tree)
            # when it HAS changed, keep the shape the user arranged
            was_open = {n.label.plain for n in tree.root.children
                        for n in n.children if n.is_expanded}
            cur = tree.cursor_node
            cur_key = (cur.label.plain if cur is not None else None)
            tree.clear()
            tree.show_root = False
            running = [r for r in rows if r["kind"] in ("run", "bg")]
            past = [r for r in rows if r["kind"] == "past"]
            # Glyphs wear PALETTE ROLES so the tree re-inks with the
            # wallpaper like the rest of the fleet — an emoji's colour is
            # fixed by the font and can never do that. Terminal panels are
            # exempt from the pixel-icon rule by the design doc's own line:
            # tmux draws characters, not sprites.
            #
            # Headings are bold FOREGROUND, deliberately not accent2: on
            # this wallpaper colors() has collapsed accent2 onto accent
            # (they are both #E17963), and accent is already spent on the
            # tree cursor. Titling a section with it would put "what this
            # is" in the same ink as "where you are" — the exact collision
            # the tab strip refuses.
            if running:
                sec = tree.root.add(
                    f"[bold]Running ({len(running)})[/]", expand=True)
                for r in running:
                    # ● and 󰑮 both verified present in JetBrainsMono Nerd
                    # Font (fc-list :charset=). ◐ was tried first and is in
                    # 0 JetBrainsMono faces — it would have been a box.
                    icon = (f"[{pal['good']}]●[/]" if r["kind"] == "run"
                            else f"[{pal['warn']}]󰑮[/]")
                    # the name says what it IS, the dim path says where —
                    # every session in $HOME used to read just "~"
                    where = escape(r.get("dir", ""))
                    sec.add_leaf(f"{icon} {escape(str(r['label']))}"
                                 + (f"  [dim]{where}[/]" if where else ""),
                                 data=r)
            projects = {}
            for r in past:
                projects.setdefault(r["label"], []).append(r)
            sec = tree.root.add(
                f"[bold]Projects ({len(projects)})[/]", expand=True)
            for label, items in sorted(projects.items()):
                node = sec.add(f"[{pal['sub']}]󰉋[/] {escape(str(label))}"
                               f"  [dim]{len(items)}[/]",
                               data={"kind": "project",
                                     "cwd": items[0]["cwd"]})
                if node.label.plain in was_open:
                    node.expand()
                for it in items:
                    # 󰥔 replaces the 🕒 emoji: same meaning, but it can
                    # actually take a palette role
                    node.add_leaf(
                        f"[{pal['sub']}]󰥔[/] {escape(str(it['detail']))}",
                        data=it)
            if cur_key is not None:
                for n in tree.root.children:
                    for m in [n, *n.children]:
                        if m.label.plain == cur_key:
                            tree.move_cursor(m)
                            break

        def _current(self):
            node = self.query_one(Tree).cursor_node
            return (node.data if node and node.data else None)

        def on_tree_node_selected(self, event):
            data = event.node.data
            if not data or data.get("kind") == "project":
                return
            self.open_entry(data)

        def action_open(self):
            data = self._current()
            if data and data.get("kind") != "project":
                self.open_entry(data)

        def open_entry(self, data):
            kind = data.get("kind")
            if kind == "past":
                open_session_tab(data)
            elif kind == "run":
                if data.get("addr"):
                    subprocess.run(["hyprctl", "dispatch", "focuswindow",
                                    f"address:{data['addr']}"])
                elif not self.focus_own_pane(data.get("tty")):
                    self.notify("Can't find that session's window",
                                severity="warning")
            elif kind == "bg":
                self.notify("Background session — press x to stop it,"
                            " or watch it on claude.ai", severity="warning")

        def focus_own_pane(self, tty):
            """A session opened inside the studio has no Hyprland window
            of its own (the parent chain dead-ends at the tmux server) —
            match its tty against our panes and focus that tab instead."""
            if not tty:
                return False
            for line in tmux("list-panes", "-s", "-F",
                             "#{window_index}|#{pane_tty}",
                             out=True).splitlines():
                idx, _, ptty = line.partition("|")
                if ptty == tty:
                    tmux("select-window", "-t", idx)
                    return True
            return False

        def action_kill_bg(self):
            data = self._current() or {}
            if data.get("kind") != "bg" or not data.get("pid"):
                self.notify("Highlight a 󰑮 background job first")
                return
            try:
                os.kill(int(data["pid"]), signal.SIGTERM)
            except OSError:
                pass
            self.notify("Stopped — its transcript stays resumable")
            self.set_timer(1.0, self.reload_tree)

        def action_new(self):
            data = self._current() or {}
            new_session_tab(data.get("cwd") or str(Path.home()))

        def action_beside(self):
            data = self._current() or {}
            if data.get("kind") != "past" or not data.get("sid"):
                self.notify("Highlight a conversation to open it beside "
                            "the one you are reading")
                return
            what = open_session_beside(data)
            if what == "focused":
                self.notify("Already open — focused its tab instead")

        def action_mcp(self):
            open_settings_tab("integrations")

        def action_term(self):
            data = self._current() or {}
            new_term_tab(data.get("cwd") or str(Path.home()))

        def action_refresh(self):
            self.reload_tree(force=True)

        def action_quit_studio(self):
            tabs, convos, names = studio_stake()
            if not tabs:
                # nothing open but the tree: there is nothing to lose, so
                # do not make the user confirm an empty room
                tmux("kill-session", "-t", TMUX_SESSION)
                return

            def done(confirmed):
                if confirmed:
                    tmux("kill-session", "-t", TMUX_SESSION)

            self.push_screen(ConfirmQuit(tabs, convos, names), done)

    Studio().run()


if __name__ == "__main__":
    # every mode needs a branch here. An unrecognised flag falls through to
    # launch(), which summons or SPAWNS A SECOND STUDIO — so a mode wired
    # into a key binding but not into this dispatch does not fail quietly,
    # it does something wildly wrong in front of the user.
    if "--sidebar" in sys.argv:
        sidebar()
    elif "--split" in sys.argv:
        i = sys.argv.index("--split")
        split_here(sys.argv[i + 1] if i + 1 < len(sys.argv) else "sh")
    elif "--palette" in sys.argv:
        palette()
    else:
        launch()
