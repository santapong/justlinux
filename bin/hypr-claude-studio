#!/usr/bin/env python3
"""hypr-claude-studio — a VS-Code-style workspace for Claude Code sessions.

One kitty window running a tmux session:
  · TOP: the tmux status bar shows every open session as a TAB
    (mouse-clickable, like open files in VS Code)
  · TAB 0 "sessions": an expandable tree of conversations — 🟢 running,
    then projects → their resumable transcripts
  · Enter opens a session as its own tab (`claude --resume`); if it is
    already open its tab is focused instead; s opens it BESIDE the one
    you are reading (two conversations, one screen); n = new session in
    the highlighted project; t = plain terminal there; m = the settings
    panel (MCP servers) as a tab; r = refresh
  · SPLITS: any tab holds several panes — C-b | side by side, C-b - stacked
    (C-b arrows to move between them, C-b z to zoom one full-screen), or
    click the | and — buttons at the right of the tab bar

Modes: (default) focus-or-spawn the studio · --sidebar (inside tmux)
       --split h|v (from the tab bar's split buttons)
"""
import json
import os
import signal
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path.home() / ".local/lib"))

ME = os.path.realpath(__file__)
TMUX_SESSION = "claude-studio"
KITTY_CLASS = "hyprclaudestudio"
# per-tab close button. Window 0 is the session tree — it has no ✕,
# closing it would take the sidebar with it. The range tag names the
# window so the click handler knows WHICH tab the ✕ belonged to.
CLOSE_X = ("#{?#{!=:#{window_index},0},"
           "#[range=user|x#{window_index}]✕#[norange],}")
# a tab holding several panes shows its count — the name only ever
# describes the first one
# ⊞ was tried and sat next to the ✕ looking like a second button
PANE_N = "#{?#{>:#{window_panes},1},·#{window_panes} ,}"
# the two split buttons live in status-right, so they are not part of any
# window's range and act on whatever tab is currently selected
# the labels ARE the prefix keys that do the same thing, so the tab bar
# teaches the binding. Bare │ and ─ were tried first and read as
# separators — nothing about them said "click me".
SPLIT_BUTTONS = ("#[range=user|sh]{acc}[|]#[norange]{sub} "
                 "#[range=user|sv]{acc}[-]#[norange]{sub}")


def tmux(*args, out=False):
    # own socket + no user config: the studio must never inherit or
    # restyle the user's real tmux server (plugins, resurrect, theme)
    r = subprocess.run(["tmux", "-L", TMUX_SESSION, *args],
                       capture_output=True, text=True)
    return r.stdout if out else r.returncode == 0


# ---------------- default mode: focus or spawn ----------------

def launch():
    try:
        clients = json.loads(subprocess.run(
            ["hyprctl", "clients", "-j"], capture_output=True,
            text=True).stdout)
    except Exception:
        clients = []
    for c in clients:
        if isinstance(c, dict) and c.get("class") == KITTY_CLASS:
            # SUMMON the studio to the current workspace (drop-term UX)
            # instead of yanking the user to wherever it was left
            addr = f"address:{c['address']}"
            try:
                ws = json.loads(subprocess.run(
                    ["hyprctl", "-j", "activeworkspace"], capture_output=True,
                    text=True).stdout).get("id", 1)
                subprocess.run(["hyprctl", "dispatch", "movetoworkspace",
                                f"{ws},{addr}"])
            except Exception:
                pass
            subprocess.run(["hyprctl", "dispatch", "focuswindow", addr])
            subprocess.run(["hyprctl", "dispatch", "centerwindow"])
            return
    subprocess.Popen(
        ["kitty", "--class", KITTY_CLASS, "-o", "background_opacity=0.93",
         "--title", "Claude Studio", "-e", "tmux", "-f", "/dev/null",
         "-L", TMUX_SESSION, "new-session", "-A",
         "-s", TMUX_SESSION, "-n", "sessions",
         f"python3 {ME} --sidebar"],
        start_new_session=True,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---------------- sidebar (tab 0, inside tmux) ----------------

def style_tmux():
    """Idempotent: dress the studio's tab bar in the fleet theme."""
    from hyprdesk import colors
    pal = colors()
    bg, fg = pal["bg"], pal["fg"]
    acc, sub = pal["accent"], pal["sub"]
    # ink hierarchy: accent2 titles the bar, accent stays on the selected
    # tab so "what this is" never wears the same colour as "where you are"
    acc2 = pal["accent2"]
    for args in (
        ("set", "-g", "status-position", "top"),
        ("set", "-g", "mouse", "on"),
        ("set", "-g", "status-interval", "5"),
        ("set", "-g", "status-style", f"bg={bg},fg={sub}"),
        ("set", "-g", "status-left",
         f"#[fg={acc2},bold] 󰚩 Claude Studio #[default] "),
        ("set", "-g", "status-left-length", "22"),
        ("set", "-g", "status-right",
         "#[fg={}]{}  #S ".format(
             sub, SPLIT_BUTTONS.format(acc=f"#[fg={acc}]",
                                       sub=f"#[fg={sub}]"))),
        ("set", "-g", "status-right-length", "32"),
        # panes: the active one wears the accent, the rest recede. The
        # title line only appears once a window actually has two panes —
        # see the hooks below — so a single-pane tab loses no rows.
        ("set", "-g", "pane-border-style", f"fg={sub}"),
        ("set", "-g", "pane-active-border-style", f"fg={acc}"),
        ("set", "-g", "pane-border-format",
         f" #[fg={acc2},bold]#{{pane_index}}#[default] "
         f"#[fg={sub}]#{{pane_current_command}} "),
        # one hook, both directions: pane-exited does not fire for
        # kill-pane, and after-split-window only ever turns it on
        ("set-hook", "-g", "window-layout-changed",
         "if -F '#{==:#{window_panes},1}' "
         "'setw pane-border-status off' 'setw pane-border-status top'"),
        # mnemonic splits: the key looks like the split it makes
        ("bind-key", "|", "split-window", "-h", "-c", "#{pane_current_path}"),
        ("bind-key", "-", "split-window", "-v", "-c", "#{pane_current_path}"),
        ("bind-key", "Left", "select-pane", "-L"),
        ("bind-key", "Right", "select-pane", "-R"),
        ("bind-key", "Up", "select-pane", "-U"),
        ("bind-key", "Down", "select-pane", "-D"),
        ("set", "-g", "window-status-format",
         f" #I #W {PANE_N}{CLOSE_X} "),
        ("set", "-g", "window-status-current-format",
         f"#[bg={acc},fg={bg},bold] #I #W {PANE_N}{CLOSE_X}"
         f"#[bg={acc},fg={bg}] #[default]"),
        ("set", "-g", "window-status-separator", ""),
        # browser-style tabs: click the ✕ to close one, middle-click
        # anywhere on the tab for the same thing. Left-click elsewhere
        # still just selects, so the ✕ needs its own hit region — hence
        # the range tag (tmux has no per-glyph hit testing otherwise).
        # left-click: ✕ closes that tab, the split buttons split the
        # current one (via --split, which knows the sidebar must not be
        # cut in half), anything else just selects.
        ("bind-key", "-n", "MouseUp1Status", "if", "-F",
         "#{m/r:^x[0-9]+$,#{mouse_status_range}}",
         "kill-window -t #{s/^x//:mouse_status_range}",
         "if -F '#{m/r:^s[hv]$,#{mouse_status_range}}' "
         f"\"run-shell 'python3 {ME} --split #{{mouse_status_range}}'\" "
         "'select-window -t='"),
        ("bind-key", "-n", "MouseUp2Status", "kill-window", "-t="),
    ):
        tmux(*args)


def _tab_name(entry, width=18):
    """A tab you can tell apart. Every session in $HOME used to open a tab
    called "santapong", which made the close buttons a guessing game — so
    prefer Claude's own name for the conversation."""
    from hyprdesk.claudesessions import session_title
    title = ""
    sid = entry.get("sid")
    if sid:
        for proj in (Path.home() / ".claude/projects").glob(f"*/{sid}.jsonl"):
            title = session_title(proj)
            break
    name = title or os.path.basename(
        (entry.get("cwd") or "").rstrip("/")) or "~"
    # tmux renames on '#' and whitespace oddities; keep it plain
    name = " ".join(str(name).split()).replace("#", "")
    return name[:width] or "~"


def rename_open_tabs():
    """Give tabs opened before this ran the same real names. Only windows
    whose start command names a session can be identified; a bare `claude`
    has no id until its transcript exists, so it keeps the directory."""
    import re
    uuid = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
                      r"[0-9a-f]{4}-[0-9a-f]{12}")
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_index}|#{pane_current_path}|"
                     "#{pane_start_command}", out=True).splitlines():
        idx, _, rest = line.partition("|")
        pane, _, rest = rest.partition("|")
        cwd, _, cmd = rest.partition("|")
        if idx == "0":
            continue
        # a tab's identity is its FIRST pane. Without this, opening a
        # second conversation beside the first renamed the whole tab to
        # whichever pane the loop happened to reach last.
        if pane != "0":
            continue
        m = uuid.search(cmd or "")
        if not m:
            continue
        name = _tab_name({"sid": m.group(0), "cwd": cwd})
        tmux("rename-window", "-t", idx, name)


def open_session_tab(entry):
    """Open (or focus) a tab running this transcript's conversation."""
    sid, cwd = entry["sid"], entry["cwd"]
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if sid in cmd:
            tmux("select-window", "-t", idx)
            return
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", _tab_name(entry),
         "-c", cwd, f"claude --resume {sid}")


def new_session_tab(cwd):
    name = os.path.basename(cwd.rstrip("/")) or "~"
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", name, "-c", cwd,
         "claude")


def _work_window():
    """The tab a split should land in: the selected one, or the last one
    you looked at. Never window 0 — the sidebar is a Textual app that owns
    its whole window. None when the studio holds nothing but the tree."""
    idx = tmux("display-message", "-p", "#{window_index}", out=True).strip()
    if idx and idx != "0":
        return idx
    prev = tmux("display-message", "-p", "-t", "!", "#{window_index}",
                out=True).strip()
    if prev and prev != "0":
        return prev
    others = [l for l in tmux("list-windows", "-F", "#{window_index}",
                              out=True).split() if l != "0"]
    return others[-1] if others else None


def open_session_beside(entry):
    """Two conversations on screen at once — the reason splits exist here.
    Returns what it did so the sidebar can say so."""
    sid, cwd = entry["sid"], entry["cwd"]
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if sid in cmd:
            # a second `claude --resume` on one conversation is the
            # duplicate the tab path already refuses
            tmux("select-window", "-t", idx)
            return "focused"
    target = _work_window()
    if target is None:
        open_session_tab(entry)          # nothing to sit beside yet
        return "tab"
    tmux("split-window", "-h", "-t", f"{TMUX_SESSION}:{target}",
         "-c", cwd, f"claude --resume {sid}")
    tmux("select-window", "-t", target)
    return "split"


def open_settings_tab(page="integrations"):
    """Settings is a Textual app like the sidebar, so it runs happily as a
    tab. This is how MCP reaches the studio without the studio growing a
    second settings framework of its own."""
    for line in tmux("list-panes", "-s", "-F",
                     "#{window_index}|#{pane_start_command}",
                     out=True).splitlines():
        idx, _, cmd = line.partition("|")
        if "hypr-settings" in cmd:
            tmux("select-window", "-t", idx)
            return
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", "󰌘 settings",
         "-c", str(Path.home()),
         f"python3 {Path.home()}/.local/bin/hypr-settings {page}")


def new_term_tab(cwd):
    """A plain shell tab — for the git/build/log half of the work that
    otherwise means leaving the studio."""
    name = " " + (os.path.basename(cwd.rstrip("/")) or "~")
    tmux("new-window", "-t", f"{TMUX_SESSION}:", "-n", name, "-c", cwd)


def split_here(where):
    """Split the selected tab. `where` is the clicked range name (sh|sv).
    The sidebar is a Textual app that owns its whole window, so a split
    there opens a terminal TAB instead of squeezing the tree."""
    idx = tmux("display-message", "-p", "#{window_index}", out=True).strip()
    cwd = tmux("display-message", "-p", "#{pane_current_path}",
               out=True).strip() or str(Path.home())
    if idx == "0":
        new_term_tab(str(Path.home()))
        return
    tmux("split-window", "-h" if where.endswith("h") else "-v", "-c", cwd)


def sidebar():
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.widgets import Footer, Static, Tree
    from hyprdesk import colors
    from hyprdesk.claudesessions import session_rows

    pal = colors()
    style_tmux()
    rename_open_tabs()

    class Studio(App):
        ENABLE_COMMAND_PALETTE = False
        BINDINGS = [
            Binding("enter", "open", "Open tab", show=True),
            Binding("n", "new", "New session here", show=True),
            Binding("s", "beside", "Open beside", show=True),
            Binding("t", "term", "Terminal here", show=True),
            Binding("m", "mcp", "MCP / settings", show=True),
            Binding("x", "kill_bg", "Stop bg job", show=True),
            Binding("r", "refresh", "Refresh", show=True),
            Binding("q", "quit_studio", "Close studio", show=True),
        ]
        CSS = f"""
        Screen {{ background: ansi_default; color: {pal['fg']}; }}
        #hint {{ color: {pal['sub']}; padding: 0 2; height: 1; }}
        Tree {{ background: transparent; padding: 0 1; }}
        Tree > .tree--cursor {{ background: {pal['accent']} 30%; }}
        Tree > .tree--guides {{ color: {pal['sub']}; }}
        """

        def compose(self) -> ComposeResult:
            yield Static(
                f"[bold {pal['accent']}]󰚩 Sessions[/] — Enter opens a tab"
                " · s = beside it · t = terminal · m = MCP · C-b | ─ splits",
                id="hint")
            yield Tree("sessions", id="tree")
            yield Footer()

        def on_mount(self):
            self._sig = None
            self.reload_tree()
            self.query_one(Tree).focus()
            # the tree goes stale the moment a tab is closed or a session
            # starts elsewhere; r still forces it, this just keeps up
            self.set_interval(6.0, self.reload_tree)  # cheap: see _sig
            # Claude names a conversation a little after it starts, so a
            # tab opened from the tree gets its real name on a later pass
            self.set_interval(30.0, rename_open_tabs)

        def reload_tree(self, force=False):
            rows = session_rows()
            # rebuilding collapsed whatever the user had opened and threw
            # the cursor back to the top — every 6 seconds. Almost every
            # poll finds nothing new, so almost every poll must do nothing.
            sig = [(r.get("kind"), r.get("label"), r.get("sid"),
                    r.get("pid"), r.get("detail")) for r in rows]
            if not force and sig == self._sig:
                return
            self._sig = sig
            tree = self.query_one(Tree)
            # when it HAS changed, keep the shape the user arranged
            was_open = {n.label.plain for n in tree.root.children
                        for n in n.children if n.is_expanded}
            cur = tree.cursor_node
            cur_key = (cur.label.plain if cur is not None else None)
            tree.clear()
            tree.show_root = False
            running = [r for r in rows if r["kind"] in ("run", "bg")]
            past = [r for r in rows if r["kind"] == "past"]
            if running:
                sec = tree.root.add(
                    f"[bold]🟢 Running ({len(running)})[/]", expand=True)
                for r in running:
                    icon = "🟢" if r["kind"] == "run" else "󰑮"
                    # the name says what it IS, the dim path says where —
                    # every session in $HOME used to read just "~"
                    where = r.get("dir", "")
                    sec.add_leaf(f"{icon} {r['label']}"
                                 + (f"  [dim]{where}[/]" if where else ""),
                                 data=r)
            projects = {}
            for r in past:
                projects.setdefault(r["label"], []).append(r)
            sec = tree.root.add(
                f"[bold]󰉋 Projects ({len(projects)})[/]", expand=True)
            for label, items in sorted(projects.items()):
                node = sec.add(f"󰉋 {label}  [dim]{len(items)}[/]",
                               data={"kind": "project",
                                     "cwd": items[0]["cwd"]})
                if node.label.plain in was_open:
                    node.expand()
                for it in items:
                    node.add_leaf(f"🕒 {it['detail']}", data=it)
            if cur_key is not None:
                for n in tree.root.children:
                    for m in [n, *n.children]:
                        if m.label.plain == cur_key:
                            tree.move_cursor(m)
                            break

        def _current(self):
            node = self.query_one(Tree).cursor_node
            return (node.data if node and node.data else None)

        def on_tree_node_selected(self, event):
            data = event.node.data
            if not data or data.get("kind") == "project":
                return
            self.open_entry(data)

        def action_open(self):
            data = self._current()
            if data and data.get("kind") != "project":
                self.open_entry(data)

        def open_entry(self, data):
            kind = data.get("kind")
            if kind == "past":
                open_session_tab(data)
            elif kind == "run":
                if data.get("addr"):
                    subprocess.run(["hyprctl", "dispatch", "focuswindow",
                                    f"address:{data['addr']}"])
                elif not self.focus_own_pane(data.get("tty")):
                    self.notify("Can't find that session's window",
                                severity="warning")
            elif kind == "bg":
                self.notify("Background session — press x to stop it,"
                            " or watch it on claude.ai", severity="warning")

        def focus_own_pane(self, tty):
            """A session opened inside the studio has no Hyprland window
            of its own (the parent chain dead-ends at the tmux server) —
            match its tty against our panes and focus that tab instead."""
            if not tty:
                return False
            for line in tmux("list-panes", "-s", "-F",
                             "#{window_index}|#{pane_tty}",
                             out=True).splitlines():
                idx, _, ptty = line.partition("|")
                if ptty == tty:
                    tmux("select-window", "-t", idx)
                    return True
            return False

        def action_kill_bg(self):
            data = self._current() or {}
            if data.get("kind") != "bg" or not data.get("pid"):
                self.notify("Highlight a 󰑮 background job first")
                return
            try:
                os.kill(int(data["pid"]), signal.SIGTERM)
            except OSError:
                pass
            self.notify("Stopped — its transcript stays resumable")
            self.set_timer(1.0, self.reload_tree)

        def action_new(self):
            data = self._current() or {}
            new_session_tab(data.get("cwd") or str(Path.home()))

        def action_beside(self):
            data = self._current() or {}
            if data.get("kind") != "past" or not data.get("sid"):
                self.notify("Highlight a conversation to open it beside "
                            "the one you are reading")
                return
            what = open_session_beside(data)
            if what == "focused":
                self.notify("Already open — focused its tab instead")

        def action_mcp(self):
            open_settings_tab("integrations")

        def action_term(self):
            data = self._current() or {}
            new_term_tab(data.get("cwd") or str(Path.home()))

        def action_refresh(self):
            self.reload_tree(force=True)

        def action_quit_studio(self):
            tmux("kill-session", "-t", TMUX_SESSION)

    Studio().run()


if __name__ == "__main__":
    if "--sidebar" in sys.argv:
        sidebar()
    elif "--split" in sys.argv:
        i = sys.argv.index("--split")
        split_here(sys.argv[i + 1] if i + 1 < len(sys.argv) else "sh")
    else:
        launch()
