#!/bin/sh
''''exec "$HOME/.local/share/hyprdesk/voice-venv/bin/python" "$0" "$@" # '''
"""hypr-voice — the ear of DravenIQ Meta Harness.

Always-on wake word ("Hey Draven"; the pretrained "hey jarvis" until a
custom model is dropped in), then one spoken command, transcribed offline
and matched against the grammar in hyprdesk/voice_intents.py. Nothing here
talks to a network.

Cost discipline (measured, see docs/perf/voice-baseline.md):
- the wake model runs on 160 ms chunks in ONE onnxruntime thread;
- whisper (≈480 MB resident) lives in a CHILD process that exits after
  5 min without a command, so idle RAM is the wake model only;
- the mic stream is pw-record piped to us — no PortAudio, no callbacks.

Modes:  (none)        daemon
        --test [SECS] print the wake score for SECS seconds, no actions
        --say TEXT    run TEXT through the grammar and execute (no audio)
        --transcriber internal: whisper worker (stdin: wav path per line)
"""
import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import wave
from pathlib import Path

HOME = Path.home()
CONF = HOME / ".config/conky/widgets.conf"
VOICE_DIR = HOME / ".local/share/hyprdesk/voice"
CUSTOM_MODEL = VOICE_DIR / "hey_draven.onnx"   # or ANY *.onnx dropped into VOICE_DIR
STUDIO = HOME / ".local/bin/draveniq"
SETTINGS = HOME / ".local/bin/hypr-settings"
TMUX = ["tmux", "-L", "draveniq"]
SESSION = "draveniq"
RATE = 16000
FRAME = 1280            # 80 ms, what openWakeWord expects
CHUNK = FRAME * int(os.environ.get("HYPR_VOICE_FRAMES", "2"))  # inference every 160 ms by default
TONE = "/usr/share/sounds/freedesktop/stereo/message.oga"
STATE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypr-voice.state"
RUNTIME = STATE.parent
CMD = RUNTIME / "hypr-voice.cmd"            # one-line commands from shortcuts / console
METER = RUNTIME / "hypr-voice.meter"        # "rms score threshold" per chunk, only while…
CONSOLE_FLAG = RUNTIME / "hypr-voice.console-open"   # …the console is open
LOG = HOME / ".local/state/hyprdesk/voice-log.jsonl"
NOTIFY_ID = "9911"          # one replaced notification, never a pile
WAYBAR_SIGNAL = 12          # waybar custom/voice "signal": 12

sys.path.insert(0, str(HOME / ".local/lib"))
from hyprdesk.voice_intents import has_name, parse  # noqa: E402


# ---------------------------------------------------------------- config
def conf():
    out = {}
    try:
        for line in CONF.read_text().splitlines():
            m = re.match(r"^(\w+)\s*=\s*(\S+)", line)
            if m:
                out[m.group(1)] = m.group(2)
    except OSError:
        pass
    return out


def cfg(key, default):
    return conf().get(key, default)


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


# ---------------------------------------------------------------- feedback
def toast(title, body="", ms=2500):
    subprocess.Popen(["notify-send", "-a", "DravenIQ", "-t", str(ms), title, body],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def tone():
    if os.path.exists(TONE):
        subprocess.Popen(["pw-play", TONE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


_voice_timer = None


def set_state(state, text="", hold=4.0):
    """One truth for every surface: the state file (waybar reads it), the
    DravenIQ tab bar (@voice) and ONE replaced notification. `hold`
    seconds later the transient states fall back to idle."""
    global _voice_timer
    try:
        tmp = STATE.with_suffix(".tmp")
        tmp.write_text(json.dumps({"state": state, "text": text, "ts": time.time()}))
        os.replace(tmp, STATE)
    except OSError:
        pass
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"], capture_output=True)
    label = {"listening": "listening…", "thinking": "…", "heard": text, "idle": "", "paused": "paused",
             "asking": "yes? say the command"}.get(state, text)
    if label:
        subprocess.run(TMUX + ["set", "-g", "@voice", label], capture_output=True)
    else:
        subprocess.run(TMUX + ["set", "-gu", "@voice"], capture_output=True)
    if state in ("listening", "asking", "thinking", "heard", "paused"):
        body = {"listening": "󰍬 listening — say the command", "asking": "󰍬 yes? — say the command",
                "thinking": "…", "heard": f"heard: “{text}”", "paused": "paused — say “Draven, listen”"}[state]
        subprocess.Popen(["notify-send", "-a", "DravenIQ", "-r", NOTIFY_ID, "-t", str(int(hold * 1000)),
                          "Draven", body], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if _voice_timer:
        _voice_timer.cancel()
        _voice_timer = None
    if state in ("listening", "asking", "thinking", "heard"):
        _voice_timer = threading.Timer(hold, lambda: set_state("idle"))
        _voice_timer.daemon = True
        _voice_timer.start()


def voice_log(kind, **fields):
    """Append-only history the console shows: what was heard, what was done."""
    def plain(v):   # numpy floats are not JSON — and the log must never kill the ear
        if hasattr(v, "item"):
            return v.item()
        if isinstance(v, (list, tuple)):
            return [plain(x) for x in v]
        if isinstance(v, dict):
            return {k: plain(x) for k, x in v.items()}
        return v
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a") as f:
            f.write(json.dumps({"ts": time.time(), "kind": kind, **plain(fields)}, ensure_ascii=False) + "\n")
    except Exception as e:  # noqa: BLE001
        log(f"voice_log failed: {e}")


def send_cmd(line):
    tmp = CMD.with_suffix(".tmp")
    tmp.write_text(line + "\n")
    os.replace(tmp, CMD)


def status(text, clear_after=4.0):  # kept for callers: maps onto set_state
    set_state("heard" if text and text not in ("", "on") else "idle", text, clear_after or 4.0)


# ---------------------------------------------------------------- actions
def tmux_out(*args):
    r = subprocess.run(TMUX + list(args), capture_output=True, text=True)
    return r.stdout.strip()


def studio_alive():
    return subprocess.run(TMUX + ["has-session", "-t", SESSION], capture_output=True).returncode == 0


def active_cwd():
    return tmux_out("display-message", "-p", "-t", SESSION + ":", "#{pane_current_path}") or str(HOME)


def execute(actions):
    for verb, payload in actions:
        if verb == "focus":
            subprocess.Popen([str(STUDIO)], start_new_session=True)
            toast("DravenIQ", "here")
        elif verb == "new_tab":
            n, agent = payload["n"], payload["agent"]
            if not studio_alive():
                subprocess.Popen([str(STUDIO)], start_new_session=True)
                time.sleep(1.5)
            cwd = active_cwd()
            for _ in range(n):
                subprocess.run([str(STUDIO), "--new-tab", "--agent", agent, "--cwd", cwd])
            toast("DravenIQ", f"opened {n} {agent} tab{'s' if n > 1 else ''}")
        elif verb == "open_plan":
            r = subprocess.run([str(STUDIO), "--open-plan"], capture_output=True, text=True)
            toast("DravenIQ", (r.stdout or r.stderr).strip() or "plan")
        elif verb == "close_tab":
            idx = tmux_out("display-message", "-p", "-t", SESSION + ":", "#{window_index}")
            if idx:
                subprocess.run([str(STUDIO), "--close-tab", idx])
                toast("DravenIQ", f"closed tab {idx}")
        elif verb == "select_tab":
            subprocess.run(TMUX + ["select-window", "-t", SESSION + (":+" if payload == "next" else ":-")])
        elif verb == "settings":
            subprocess.Popen([str(SETTINGS), "claude"], start_new_session=True)
        elif verb == "hide":
            subprocess.run(["hyprctl", "dispatch", "movetoworkspacesilent",
                            "special:hidden,class:draveniq"], capture_output=True)
        elif verb == "enter":
            subprocess.run(TMUX + ["send-keys", "-t", SESSION + ":", "Enter"])
        elif verb == "dictate":
            # -l = literal; NO Enter — the user reads it, then says "send"
            subprocess.run(TMUX + ["send-keys", "-t", SESSION + ":", "-l", payload])
            toast("typed", payload, 4000)
        elif verb == "unknown":
            toast("didn't catch that", payload, 3000)
        # pause/listen are handled by the daemon loop


# ---------------------------------------------------------------- audio
def mic_cmd():
    cmd = ["pw-record", "--rate", str(RATE), "--channels", "1", "--format", "s16",
           "--latency", os.environ.get("HYPR_VOICE_LATENCY", "160ms")]  # fewer, bigger pipe reads
    src = cfg("voice_source", "")
    if src:
        cmd += ["--target", src]
    return cmd + ["-"]


class Mic:
    """pw-record → a thread → a bounded frame queue (80 ms frames). The
    queue keeps ~30 s so speech during whisper's think-time is NOT lost:
    the next capture starts from what was said, not from now."""

    def __init__(self):
        self.q = queue.Queue(maxsize=190)   # 190 × 160 ms ≈ 30 s
        self.proc = None
        self.start()

    def start(self):
        self.proc = subprocess.Popen(mic_cmd(), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        th = threading.Thread(target=self._pump, daemon=True)
        th.start()

    def _pump(self):
        while True:
            buf = self.proc.stdout.read(CHUNK * 2)   # one put per 160 ms chunk
            if len(buf) < CHUNK * 2:
                self.q.put(None)
                return
            if self.q.full():
                try:
                    self.q.get_nowait()
                except queue.Empty:
                    pass
            self.q.put(buf)

    def frame(self):
        return self.q.get()

    def restart(self):
        try:
            self.proc.kill()
        except OSError:
            pass
        time.sleep(1)
        self.start()


def rms(a):
    import numpy as np
    return float(np.sqrt(np.mean(a.astype(np.float32) ** 2))) if len(a) else 0.0


class Transcriber:
    """whisper in a child process; exits after IDLE seconds unused."""
    IDLE = 300

    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()

    def _spawn(self):
        self.proc = subprocess.Popen([sys.executable, __file__, "--transcriber"],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
                                     bufsize=1)

    def transcribe(self, wav):
        with self.lock:
            if self.proc is None or self.proc.poll() is not None:
                self._spawn()
            try:
                self.proc.stdin.write(wav + "\n")
                self.proc.stdin.flush()
                return self.proc.stdout.readline().strip()
            except (BrokenPipeError, OSError):
                self.proc = None
                return ""


def transcriber_main():
    """Child: load whisper once, answer 'path' lines with text lines."""
    import select
    from faster_whisper import WhisperModel
    lang = cfg("voice_lang", "en")
    name = "base.en" if lang == "en" else "base"
    model = WhisperModel(name, device="cpu", compute_type="int8", cpu_threads=2)
    while True:
        r, _, _ = select.select([sys.stdin], [], [], Transcriber.IDLE)
        if not r:
            return  # idle: free the ~480 MB
        line = sys.stdin.readline()
        if not line:
            return
        try:
            segs, _ = model.transcribe(line.strip(), beam_size=1, language=lang,
                                       vad_filter=True, condition_on_previous_text=False)
            text = " ".join(s.text for s in segs).strip()
        except Exception as e:  # noqa: BLE001 — never kill the ear
            text = ""
            print("ERR", e, file=sys.stderr, flush=True)
        print(text, flush=True)


def load_wake_model():
    import onnxruntime as ort
    ort.set_default_logger_severity(3)
    # openWakeWord 0.4 builds its sessions with default options: a thread
    # pool that SPIN-WAITS between our 160 ms chunks (7 % of a core doing
    # nothing, measured). One intra-op thread, no spinning: real inference
    # cost only.
    _Sess = ort.InferenceSession

    class _QuietSession(_Sess):
        def __init__(self, path, sess_options=None, **kw):
            if sess_options is None:
                sess_options = ort.SessionOptions()
            sess_options.intra_op_num_threads = 1
            sess_options.inter_op_num_threads = 1
            sess_options.add_session_config_entry("session.intra_op.allow_spinning", "0")
            super().__init__(path, sess_options=sess_options, **kw)

    ort.InferenceSession = _QuietSession
    from openwakeword.model import Model
    import openwakeword
    custom = sorted(VOICE_DIR.glob("*.onnx")) if VOICE_DIR.is_dir() else []
    if custom:
        paths = [str(x) for x in custom]
        name = "+".join(x.stem for x in custom)
    else:
        # no custom model yet: "hey draven" is phonetically close to the
        # bundled "hey jarvis" / "hey marvin" / "hey mycroft" — listen to all
        # three and wake on whichever scores (voice_models overrides)
        want = cfg("voice_models", "hey_jarvis").split(",")  # the trio measured no cheaper to wake, 2× to run
        base = os.path.join(os.path.dirname(openwakeword.__file__), "resources/models")
        paths = [os.path.join(base, f"{w.strip()}_v0.1.onnx") for w in want if w.strip()]
        paths = [x for x in paths if os.path.exists(x)] or [os.path.join(base, "hey_jarvis_v0.1.onnx")]
        name = "+".join(os.path.basename(x).split("_v0")[0] for x in paths)
    return Model(wakeword_model_paths=paths, ncpu=1), name


def capture_command(mic, floor, max_s=10.0, silence_s=1.2, start_timeout=4.0, min_s=1.5):
    """Frames after the wake until the speaker pauses. Timing is counted
    in FRAMES, so buffered speech (spoken while whisper was busy) is
    consumed at full speed and still measured correctly."""
    import numpy as np
    frames, spoke, quiet, elapsed = [], False, 0.0, 0.0
    thresh = max(floor * 2.5, 300.0)
    step = CHUNK / RATE
    while elapsed < max_s:
        buf = mic.frame()
        if buf is None:
            return None
        elapsed += step
        a = np.frombuffer(buf, dtype=np.int16)
        frames.append(a)
        if rms(a) > thresh:
            spoke, quiet = True, 0.0
        elif spoke:
            quiet += step
            if quiet >= silence_s and elapsed >= min_s:
                break
        elif elapsed > start_timeout:
            return None  # nothing said
    if not spoke:
        return None
    audio = np.concatenate(frames)
    VOICE_DIR.mkdir(parents=True, exist_ok=True)
    wav = VOICE_DIR / "last-command.wav"
    with wave.open(str(wav), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(audio.tobytes())
    return str(wav)


def daemon(test_seconds=None):
    os.environ.setdefault("OMP_NUM_THREADS", "1")
    import numpy as np
    model, name = load_wake_model()
    threshold = float(cfg("voice_threshold", "0.6"))
    log(f"wake model {name} threshold {threshold} chunk {CHUNK / RATE * 1000:.0f} ms")
    mic = Mic()
    tx = Transcriber()
    if test_seconds is None:
        set_state("idle")
    paused = False
    hits, last_wake = 0, 0.0
    recent = []                      # chunk RMS history → noise floor
    gated_prev, skipped = False, None
    last_actions = []
    peak, last_report = 0.0, time.time()
    cpu0, t_start = time.process_time(), time.time()   # steady state, after model load
    try:
        while True:
            buf = mic.frame()
            if buf is None:
                log("mic stream ended — restarting pw-record")
                mic.restart()
                continue
            a = np.frombuffer(buf, dtype=np.int16)
            level = rms(a)
            recent.append(level)
            del recent[:-30]
            floor = sorted(recent)[len(recent) // 2]
            # ---- energy gate: silence never reaches the network (µs, not ms).
            # Two quiet chunks in a row → skip inference; when sound returns,
            # feed the last skipped chunk first so the mel window is continuous.
            quiet = level < max(floor * 1.8, 150.0)
            if quiet and gated_prev:
                skipped = a
                score = 0.0
            else:
                if skipped is not None:
                    model.predict(skipped)
                    skipped = None
                score = float(max(model.predict(a).values()))
            gated_prev = quiet
            try:   # the console heartbeats this flag; a stale one (window killed) is ignored
                if time.time() - CONSOLE_FLAG.stat().st_mtime < 3.0:
                    METER.write_text(f"{level:.0f} {score:.3f} {threshold:.2f}")
            except OSError:
                pass
            if test_seconds is not None:
                peak = max(peak, score)
                if time.time() - last_report >= 1.0:
                    print(f"score {score:.3f}  peak {peak:.3f}  rms {level:.0f}  gate {'closed' if (quiet and gated_prev) else 'open'}", flush=True)
                    last_report = time.time()
                if time.time() - t_start >= test_seconds:
                    import resource
                    el = time.time() - t_start
                    print(f"cpu {(time.process_time() - cpu0) / el * 100:.1f}% of one core over {el:.0f}s (steady state), "
                          f"maxrss {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss // 1024} MB, peak score {peak:.3f}", flush=True)
                    return
                continue
            # ---- commands from shortcuts / the console
            forced = False
            if CMD.exists():
                try:
                    line = CMD.read_text().strip()
                    CMD.unlink()
                except OSError:
                    line = ""
                verb, _, arg = line.partition(" ")
                if verb == "listen":
                    forced = True
                elif verb == "pause":
                    paused = True
                    set_state("paused", hold=0)
                elif verb == "resume":
                    paused = False
                    set_state("idle")
                elif verb == "threshold":
                    try:
                        threshold = float(arg)
                        log(f"threshold {threshold}")
                    except ValueError:
                        pass
                elif verb == "retry" and last_actions:
                    voice_log("actions", text="(retry)", actions=[list(x) for x in last_actions])
                    execute(last_actions)
                elif verb == "say" and arg:
                    acts = parse(arg)
                    voice_log("heard", text=arg, actions=[list(x) for x in acts], secs=0, score=0)
                    set_state("heard", arg[:60], hold=6)
                    execute(acts)
                    if acts and acts[0][0] != "unknown":
                        last_actions = acts
            hits = hits + 1 if score >= threshold else 0
            if not forced and (hits < 2 or time.time() - last_wake < 2.0):
                continue
            hits, last_wake = 0, time.time()
            model.reset()
            voice_log("wake", score=round(score, 3), forced=forced)
            if paused and not forced:
                # only "listen" / "wake up" gets through
                wav = capture_command(mic, floor)
                text = tx.transcribe(wav) if wav else ""
                if any(v == "listen" for v, _ in parse(text)):
                    paused = False
                    set_state("idle")
                    toast("DravenIQ", "listening again")
                continue
            paused = False
            tone()
            set_state("listening", hold=12)
            wav = capture_command(mic, floor)
            if not wav:
                voice_log("heard", text="", actions=[], secs=0, score=round(score, 3))
                set_state("idle")
                continue
            set_state("thinking", hold=12)
            t = time.time()
            text = tx.transcribe(wav)
            log(f"heard {text!r} ({time.time() - t:.1f}s)")
            actions = parse(text)
            if not forced and text and not has_name(text):
                # the wake model only APPROXIMATES the name: if what we heard
                # never mentions Draven, it was not for us — ignore silently
                log(f"ignored (no name): {text!r}")
                voice_log("ignored", text=text, score=round(score, 3))
                set_state("idle")
                model.reset()
                continue
            if not actions:
                # woke on the name alone — the command is still coming (and was
                # buffered while whisper ran): listen again
                set_state("asking", hold=12)
                wav = capture_command(mic, floor, start_timeout=5.0)
                if wav:
                    set_state("thinking", hold=12)
                    text = tx.transcribe(wav)
                    log(f"heard (2nd) {text!r}")
                    actions = parse(text)
            set_state("heard", text[:60] if text else "(nothing)", hold=6)
            log(f"actions {actions}")
            voice_log("heard", text=text, actions=[list(x) for x in actions], secs=round(time.time() - t, 1), score=round(score, 3))
            if any(v == "pause" for v, _ in actions):
                paused = True
                set_state("paused", hold=0)
                continue
            execute(actions)
            if actions and actions[0][0] != "unknown":
                last_actions = actions
            model.reset()
            while not mic.q.empty():   # drop audio of our own tone/toast era
                mic.q.get_nowait()
    finally:
        try:
            mic.proc.kill()
            mic.proc.wait()
        except OSError:
            pass


def waybar():
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "hypr-voice.service"]).returncode == 0
    st, text, ts = "idle", "", 0.0
    try:
        d = json.loads(STATE.read_text())
        st, text, ts = d.get("state", "idle"), d.get("text", ""), float(d.get("ts", 0))
    except (OSError, ValueError):
        pass
    if not active:
        out = {"text": "󰍭", "class": "off", "tooltip": "voice OFF — click to start listening"}
    elif st == "paused":
        out = {"text": "󰍭 paused", "class": "paused", "tooltip": "say “Draven, listen” to resume · click to stop"}
    elif st in ("listening", "asking") and time.time() - ts < 15:
        out = {"text": "󰍬 " + ("yes?" if st == "asking" else "listening…"), "class": "listening", "tooltip": "say the command"}
    elif st == "thinking" and time.time() - ts < 15:
        out = {"text": "󰍬 …", "class": "listening", "tooltip": "transcribing"}
    elif st == "heard" and time.time() - ts < 8:
        out = {"text": "󰍬 " + text[:32], "class": "heard", "tooltip": f"heard: {text}"}
    else:
        out = {"text": "󰍬", "class": "on", "tooltip": "listening for the wake word · click to stop"}
    print(json.dumps(out))


def toggle():
    active = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "hypr-voice.service"]).returncode == 0
    subprocess.run(["systemctl", "--user", "stop" if active else "start", "hypr-voice.service"])
    if active:
        set_state("off", hold=0)
    subprocess.run(["notify-send", "-a", "DravenIQ", "-r", NOTIFY_ID, "-t", "2500", "Draven",
                    "voice OFF" if active else "voice ON — listening for the wake word"])
    subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar"], capture_output=True)


def main():
    args = sys.argv[1:]
    if args[:1] == ["--waybar"]:
        waybar()
        return
    if args[:1] == ["--toggle"]:
        toggle()
        return
    if args[:1] == ["--listen-now"]:
        send_cmd("listen")
        return
    if args[:1] == ["--cmd"]:
        send_cmd(" ".join(args[1:]))
        return
    if args[:1] == ["--transcriber"]:
        transcriber_main()
    elif args[:1] == ["--test"]:
        daemon(test_seconds=float(args[1]) if len(args) > 1 else 10.0)
    elif args[:1] == ["--say"]:
        text = " ".join(args[1:])
        actions = parse(text)
        print(actions)
        execute(actions)
    else:
        daemon()


if __name__ == "__main__":
    main()
