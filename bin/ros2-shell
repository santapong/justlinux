#!/bin/sh
# ROS2 Jazzy in docker (Kali can't run ROS2 natively — Ubuntu-only debs).
#   ros2-shell            interactive shell in the ROS2 container
#   ros2-shell <cmd...>   run a command (e.g. ros2-shell ros2 topic list)
# GUI apps (rviz2, rqt, gazebo) work: X11 + hardware GL are passed through.
# Your ~/ros2_ws persists on the host; serial + CAN devices are shared.

# Prefer the extended robotics image (SLAM/Nav2/TurtleBot3) if it's built.
if docker image inspect ros2-robotics:jazzy >/dev/null 2>&1; then
    IMAGE="ros2-robotics:jazzy"
else
    IMAGE="osrf/ros:jazzy-desktop"
fi
WS="$HOME/ros2_ws"
mkdir -p "$WS/src"

# Let the (root) container talk to our X server for GUI apps.
command -v xhost >/dev/null && xhost +local:root >/dev/null 2>&1

exec docker run -it --rm \
    --net=host --ipc=host --pid=host \
    -e DISPLAY="${DISPLAY:-:1}" \
    -e QT_X11_NO_MITSHM=1 \
    -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}" \
    -e TURTLEBOT3_MODEL="${TURTLEBOT3_MODEL:-burger}" \
    -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$WS:/ros2_ws" \
    -v /dev:/dev \
    --device /dev/dri \
    --device-cgroup-rule='c 166:* rmw' \
    --device-cgroup-rule='c 188:* rmw' \
    --group-add dialout \
    --group-add video \
    -w /ros2_ws \
    "$IMAGE" \
    bash -c 'source /opt/ros/jazzy/setup.bash 2>/dev/null;
             [ -f install/setup.bash ] && source install/setup.bash;
             exec "${@:-bash}"' -- "$@"
