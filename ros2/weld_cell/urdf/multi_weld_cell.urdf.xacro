<?xml version="1.0"?>
<!-- Multi-robot welding cell: 3 six-DOF arms weld a car underbody panel
     simultaneously (body-in-white, like an automotive line). Each arm is a
     prefixed instance of weld_arm; the car part is a fixed fixture. -->
<robot name="weld_cell" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find weld_cell)/urdf/weld_arm.xacro"/>

  <material name="car_body"><color rgba="0.62 0.64 0.68 1"/></material>
  <material name="fixture"><color rgba="0.25 0.26 0.28 1"/></material>

  <link name="world"/>

  <!-- ===== the car part: an underbody floor pan on a low fixture =====
       Seams sit at z=0.25 so the floor-mounted arms reach them torch-down.
       Rails at y=+/-0.13, cross member at x=0.13. -->
  <link name="car_part">
    <!-- floor pan (top at z=0.25) -->
    <visual><origin xyz="0 0 0.24"/>
      <geometry><box size="0.32 0.28 0.02"/></geometry>
      <material name="car_body"/></visual>
    <!-- left side rail (seam #1) -->
    <visual><origin xyz="0 0.13 0.29"/>
      <geometry><box size="0.32 0.03 0.08"/></geometry>
      <material name="car_body"/></visual>
    <!-- right side rail (seam #2) -->
    <visual><origin xyz="0 -0.13 0.29"/>
      <geometry><box size="0.32 0.03 0.08"/></geometry>
      <material name="car_body"/></visual>
    <!-- cross member (seam #3) -->
    <visual><origin xyz="0.13 0 0.29"/>
      <geometry><box size="0.03 0.28 0.08"/></geometry>
      <material name="car_body"/></visual>
    <!-- fixture -->
    <visual><origin xyz="0 0 0.115"/>
      <geometry><box size="0.26 0.22 0.23"/></geometry>
      <material name="fixture"/></visual>
    <inertial><mass value="20"/>
      <inertia ixx="1" iyy="1" izz="1" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="world_to_part" type="fixed">
    <parent link="world"/><child link="car_part"/>
  </joint>

  <!-- ===== three welding robots, each 0.25 in front of its seam ===== -->
  <!-- arm1: welds the left rail (world +y) -->
  <xacro:weld_arm prefix="arm1_" parent="world"
                  x="0.0" y="0.38" z="0.0" yaw="-1.5708" color="wc_accent"/>
  <!-- arm2: welds the right rail (world -y) -->
  <xacro:weld_arm prefix="arm2_" parent="world"
                  x="0.0" y="-0.38" z="0.0" yaw="1.5708" color="wc_accent"/>
  <!-- arm3: welds the cross member (world +x) -->
  <xacro:weld_arm prefix="arm3_" parent="world"
                  x="0.38" y="0.0" z="0.0" yaw="3.1416" color="wc_accent"/>
</robot>
